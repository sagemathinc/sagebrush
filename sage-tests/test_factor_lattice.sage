# Factoring over ZZ and QQ where many modular factors meet few rational
# ones (the lattice recombination: engine/poly/src/vanhoeij.rs), checked
# against Sage.  S4, S5, S6: the minimal polynomials of sqrt2 + sqrt3 +
# sqrt5 + sqrt7 (+ sqrt11 (+ sqrt13)), irreducible but split into factors of
# degree <= 2 modulo every prime.
R.<x> = ZZ[]
S4 = R([46225, 0, -5596840, 0, 13950764, 0, -7453176, 0, 1513334, 0, -141912, 0, 6476, 0, -136, 0, 1])
S5 = R([2000989041197056, 0, -44660812492570624, 0, 183876928237731840, 0, -255690851718529024, 0, 172580952324702208, 0, -65892492886671360, 0, 15459151516270592, 0, -2349014746136576, 0, 239210760462336, 0, -16665641517056, 0, 801918722048, 0, -26625650688, 0, 602397952, 0, -9028096, 0, 84864, 0, -448, 0, 1])
S6 = R([198828783273803025550632280753863681, 0, -8316202966928528723117528333532208416, 0, 100392008259975194458539996111340080624, 0, -511762449216265420619809586571618679392, 0, 1258829468814790188483900997578812102776, 0, -1771080720430629161685158978892152599456, 0, 1585722240968892813653220405983168716752, 0, -968316307427310602872375357706532108000, 0, 423140580409718469187953106123559340828, 0, -137048942135190916858196960829292680864, 0, 33785494292069713784801456649105169648, 0, -6471399892949448329687739464771529952, 0, 978878175154164215599705915851796296, 0, -118444912349891951852181962142375200, 0, 11582497564629879101390954172990800, 0, -922739669127277027441017551584608, 0, 60261059130667890854325275719238, 0, -3240853899326109989616514647392, 0, 143976257181996292530653998416, 0, -5292590468585153795497272608, 0, 161038437520893531719546696, 0, -4051269676739248306877664, 0, 84041236543621002233072, 0, -1431186296399427673760, 0, 19875965471079809820, 0, -223010452468129504, 0, 1995413247403984, 0, -13981172308896, 0, 74737287288, 0, -293134944, 0, 792048, 0, -1312, 0, 1])
for f in [S4, S5, S6]:
    F = f.factor()
    print(f.degree(), len(F), F[0][0] == f, f.is_irreducible())
for n in [24, 60, 105, 120]:
    F = (x^n - 1).factor()
    print(n, len(F), [g.degree() for g, e in F])
print((x^60 + 1).factor())
print((x^2 - x - 1)(x^5 + x + 3).factor())          # a composition
f = -6 * (2*x + 3)^2 * S4 * (3*x^3 - 2)
print(f.factor())
F = prod(x - k for k in range(1, 41)).factor()
print(len(F), all(e == 1 and g.degree() == 1 for g, e in F), sorted(-g[0] for g, e in F) == list(range(1, 41)))
g = x * (x - 1) * S5
F = g.factor()
print(len(F), sorted(h.degree() for h, e in F))
Q.<y> = QQ[]
print((y^24 - 1/16).factor())
print((S5(y) * (y/2 - 3)).factor())
