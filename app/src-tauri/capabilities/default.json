{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The notebook window: open and save the user's files (anywhere, like any document app), set its title.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-startup-files",
    "allow-selftest-file",
    "allow-selftest-report",
    "allow-app-log",
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "/**"
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
