t('0 Qp (L(-10) + L(25)*a).add_bigoh(4).norm()', lambda: (L(-10) + L(25)*a).add_bigoh(4).norm())
t('0 Qp ((-27*a + K(22, 4)).valuation(), (-27*a + K(22, 4)).precision_absolute(), (-27*a + K(22, 4)).precision_relative())', lambda: ((-27*a + K(22, 4)).valuation(), (-27*a + K(22, 4)).precision_absolute(), (-27*a + K(22, 4)).precision_relative()))
t('0 Qp L(-15) + (L(24) + -5*a)*a^2', lambda: L(-15) + (L(24) + -5*a)*a^2)
t('0 Qp (L(-22).valuation(), L(-22).precision_absolute(), L(-22).precision_relative())', lambda: (L(-22).valuation(), L(-22).precision_absolute(), L(-22).precision_relative()))
K = Zp(3, 4)
