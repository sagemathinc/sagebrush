# GF(p) polynomial: any_root, nth_root, any_irreducible_factor, is_primitive (Sage mode), as Sage gives them.
R.<x> = GF(101)[]
f = x^5 + 3*x + 1
F9.<a> = GF(9)
S.<y> = F9[]
T.<z> = GF(2)[]
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", "%s: %s" % (type(e).__name__, str(e).split(chr(10))[0]), flush=True)
show('(x^2 - 4).any_root() in [2, 99]', lambda: (x^2 - 4).any_root() in [2, 99])
show('(x^2 + 1).any_root() in [10, 91]', lambda: (x^2 + 1).any_root() in [10, 91])
show('x.any_root()', lambda: x.any_root())
show('(3*x + 6).any_root()', lambda: (3*x + 6).any_root())
show('((x + 1)^2 * (x^2 + 2)).any_root()', lambda: ((x + 1)^2 * (x^2 + 2)).any_root())
show('(x^2 + 2).any_root()', lambda: (x^2 + 2).any_root())
show('R(5).any_root()', lambda: R(5).any_root())
show('(y^2 - a).any_root()^2 == a', lambda: (y^2 - a).any_root()^2 == a)
show('(y^2 - a^2).any_root() in [a, -a]', lambda: (y^2 - a^2).any_root() in [a, -a])
show('(z^2 + z + 1).any_root()', lambda: (z^2 + z + 1).any_root())
show('((x + 3)^3).nth_root(3)', lambda: ((x + 3)^3).nth_root(3))
show('(2*(x + 1)^3).nth_root(3)', lambda: (2*(x + 1)^3).nth_root(3))
show('((x^2 + x + 7)^3*(x + 2)^6).nth_root(3)', lambda: ((x^2 + x + 7)^3*(x + 2)^6).nth_root(3))
show('(x^2 + x).nth_root(3)', lambda: (x^2 + x).nth_root(3))
show('f.nth_root(1)', lambda: f.nth_root(1))
show('R(8).nth_root(3)', lambda: R(8).nth_root(3))
show('R(0).nth_root(3)', lambda: R(0).nth_root(3))
show('(z^4 + 1).nth_root(2)', lambda: (z^4 + 1).nth_root(2))
show('(z^6 + z^2 + 1).nth_root(2)', lambda: (z^6 + z^2 + 1).nth_root(2))
show('((y + a)^5).nth_root(5)', lambda: ((y + a)^5).nth_root(5))
show('((x + 1)^3).nth_root(0)', lambda: ((x + 1)^3).nth_root(0))
show('(x^4 + 1).any_irreducible_factor(degree=2) in [x^2 + 10, x^2 + 91]', lambda: (x^4 + 1).any_irreducible_factor(degree=2) in [x^2 + 10, x^2 + 91])
show('(x^4 + 1).any_irreducible_factor(degree=2).degree()', lambda: (x^4 + 1).any_irreducible_factor(degree=2).degree())
show('((x + 1)*(x^2 + 2)).any_irreducible_factor()', lambda: ((x + 1)*(x^2 + 2)).any_irreducible_factor())
show('((x + 1)*(x^2 + 2)).any_irreducible_factor(degree=2)', lambda: ((x + 1)*(x^2 + 2)).any_irreducible_factor(degree=2))
show('((x + 1)*(x^2 + 2)).any_irreducible_factor(degree=3)', lambda: ((x + 1)*(x^2 + 2)).any_irreducible_factor(degree=3))
show('R(3).any_irreducible_factor()', lambda: R(3).any_irreducible_factor())
show('(x^2 + 2).any_irreducible_factor()', lambda: (x^2 + 2).any_irreducible_factor())
show('(3*(x^2 + 2)^2).any_irreducible_factor()', lambda: (3*(x^2 + 2)^2).any_irreducible_factor())
show('T(z^3 + z + 1).is_primitive()', lambda: T(z^3 + z + 1).is_primitive())
show('T(z^4 + z^3 + z^2 + z + 1).is_primitive()', lambda: T(z^4 + z^3 + z^2 + z + 1).is_primitive())
show('(x + 3).is_primitive()', lambda: (x + 3).is_primitive())
show('x.is_primitive()', lambda: x.is_primitive())
show('(x + 100).is_primitive()', lambda: (x + 100).is_primitive())
show('(x^2 + 1).is_primitive()', lambda: (x^2 + 1).is_primitive())
show('(x^2 + x + 3).is_primitive()', lambda: (x^2 + x + 3).is_primitive())
show('R(5).is_primitive()', lambda: R(5).is_primitive())
show('((x + 2)^2).is_primitive()', lambda: ((x + 2)^2).is_primitive())
show('(y + a).is_primitive()', lambda: (y + a).is_primitive())
show('(y^2 + y + a).is_primitive()', lambda: (y^2 + y + a).is_primitive())
show('T(z^8 + z^4 + z^3 + z^2 + 1).is_primitive()', lambda: T(z^8 + z^4 + z^3 + z^2 + 1).is_primitive())
show('T(z^20 + z^3 + 1).is_primitive()', lambda: T(z^20 + z^3 + 1).is_primitive())
show('T(z^16 + z^5 + z^3 + z^2 + 1).is_primitive()', lambda: T(z^16 + z^5 + z^3 + z^2 + 1).is_primitive())
show('T(z^31 + z^3 + 1).is_primitive()', lambda: T(z^31 + z^3 + 1).is_primitive())
show('T(z^33 + z^13 + 1).is_primitive()', lambda: T(z^33 + z^13 + 1).is_primitive())
show('T(z^36 + z^11 + 1).is_primitive()', lambda: T(z^36 + z^11 + 1).is_primitive())
show('GF(5)["s"]([2, 1, 0, 0, 0, 0, 0, 0, 0, 1]).is_primitive()', lambda: GF(5)["s"]([2, 1, 0, 0, 0, 0, 0, 0, 0, 1]).is_primitive())
show('[g.is_primitive() for g in S.monics(of_degree=2) if g.is_irreducible()][:12]', lambda: [g.is_primitive() for g in S.monics(of_degree=2) if g.is_irreducible()][:12])
show('(2*x^2).nth_root(2)', lambda: (2*x^2).nth_root(2))
show('(x^2 + 1).nth_root(2)', lambda: (x^2 + 1).nth_root(2))
show('((x + 1)^2).nth_root(4)', lambda: ((x + 1)^2).nth_root(4))
show('(x*(x + 1)^2).nth_root(2)', lambda: (x*(x + 1)^2).nth_root(2))
show('(2*(x^2 + 1)).nth_root(2)', lambda: (2*(x^2 + 1)).nth_root(2))
show('(x^3 + x).nth_root(5)', lambda: (x^3 + x).nth_root(5))
show('R(3).nth_root(2)', lambda: R(3).nth_root(2))
show('(x^2 + 2*x).nth_root(2)', lambda: (x^2 + 2*x).nth_root(2))
show('((y + 1)^2 + a).nth_root(2)', lambda: ((y + 1)^2 + a).nth_root(2))
