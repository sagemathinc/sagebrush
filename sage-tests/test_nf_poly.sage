# Polynomials over number fields: arithmetic, printing, gcds, roots and
# factorization (Trager's method in the engine), against Sage on fixed
# polynomials over quadratic (real and imaginary), cubic, quartic and
# cyclotomic fields, and a Hecke charpoly of degree 74 over Q(w),
# w^2 = w + 1 (from the HMF engine: T_(3 + w) on S_(2,4)((30))).
x = polygen(QQ, 'x')
fields = [NumberField(x^2 - 5, 'a'), NumberField(x^2 - x - 1, 'a'), NumberField(x^2 + 1, 'a'),
          NumberField(x^2 + x + 1, 'a'), QuadraticField(2, 'a'), QuadraticField(-5, 'a'),
          NumberField(x^3 - 2, 'a'), NumberField(x^3 - x - 1, 'a'), NumberField(x^4 + 1, 'a'),
          NumberField(x^4 - 2, 'a'), CyclotomicField(5, 'a')]
for K in fields:
    a = K.gen()
    R = PolynomialRing(K, 'y'); y = R.gen()
    print(K, '|', latex(K), '|', latex(R), '|', latex(a^2/3 - 2*a + 1))
    tests = [y^2 - a, (y - a)^2*(y + a)*(y - 1), (y^2 + a*y + 1)*(y - 2)^3, (y^3 - 2)*(y^2 + y + 1),
             (2*a + 1)*(y^4 - 1), y^6 - a^2, (y - a)*(y - a^2)*(y + 1 - a), (y^2 - 3*a*y + 1/2)^2 * (y + a/3)]
    for f in tests:
        F = f.factor()
        print('  ', f)
        print('    factor', F, '| roots', f.roots(), '| sqfree', f.is_squarefree())
        print('    gcd', gcd(f, f.derivative()), '| sqd', f.squarefree_decomposition(), '| latex', latex(F))
        assert F.value() == f
    q, r = tests[2].quo_rem(y^2 - a)
    print('  quo_rem', q, '|', r, '| xgcd', xgcd(y^2 - a, y + 1))
F = NumberField(x^2 - x - 1, 'w'); w = F.gen()
S = PolynomialRing(F, 'z'); z = S.gen()
