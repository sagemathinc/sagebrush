# Cross-origin isolation, so the notebook page and its worker can share an
# interrupt flag (a SharedArrayBuffer): Stop raises KeyboardInterrupt and
# keeps every variable.  Everything the page loads is same-origin.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
# the service worker and the page: always revalidated (a deploy shows up at once)
/sw.js
  Cache-Control: no-cache
# the interpreter's files, which the runner (an opaque origin: web/runner/)
# fetches with CORS
/sagebrush-worker.js
  Access-Control-Allow-Origin: *
/sagebrush-engine.wasm
  Access-Control-Allow-Origin: *
# the Python library's chunks (web/lib-chunks.mts): named by their content's
# hash, so never changed in place
# a shared collection page's link-preview image (web/share-client/og.png): fetched by preview
# services, cross-origin; a redesign gets a new name, as crawlers keep cards for days
/s/og.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400
/lib/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
# engines by their content (web/build.ts, design/engines.md): readable from any
# page or file; on sagebrush.space the site's Worker serves them from R2
/engine/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/engine/latest.json
  Cache-Control: max-age=60
