# p-adic extensions in Sage mode: Eisenstein quadratic extensions of Qp and
# Zp (lib/_sage_padic_ext.py) and polynomial rings over Qp and Zp, against a
# real Sage (/scratch/sage-oracle/sage/sage).  Exceptions print their type.
def t(label, f):
    try:
        print(label, '->', f())
    except Exception as e:
        print(label, '!!', type(e).__name__)

K = Qp(19, 5)
R.<x> = K[]
t('K.extension(x^2+19)', lambda: K.extension(x^2 + 19, names='alpha'))
L.<alpha> = K.extension(x^2 + 19)
t('L', lambda: L)
t('L.prime()', lambda: L.prime())
t('L.precision_cap()', lambda: L.precision_cap())
t('L.uniformizer()', lambda: L.uniformizer())
t('L.degree()', lambda: L.degree())
t('L.e()', lambda: L.e())
t('L.f()', lambda: L.f())
t('L.defining_polynomial()', lambda: L.defining_polynomial())
t('L.base_ring()', lambda: L.base_ring())
t('alpha', lambda: alpha)
t('alpha^2', lambda: alpha^2)
t('alpha^-1', lambda: alpha^-1)
t('1/alpha', lambda: 1/alpha)
t('alpha + 1', lambda: alpha + 1)
t('L(5)', lambda: L(5))
t('L(19)', lambda: L(19))
t('L(1/19)', lambda: L(1/19))
t('L(-1)', lambda: L(-1))
t('L(2/3)', lambda: L(2/3))
t('(1+alpha)^-1', lambda: (1 + alpha)^-1)
t('(3 + 2*alpha)*(5 - alpha)', lambda: (3 + 2*alpha)*(5 - alpha))
t('alpha.valuation()', lambda: alpha.valuation())
t('L(19).valuation()', lambda: L(19).valuation())
t('alpha.precision_absolute()', lambda: alpha.precision_absolute())
t('alpha.precision_relative()', lambda: alpha.precision_relative())
t('L(5).precision_absolute()', lambda: L(5).precision_absolute())
t('L(0)', lambda: L(0))
t('L(0).valuation()', lambda: L(0).valuation())
t('alpha.add_bigoh(3)', lambda: alpha.add_bigoh(3))
t('L(5).add_bigoh(3)', lambda: L(5).add_bigoh(3))
t('O(alpha^3)', lambda: O(alpha^3))
t('alpha + O(alpha^3)', lambda: alpha + O(alpha^3))
t('alpha.norm()', lambda: alpha.norm())
t('alpha.trace()', lambda: alpha.trace())
t('(1+alpha).norm()', lambda: (1+alpha).norm())
t('L(18)', lambda: L(18))
t('alpha.unit_part()', lambda: alpha.unit_part())
t('(1+alpha) == 1+alpha', lambda: (1+alpha) == 1+alpha)
t('L(1) == 1', lambda: L(1) == 1)
t('alpha^2 == -19', lambda: alpha^2 == -19)
t('latex(1+alpha)', lambda: latex(1+alpha))
t('(19*alpha)^-1', lambda: (19*alpha)^-1)
t('L(1/3)', lambda: L(1/3))
t('L(1/3)*3', lambda: L(1/3)*3)
t('repr(L(100))', lambda: repr(L(100)))
t('L(400)', lambda: L(400))
t('alpha^10', lambda: alpha^10)
t('alpha^11', lambda: alpha^11)
K3 = Qp(3, 6)
S.<y> = K3[]
M.<b> = K3.extension(y^2 - 3*y + 3)
t('M', lambda: M)
t('b', lambda: b)
t('b^2', lambda: b^2)
t('b^-1', lambda: b^-1)
t('b^3', lambda: b^3)
t('M(2)', lambda: M(2))
t('M(-1)', lambda: M(-1))
t('(1+b)^-1', lambda: (1+b)^-1)
Z19 = Zp(19, 5)
U.<z> = Z19[]
t('Zp ext', lambda: Z19.extension(z^2 + 19, names='a'))
A.<a> = Z19.extension(z^2 + 19)
t('A', lambda: A)
t('a^-1', lambda: a^-1)
t('A(5)', lambda: A(5))
PS.<T> = PowerSeriesRing(L)
t('series', lambda: (alpha + T + alpha^-1*T^2 + O(T^3)))
t('series mul', lambda: (alpha + T + O(T^3))*(1 + alpha*T + O(T^3)))
t('series inv', lambda: (1 + alpha*T + O(T^3))^-1)
t('L(5) + K(3)', lambda: L(5) + K(3))
t('parent(L(5) + K(3))', lambda: parent(L(5) + K(3)))
t('alpha*K(19)', lambda: alpha*K(19))
t('K(19, 3)*alpha', lambda: K(19, 3)*alpha)
t('alpha + K(1, 2)', lambda: alpha + K(1, 2))
t('Qp(19,5).extension(x^2+19, names="beta")', lambda: Qp(19,5).extension(x^2 + 19, names='beta'))
t('extension(x^2+38)', lambda: K.extension(x^2 + 38, names='c'))
K = Qp(19, 5)
R.<x> = K[]
t('R', lambda: R)
t('x', lambda: x)
