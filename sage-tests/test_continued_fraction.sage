for v in [sqrt(17), sqrt(2)/3, (1+sqrt(5))/2, -sqrt(3), 3-2*sqrt(7)/5, sqrt(8), 1/sqrt(2), sqrt(4), sqrt(2)+1/2]:
    c = continued_fraction(v)
    print(c)
    print(list(itertools.islice(c, 25)))
for v in [pi, e, 2^(1/3), sqrt(2)+sqrt(3)]:
    c = continued_fraction(v)
    print(c)
    print(list(itertools.islice(c, 30)), c[:25], c[:12])
c = continued_fraction(sqrt(17))
print(c[3], c.quotient(5), c.convergent(3), c.numerator(3), c.denominator(3), c.value(), c[:5])
_t(lambda: len(c))
