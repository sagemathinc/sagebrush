# Special functions in Sage mode: exact values, derivatives, LaTeX, and
# numerical values (lib/_special.py) at real and complex points, against a
# real Sage (/scratch/sage-oracle/sage/sage).  Numbers are printed to 12
# significant digits (Sage's are correctly rounded; _special's are within
# a few units in the last place).
def r(v):
    v = complex(v)
    if v.imag == 0:
        return '%.12g' % v.real
    return '%.12g %+.12gi' % (v.real, v.imag)

def t(label, f):
    try:
        print(label, '->', f())
    except Exception as e:
        print(label, '!!', type(e).__name__)

var('s y')
# exact values
t('gamma(5)', lambda: gamma(5))
t('gamma(1/2)', lambda: gamma(1/2))
t('gamma(-1/2)', lambda: gamma(-1/2))
