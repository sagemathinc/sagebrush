# Laplace transforms (kernel lane 1b).  The .out is HAND-WRITTEN by
# @sagebrush-sage2, not generated: the local real Sage has no Maxima library
# mode.  Each line is Sage's documented or well-known output for that input;
# regenerate from real Sage when the oracle is available.
t, s, a = var('t s a')
print(laplace(1, t, s))
print(laplace(t^2, t, s))
print(laplace(sin(2*t), t, s))
print(laplace(cos(t), t, s))
print(laplace(exp(3*t), t, s))
print(laplace(sinh(t), t, s))
print(laplace(t^3*exp(-t), t, s))
print(laplace(t*exp(t), t, s))
print(laplace(t*sin(t), t, s))
print(laplace(heaviside(t - 2), t, s))
print(laplace(tan(t), t, s))
print(inverse_laplace(1/(s - 3), s, t))
print(inverse_laplace(1/(s^2 + 1), s, t))
print(inverse_laplace(s/(s^2 + 4), s, t))
print(inverse_laplace(2/s^3, s, t))
print(inverse_laplace(1/(s - 1)^2, s, t))
print(inverse_laplace(exp(-2*s)/s, s, t))
print(inverse_laplace(laplace(t^3*exp(-t), t, s), s, t))
print(inverse_laplace(log(s), s, t))
print(laplace(sqrt(t), t, s))
print(inverse_laplace((s + 1)/(s^2 + 2*s + 5), s, t))
print(inverse_laplace(exp(-2*s)/(s^2 + 1), s, t))
print(inverse_laplace(1/(s*(s + 1)), s, t))
print(inverse_laplace(a/(s - 1)^2, s, t))
# delays: the rule needs a known real delay c >= 0; else unevaluated (astra3 fd740cc7, grader)
print(inverse_laplace(exp(2*s)/(s^2 + 1), s, t))
print(inverse_laplace(exp(-a*s)/s, s, t))
assume(a > 0); print(inverse_laplace(exp(-a*s)/s, s, t)); forget()
# exp(0*s) is 1 when built, so this is the plain ilt(1/s): a zero delay cannot be told apart
print(inverse_laplace(exp(0*s)/s, s, t))
print(inverse_laplace(exp(-I*s)/s, s, t))
print(laplace(heaviside(t + 2), t, s))
# laplace-side guards: heaviside(t - c) needs c known real (and >= 0 for the delay); else unevaluated
print(laplace(heaviside(t - a), t, s))
assume(a > 0); print(laplace(heaviside(t - a), t, s)); forget()
print(laplace(heaviside(t - 2)*sin(t - 2), t, s))
print(laplace(heaviside(t - a)*t, t, s))
# sound but incomplete: heaviside(t + 2) is 1 for t >= 0, so this is 1/(s^2 + 1) in Sage; sagebrush leaves it unevaluated
print(laplace(heaviside(t + 2)*sin(t), t, s))
