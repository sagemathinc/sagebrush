diff = 1 + 1*x + 1/2*x^2 + 1/6*x^3 + Order(x^4)
diff([x]) = 1 + 1*x + 1/2*x^2 + 1/6*x^3 + Order(x^4)
diff(x,2) = 1 + 1*x + 1/2*x^2 + Order(x^3)
diff(x,x) = 1 + 1*x + 1/2*x^2 + Order(x^3)
diff([x,x]) = 1 + 1*x + 1/2*x^2 + Order(x^3)
derivative(x) = 1 + 1*x + 1/2*x^2 + 1/6*x^3 + Order(x^4)
diff(x,0) = 1 + 1*x + 1/2*x^2 + 1/6*x^3 + 1/24*x^4 + Order(x^5)
param diff(y) = 1*x + (y)*x^2 + (1/2*y^2)*x^3 + Order(x^4)
param diff([y]) = 1*x + (y)*x^2 + (1/2*y^2)*x^3 + Order(x^4)
diff(x,y) = 1 + (2*y)*x + (3/2*y^2)*x^2 + Order(x^3)
laurent sym = (-1)*x^(-2) + 1 + 2*x + Order(x^2)
laurent sym [x] = (-1)*x^(-2) + 1 + 2*x + Order(x^2)
at 1 = (cos(1)) + (-sin(1))*(x - 1) + Order((x - 1)^2)
O-term = Order(x^2)
L 1/z+O = -z^-2 + 1 + O(z^2)
L O(z^-1) = -3*z^-4 + O(z^-2)
P = 1 + 2*u + O(u^3)
P O = O(u^2)
x==y d/dy = (e^y) + (e^y)*(x - y) + (1/2*e^y)*(x - y)^2 + Order((x - y)^3)
x==y d/dx = (e^y) + (e^y)*(x - y) + Order((x - y)^2)
sin(x)*y^2 d/dy = (y^2*cos(y) + 2*y*sin(y)) + (-y^2*sin(y) + 2*y*cos(y))*(x - y) + (-1/2*y^2*cos(y) - y*sin(y))*(x - y)^2 + Order((x - y)^3)
frac count ! TypeError argument symb must be a symbol
ps [] = 1 + w2 + w2^2 + O(w2^4)
ps 3/2 ! ValueError cannot differentiate with respect to 3/2
sym [] = 1 + 1*x + 1/2*x^2 + Order(x^3)
