# Functions the pcimc cryptography book (github.com/lrfinotti/pcimc) uses: xsrange, random_prime, prime_factors,
# prime_divisors, randrange/choice/sample, log(base=), xgcd(list), Mod.order(), GF(p).primitive_element(), Primes(),
# Integer.digits(digits=), Integer.bits(). The .out is SageMath 10.9's output of these statements (VM2, ~/sage-conda),
# verbatim; the statements omitted from the oracle run are type() checks (S03, S08, S16, S49, S59: ours are Python ints),
# log(10^6, base=2)'s printed form (S21; Sage: 6*log(10)/log(2)); its value is checked (S22), and S20 (a malformed
# check: two independent samples compared). See test_pcimc_quickwins.deviations.md.
def show(n, f):
    try:
        v = f()
        print('S%02d %s' % (n, repr(v).replace('\n', ' ; ')))
    except Exception as e:
        print('S%02d ERR %s: %s' % (n, type(e).__name__, str(e)[:80]))
show(1, lambda: list(xsrange(10, 20)))
show(2, lambda: list(xsrange(11, 31, 2)))
show(4, lambda: list(xsrange(5)))
show(5, lambda: list(xsrange(10, 0, -3)))
show(6, lambda: type(xsrange(1, 3)).__name__)
show(7, lambda: [is_prime(random_prime(100, lbound=50)) and 50 <= random_prime(100, lbound=50) <= 100 for _ in range(20)].count(True))
show(9, lambda: random_prime(2))
show(10, lambda: random_prime(1))
show(11, lambda: random_prime(10, lbound=8))
show(12, lambda: prime_factors(360))
show(13, lambda: prime_divisors(360))
show(14, lambda: prime_factors(1))
show(15, lambda: prime_factors(-12))
show(17, lambda: all(2 <= randrange(2, 20) < 20 for _ in range(50)))
show(18, lambda: type(randrange(2, 20)))
show(19, lambda: choice([1, 10, 11]) in [1, 10, 11])
show(22, lambda: 2 * floor(log(10^6, base=2)))
show(23, lambda: log(8, base=2))
show(24, lambda: log(1024, 2))
show(25, lambda: log(10^6, base=2).n())
show(26, lambda: xgcd([30, 42, 70]))
show(27, lambda: xgcd([12, 18]))
show(28, lambda: type(xgcd([30, 42, 70])))
show(29, lambda: xgcd(1037, 349))
show(30, lambda: xgcd([6]))
show(31, lambda: Mod(3, 11).order())
show(32, lambda: Mod(0, 11).order())
show(33, lambda: Mod(4, 12).order())
show(34, lambda: Mod(3, 11).multiplicative_order())
show(35, lambda: GF(331).primitive_element())
show(36, lambda: FiniteField(331).primitive_element())
show(37, lambda: GF(7).primitive_element())
show(38, lambda: Zmod(331).primitive_element())
show(39, lambda: GF(2).primitive_element())
show(40, lambda: Primes())
show(41, lambda: Primes()[0:10])
show(42, lambda: Primes()[3])
show(43, lambda: 7 in Primes())
show(44, lambda: 8 in Primes())
show(45, lambda: [p for p in Primes()[0:6] if p > 5])
show(46, lambda: next(iter(Primes())))
show(47, lambda: Primes().next(10))
show(48, lambda: Primes().unrank(0))
show(50, lambda: Primes()[2:5])
show(51, lambda: 41943.digits(base=16, digits="0123456789ABCDEF"))
show(52, lambda: 41943.digits(base=16))
show(53, lambda: 550.digits(base=8))
show(54, lambda: 41943.bits())
show(55, lambda: Integer(41943).bits())
show(56, lambda: 41943.nbits())
show(57, lambda: 0.digits(digits="ab"))
show(58, lambda: 10.digits(2, digits=["o", "i"]))
