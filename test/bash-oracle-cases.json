{
  "about": "Cases for the bash shell's oracle freeze (plan-bash-shell r3, step 0): test/bash_oracle.py runs them in GNU bash, IPython and CPython and writes test/bash-oracle.json; test/bash-oracle.test.ts runs the redirection cases in just-bash and compares.",
  "setup": { "f": "old\n", "b": [0, 255, 128, 10, 200] },
  "observe": ["f", "n", "g", "t", "c", "e"],
  "redirections": [
    { "id": "new-gt", "script": "echo hi > n" },
    { "id": "existing-gt", "script": "echo new > f" },
    { "id": "existing-append", "script": "echo more >> f" },
    { "id": "new-append", "script": "echo a >> n" },
    { "id": "false-gt-existing", "script": "false > f" },
    { "id": "false-gt-new", "script": "false > n" },
    { "id": "cat-self-gt", "script": "cat f > f" },
    { "id": "cat-self-append", "script": "cat f >> f" },
    { "id": "group-write-then-read", "script": "{ echo x; cat f; } > f" },
    { "id": "two-gt-same-path", "script": "echo a > f > f" },
    { "id": "out-err-same-path-equal", "script": "{ echo out; echo err >&2; } > f 2> f" },
    { "id": "gt-then-dup", "script": "{ echo out; echo err >&2; } > f 2>&1" },
    { "id": "dup-then-gt", "script": "{ echo out; echo err >&2; } 2>&1 > f" },
    { "id": "pipeline-tee", "script": "echo a | tee t > f" },
    { "id": "loop-append", "script": "for i in 1 2 3; do echo $i >> f; done" },
    { "id": "loop-read-then-append", "script": "for i in 1 2; do cat f > g; echo $i >> f; done" },
    { "id": "empty-output", "script": "true > f" },
    { "id": "binary-roundtrip", "script": "cat b > c" },
    { "id": "two-fds-offset-zero", "script": "{ echo abcdef; echo X >&2; } > f 2> f" },
    { "id": "stderr-first-into-dup", "script": "{ echo E >&2; echo O; } > f 2>&1" },
    { "id": "amp-gt", "script": "{ echo E >&2; echo O; } &> f" },
    { "id": "append-then-dup", "script": "{ echo E >&2; echo O; } >> f 2>&1" },
    { "id": "quoting", "script": "x=1; echo \"a  b\" 'c $x' \"d $x\" > f" },
    { "id": "separate-files-per-stream", "script": "{ echo O; echo E >&2; } 2> e > f" },
    { "id": "input-redirect", "script": "wc -c < f > g" },
    { "id": "missing-folder", "script": "echo x > nodir/n" },
    { "id": "here-string", "script": "cat <<< \"hi\" > g" },
    { "id": "write-then-fail", "script": "{ echo partial; false; } > f" },
    { "id": "d8-before-after", "script": "echo before; echo x > nodir/n; echo after" },
    { "id": "d8-stderr-before", "script": "echo before >&2; echo x > nodir/n; echo after" },
    { "id": "d8-or-fallback", "script": "echo x > nodir/n || echo fallback" },
    { "id": "d8-and", "script": "echo x > nodir/n && echo not-run" },
    { "id": "d8-if", "script": "if echo x > nodir/n; then echo yes; else echo no; fi" },
    { "id": "d8-pipeline", "script": "echo x > nodir/n | cat; echo after" },
    { "id": "d8-committed-before", "script": "echo saved > g; echo x > nodir/n; echo after" },
    { "id": "d8-pending-before", "script": "true > g; { echo b > t; echo x > nodir/n; } > f; echo after" },
    { "id": "d8-subshell", "script": "( echo b; echo x > nodir/n; echo c ); echo after $?" },
    { "id": "d8-function", "script": "f1() { echo b; echo x > nodir/n; echo c; }; f1; echo after $?" }
  ],
  "ipython": [
    { "id": "statement", "cell": "!echo hi", "observe": ["_exit_code"] },
    { "id": "statement-status", "cell": "!false", "observe": ["_exit_code"] },
    { "id": "capture", "cell": "x = !printf 'a\\nb\\n'", "observe": ["type(x).__name__", "list(x)", "x.s", "x.n", "x.l", "_exit_code"] },
    { "id": "capture-stderr", "cell": "x = !echo out; echo err >&2", "observe": ["list(x)"] },
    { "id": "capture-status", "cell": "x = !false", "observe": ["list(x)", "_exit_code"] },
    { "id": "capture-blank-lines", "cell": "x = !printf 'a\\n\\nb'", "observe": ["list(x)", "x.n"] },
    { "id": "grep-fields", "cell": "x = !printf 'a 1\\nb 2\\nab 3\\n'", "observe": ["list(x.grep('a'))", "list(x.fields(0))", "list(x.fields(1))", "list(x.fields(0, 1))"] },
    { "id": "sort", "cell": "x = !printf 'b 2\\na 10\\nc 1\\n'", "observe": ["list(x.sort(field=0))", "list(x.sort(field=1, nums=True))"] },
    { "id": "sx", "cell": "x = %sx echo hi", "observe": ["type(x).__name__", "list(x)"] },
    { "id": "expr", "cell": "n = 3\n!echo {n+1}", "observe": [] },
    { "id": "name", "cell": "name = 'w'\n!echo $name", "observe": [] },
    { "id": "dollar-escape", "cell": "!echo '$$'", "observe": [] },
    { "id": "undefined-name", "cell": "!echo '$nosuchname'", "observe": [] },
    { "id": "double-braces", "cell": "!echo '{{a}}'", "observe": [] },
    { "id": "subscript-with-quotes", "cell": "d = {'k': 'v'}\n!echo {d['k']}", "observe": [] },
    { "id": "not-shell-quoted", "cell": "s = 'a b'\n!printf '%s\\n' $s", "observe": [] },
    { "id": "capture-interpolated", "cell": "n = 2\nx = !echo {n*21}", "observe": ["list(x)"] }
  ],
  "os_system": [
    { "id": "true", "command": "true" },
    { "id": "exit-3", "command": "exit 3" },
    { "id": "stdout", "command": "echo hi" },
    { "id": "stderr-and-status", "command": "echo err >&2; exit 1" }
  ]
}
