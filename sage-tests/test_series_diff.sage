def t(l, F):
    try: print(l, "=", F())
    except Exception as _err: print(l, "!", type(_err).__name__, _err)
x, y = var('x y')
s = exp(x).series(x, 5)
t("diff", lambda: s.diff()); t("diff([x])", lambda: s.diff([x])); t("diff(x,2)", lambda: s.diff(x, 2)); t("diff(x,x)", lambda: s.diff(x, x))
t("diff([x,x])", lambda: s.diff([x, x])); t("derivative(x)", lambda: s.derivative(x)); t("diff(x,0)", lambda: s.diff(x, 0))
s2 = (exp(x*y)).series(x, 4)
t("param diff(y)", lambda: s2.diff(y)); t("param diff([y])", lambda: s2.diff([y])); t("diff(x,y)", lambda: s2.diff(x, y))
s3 = (1/x + x + x^2).series(x, 3)
t("laurent sym", lambda: s3.diff()); t("laurent sym [x]", lambda: s3.diff([x]))
s4 = sin(x).series(x == 1, 3)
t("at 1", lambda: s4.diff([x]))
t("O-term", lambda: (x^5).series(x, 3).diff([x]))
L.<z> = LaurentSeriesRing(QQ)
t("L 1/z+O", lambda: (1/z + z + O(z^3)).derivative())
t("L O(z^-1)", lambda: (z^-3 + O(z^-1)).derivative())
P.<u> = PowerSeriesRing(QQ)
t("P", lambda: (1 + u + u^2 + O(u^4)).derivative())
t("P O", lambda: O(u^3).derivative())
