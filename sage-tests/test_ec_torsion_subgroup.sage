# Elliptic curves over QQ: torsion_subgroup() (Sage 10.9); one line per statement:
# S<nn> <value> or S<nn> ERR <type>: <msg>
def show(n, f):
    try:
        print('S%02d %s' % (n, str(f()).replace('\n', ' ; ')))
    except Exception as e:
        print('S%02d ERR %s: %s' % (n, type(e).__name__, str(e)[:200]))
E = EllipticCurve('14a1'); T = E.torsion_subgroup()
F = EllipticCurve('11a1'); U = F.torsion_subgroup()
G = EllipticCurve([0, -1, 0, -4, 4]); V = G.torsion_subgroup()
H = EllipticCurve('37a1'); W = H.torsion_subgroup()
show(1, lambda: T)
show(2, lambda: T.order())
show(3, lambda: T.invariants())
show(4, lambda: T.gens())
show(5, lambda: T.ngens())
show(6, lambda: T.gen(0))
show(7, lambda: T.points())
show(8, lambda: sorted(T.points()))
show(9, lambda: T.curve())
show(10, lambda: U)
show(11, lambda: U.invariants())
show(12, lambda: U.gens())
show(13, lambda: V)
show(14, lambda: V.invariants())
show(15, lambda: V.gens())
show(16, lambda: V.order())
show(17, lambda: W)
show(18, lambda: W.order(), )
show(19, lambda: W.gens())
show(20, lambda: W.points())
show(21, lambda: W.invariants())
show(22, lambda: T.is_cyclic())
show(23, lambda: V.is_cyclic())
show(24, lambda: len(T))
show(25, lambda: [P for P in T])
show(26, lambda: T.gen(0).order())
show(27, lambda: E.torsion_order(), )
show(28, lambda: E.torsion_points())
show(29, lambda: T.exponent())
show(30, lambda: type(T).__name__)
show(31, lambda: T(E.torsion_points()[1]))
show(32, lambda: T.ambient_group() if hasattr(T, 'ambient_group') else 'no ambient_group')
show(33, lambda: E.torsion_subgroup() is E.torsion_subgroup())
show(34, lambda: EllipticCurve('15a1').torsion_subgroup())
show(35, lambda: EllipticCurve('15a1').torsion_subgroup().gens())
# the generators and points for 3 curves of each torsion structure of conductor < 1000
for i, lab in enumerate(['11a1', '11a3', '38b1', '14a1', '14a2', '14a4', '14a3', '14a5', '15a5', '15a1', '15a3', '21a1', '15a2', '17a2', '21a2', '15a4', '21a3', '42a1', '15a7', '15a8', '17a1', '19a1', '19a3', '26a1', '26b1', '174b1', '258f1', '30a2', '90c6', '210a2', '54b3', '714i1', '66c1', '66c2', '150a3', '90c3', '210b5', '210e2']):
    show(40 + i, lambda: (lab, EllipticCurve(lab).torsion_subgroup().invariants(), EllipticCurve(lab).torsion_subgroup().gens(), EllipticCurve(lab).torsion_subgroup().points()))
