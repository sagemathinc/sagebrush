# GF(p) vector methods (Sage mode), as Sage gives them.
F = GF(101)
v = vector(F, [1, 0, 3])
w = vector(F, [2, 5, 0])
z = vector(F, [0, 0, 0])
G9.<a> = GF(9)
u9 = vector(G9, [0, a, 1])
b2 = vector(GF(2), [1, 0, 1])
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('v.inner_product(w)', lambda: v.inner_product(w))
show('v.pairwise_product(w)', lambda: v.pairwise_product(w))
show('v.outer_product(w)', lambda: v.outer_product(w))
show('v.support()', lambda: v.support())
show('w.monic()', lambda: w.monic())
show('v.monic()', lambda: v.monic())
show('z.monic()', lambda: z.monic())
show('v.lift()', lambda: v.lift())
show('w.lift_centered()', lambda: w.lift_centered())
show('vector(F, [100, 51, 50, 0]).lift_centered()', lambda: vector(F, [100, 51, 50, 0]).lift_centered())
show('v.concatenate(w)', lambda: v.concatenate(w))
show('z.support()', lambda: z.support())
show('v.normalized()', lambda: v.normalized())
show('w.normalized()', lambda: w.normalized())
show('u9.inner_product(u9)', lambda: u9.inner_product(u9))
show('u9.pairwise_product(u9)', lambda: u9.pairwise_product(u9))
show('u9.monic()', lambda: u9.monic())
show('u9.outer_product(u9)', lambda: u9.outer_product(u9))
show('u9.concatenate(v)', lambda: u9.concatenate(v))
show('v.concatenate(u9)', lambda: v.concatenate(u9))
show('b2.inner_product(b2)', lambda: b2.inner_product(b2))
show('b2.lift()', lambda: b2.lift())
show('b2.lift_centered()', lambda: b2.lift_centered())
show('v.pairwise_product(vector(F, [1, 2]))', lambda: v.pairwise_product(vector(F, [1, 2])))
show('v.inner_product(vector(F, [1, 2]))', lambda: v.inner_product(vector(F, [1, 2])))
show('v.lift().parent()', lambda: v.lift().parent())
show('w.lift_centered().parent()', lambda: w.lift_centered().parent())
show('v.concatenate(w).parent()', lambda: v.concatenate(w).parent())
