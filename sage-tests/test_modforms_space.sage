# Modular forms spaces: bounds, bases, subspaces, Eisenstein series (Sage mode), as Sage gives them.
S = CuspForms(11, 2)
M = ModularForms(11, 2)
M12 = ModularForms(1, 12)
S37 = CuspForms(37, 2)
M24 = ModularForms(24, 4)
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('S.hecke_bound()', lambda: S.hecke_bound())
show('list(S.q_echelon_basis(8))', lambda: list(S.q_echelon_basis(8)))
show('list(S.q_integral_basis(8))', lambda: list(S.q_integral_basis(8)))
show('list(M.echelon_basis())', lambda: list(M.echelon_basis()))
show('M.cuspidal_submodule().dimension()', lambda: M.cuspidal_submodule().dimension())
show('list(M.eisenstein_series())', lambda: list(M.eisenstein_series()))
show('list(M12.q_echelon_basis(6))', lambda: list(M12.q_echelon_basis(6)))
show('M.hecke_bound()', lambda: M.hecke_bound())
show('M12.hecke_bound()', lambda: M12.hecke_bound())
show('list(S37.q_echelon_basis(6))', lambda: list(S37.q_echelon_basis(6)))
show('list(S37.q_integral_basis(6))', lambda: list(S37.q_integral_basis(6)))
show('M24.hecke_bound()', lambda: M24.hecke_bound())
show('list(M.q_echelon_basis(6))', lambda: list(M.q_echelon_basis(6)))
show('list(M.q_integral_basis(6))', lambda: list(M.q_integral_basis(6)))
show('list(M12.echelon_basis())', lambda: list(M12.echelon_basis()))
show('list(S37.echelon_basis())', lambda: list(S37.echelon_basis()))
show('M.eisenstein_submodule().dimension()', lambda: M.eisenstein_submodule().dimension())
show('list(M12.eisenstein_series())', lambda: list(M12.eisenstein_series()))
show('list(ModularForms(4, 2).eisenstein_series())', lambda: list(ModularForms(4, 2).eisenstein_series()))
show('list(ModularForms(1, 4).eisenstein_series())', lambda: list(ModularForms(1, 4).eisenstein_series()))
show('list(ModularForms(6, 2).eisenstein_series())', lambda: list(ModularForms(6, 2).eisenstein_series()))
show('M24.cuspidal_submodule().dimension()', lambda: M24.cuspidal_submodule().dimension())
show('M24.eisenstein_submodule().dimension()', lambda: M24.eisenstein_submodule().dimension())
show('list(S.q_echelon_basis())', lambda: list(S.q_echelon_basis()))
show('M.sturm_bound()', lambda: M.sturm_bound())
show('S37.cuspidal_submodule().dimension()', lambda: S37.cuspidal_submodule().dimension())
show('ModularForms(4, 2).hecke_bound()', lambda: ModularForms(4, 2).hecke_bound())
show('ModularForms(1, 2).hecke_bound()', lambda: ModularForms(1, 2).hecke_bound())
show('CuspForms(11, 2).eisenstein_submodule().dimension()', lambda: CuspForms(11, 2).eisenstein_submodule().dimension())
show('list(ModularForms(9, 2).eisenstein_series())', lambda: list(ModularForms(9, 2).eisenstein_series()))
show('list(ModularForms(36, 4).eisenstein_series())', lambda: list(ModularForms(36, 4).eisenstein_series()))
show('list(ModularForms(64, 2).eisenstein_series())', lambda: list(ModularForms(64, 2).eisenstein_series()))
show('list(ModularForms(10, 4).eisenstein_series())', lambda: list(ModularForms(10, 4).eisenstein_series()))
show('list(ModularForms(11, 3).eisenstein_series())', lambda: list(ModularForms(11, 3).eisenstein_series()))
show('list(CuspForms(23, 2).q_integral_basis(8))', lambda: list(CuspForms(23, 2).q_integral_basis(8)))
show('list(ModularForms(23, 2).q_integral_basis(8))', lambda: list(ModularForms(23, 2).q_integral_basis(8)))
show('list(ModularForms(12, 4).q_integral_basis(6))', lambda: list(ModularForms(12, 4).q_integral_basis(6)))
show('list(ModularForms(5, 6).q_echelon_basis(4))', lambda: list(ModularForms(5, 6).q_echelon_basis(4)))
show('list(CuspForms(1, 24).q_integral_basis(6))', lambda: list(CuspForms(1, 24).q_integral_basis(6)))
show('list(ModularForms(35, 2).q_integral_basis(8))', lambda: list(ModularForms(35, 2).q_integral_basis(8)))
show('list(ModularForms(35, 2).q_echelon_basis(8))', lambda: list(ModularForms(35, 2).q_echelon_basis(8)))
