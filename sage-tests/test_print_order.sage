print('S56 ' + show(lambda: matrix([[x, 1, 2], [1, y, 3]]).solve_right(vector([1, 1]))))
# controls: forms our printer already matches (they must not move)
print('S57 ' + show(lambda: x^2 + 2*x + 1))
print('S58 ' + show(lambda: (x + 1)^2))
print('S59 ' + show(lambda: x*sin(x) + cos(x)))
