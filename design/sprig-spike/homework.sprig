(* a calculus homework problem: the critical points of f and the area under it *)
f[x_] := x^3 - 3 x
crit = Solve[f'[x] == 0, x]
f[x] /. crit
Integrate[f[x], {x, 0, 2}]
Series[Sin[x]/x, {x, 0, 6}]
