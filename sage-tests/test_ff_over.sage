# Relative extensions of finite fields, K.over(F) (Sage's RingExtension,
# from its reference manual): the relative trace, norm, minimal and
# characteristic polynomials over the shared core (F2 of plan-finite-fields,
# Magma's Trace(x, F) and the rest), the extension's data, and its
# elements' printing in the basis over the base. Expected output from
# Sage 10.9.
def t(label, f):
    try:
        print(label, f())
    except Exception as e:
        print(label, type(e).__name__, str(e))
F = GF(5^2); K = GF(5^4)
L = K.over(F)
z = L.gen()
t('L', lambda: L)
t('data', lambda: (L.gen(), L.gens(), L.base(), L.base_ring(), L.bases(), L.modulus(), L.modulus('y')))
t('degrees', lambda: (L.degree(F), L.degree(L), L.relative_degree(), L.absolute_degree()))
t('degree other', lambda: L.degree(GF(5)))
t('field', lambda: (L.is_field(), L.characteristic(), L.cardinality(), L.order()))
t('powers', lambda: [z^i for i in range(0, 12)])
t('vectors', lambda: [(z^i).vector() for i in range(0, 6)])
t('backend', lambda: ((z^10).backend(), (z^10).backend().parent()))
t('vector bases', lambda: ((z^10).vector(base=F), (z^10).vector(F), (z^10).vector().parent(), (z^10).vector(base=F).parent()))
t('vector other base', lambda: (z^10).vector(base=GF(5)))
for x, lab in [(z, 'z'), (z^10, 'z^10'), (L(F.gen()), 'F.gen'), (L(0), '0'), (L(1), '1'), (L(K.gen()^26), 'K.gen^26'), (z^7, 'z^7'), (z^312, 'z^312')]:
    t('trace norm ' + lab, lambda: (x.trace(), x.norm()))
    t('minpoly charpoly ' + lab, lambda: (x.minpoly(), x.charpoly()))
t('parents', lambda: (z.trace().parent(), z.norm().parent(), z.charpoly().parent(), z.parent()))
t('var', lambda: (z.charpoly(var='y'), z.minpoly(var='t')))
t('base F', lambda: (z.trace(base=F), z.norm(base=F), z.minpoly(base=F)))
t('base L', lambda: (z.trace(base=L), z.norm(base=L)))
t('base GF(5)', lambda: z.trace(base=GF(5)))
t('arith', lambda: (z + 1, z * z, z^-1, z / L(F.gen()), -z, z - z, 1 / z, z**(-3), 2 * z, z * F.gen()))
t('mix K', lambda: (z + K.gen(), K.gen() * z))
t('eq', lambda: (z == K.gen(), L(F.gen()) == F.gen(), z^24 == L(1), z == z^2))
t('in', lambda: (K.gen() in L, F.gen() in L))
t('constructor', lambda: (L(K.gen()), L(F.gen()), L(3), L(z^3)))
t('cached', lambda: K.over(F) is L)
t('named field base', lambda: GF(5^4, 'b').over(GF(5^2, 'a')))
t('not a subfield', lambda: GF(5^4).over(GF(5^3)))
P = K.over()
w = P.gen()
t('over prime', lambda: (P, P.base(), w, w^5, w^7, P(2), P.modulus()))
t('over prime values', lambda: (w.trace(), w.norm(), w.minpoly(), w.charpoly(), (w^5).trace(), (w^5).minpoly(), (w^156).minpoly()))
t('over prime vector', lambda: ((w^5).vector(), (w^7).vector()))
G = GF(2^6)
H = G.over(GF(2^3))
u = H.gen()
t('char 2 over GF(8)', lambda: (H, u, u^9, u^10, -u, u + 1, H.modulus()))
t('char 2 values', lambda: (u.trace(), u.norm(), u.minpoly(), (u^9).minpoly(), (u^9).charpoly()))
H2 = G.over(GF(2^2))
v = H2.gen()
t('char 2 over GF(4)', lambda: (H2, v^5, v^21, v.trace(), v.norm(), v.minpoly(), v.charpoly(), (v^21).charpoly()))
M3 = GF(3^4).over(GF(3^2))
s3 = M3.gen()
t('char 3', lambda: (M3, [s3^i for i in range(1, 8)], s3.trace(), (s3^10).minpoly()))
M9 = GF(3^2).over(GF(3))
w9 = M9.gen()
t('GF(9) over GF(3) vector', lambda: (w9.vector(), w9.vector().parent(), (w9^5).vector(), M9.degree(M9)))
N = K.over(F, names='w')
t('named', lambda: (N, N.gen()^10, N is K.over(F, names='w')))
