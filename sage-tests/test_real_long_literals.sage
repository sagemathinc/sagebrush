# Decimal literals of more than 15 significant digits: elements of
# RealField(p), p the bits of 10^digits, keeping their digits for every
# conversion to another precision (as Sage; x + 0 and x * 1 with an int
# are not here: pyjs refuses those, test/sage-qq-real.test.ts)
import copy
def show(f):
    try:
        return f()
    except Exception as e:
        return type(e).__name__ + ": " + str(e)

