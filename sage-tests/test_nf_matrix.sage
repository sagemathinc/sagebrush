# Matrices over number fields, by exact Gaussian elimination over K (they
# were refused; astra's round-3 hunt has 936 generated cases)
def T(name, fun):
    try: print(name, '::', fun())
    except Exception as e: print(name, '::', type(e).__name__, str(e)[:150])
P.<t> = QQ[]
K.<a> = NumberField(t^2 - 2)
A = matrix(K, [[a, 1], [2, a + 1]])
T('repr', lambda: A)
T('parent', lambda: A.parent())
T('det', lambda: A.det())
T('charpoly', lambda: A.charpoly())
T('inverse', lambda: A.inverse())
T('A * A^-1', lambda: A * A.inverse() == 1)
T('rank rref', lambda: (A.rank(), A.rref()))
B = matrix(K, [[1, a, a^2], [a, 2, 2*a], [0, 1, a]])
T('B rank', lambda: B.rank())
T('B rref', lambda: B.rref())
T('B kernel', lambda: B.right_kernel().basis_matrix())
T('B left kernel', lambda: B.kernel())
T('solve', lambda: A.solve_right(vector(K, [1, a])))
T('arith', lambda: (A + A, 2*A - a*A, A^2, A.transpose()))
T('empty', lambda: (matrix(K, 0, 0, []).dimensions(), matrix(K, 0, 3, []).rref().dimensions(), matrix(K, 2, 2, 0)))
T('identity', lambda: identity_matrix(K, 2))
L.<w> = QuadraticField(-3)
C = matrix(L, [[w, 1], [1, w]])
T('L det charpoly', lambda: (C.det(), C.charpoly()))
T('L inverse', lambda: C.inverse())
M.<b> = NumberField(t^3 - t - 1)
D = matrix(M, [[b, 1, 0], [0, b, 1], [1, 0, b]])
T('cubic det', lambda: D.det())
T('cubic charpoly', lambda: D.charpoly())
T('cubic inverse', lambda: D.inverse()[0])
T('singular inverse', lambda: matrix(K, [[a, 2], [1, a]]).inverse())
T('singular solve', lambda: matrix(K, [[a, 2], [1, a]]).solve_right(vector(K, [1, 0])))
