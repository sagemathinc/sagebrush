R.irreducible_element(5, algorithm='first_lexicographic') -> x^5 + 2
R.irreducible_element(1, algorithm='first_lexicographic') -> x
R.irreducible_element(2, algorithm='first_lexicographic') -> x^2 + 2
T.irreducible_element(8, algorithm='first_lexicographic') -> z^8 + z^4 + z^3 + z + 1
GF(5)['u'].irreducible_element(3, algorithm='first_lexicographic') -> u^3 + u + 1
R.irreducible_element(3) -> x^3 + 3*x + 99
R.irreducible_element(0, algorithm='first_lexicographic') -> ValueError: degree must be at least 1
R.lagrange_polynomial([(1, 2), (2, 5), (3, 10)]) -> x^2 + 1
R.lagrange_polynomial([]) -> 0
R.lagrange_polynomial([(4, 7)]) -> 7
R.lagrange_polynomial([(0, 1), (1, 3), (2, 2), (3, 7), (4, 0)]) -> 62*x^4 + 84*x^3 + 70*x^2 + 89*x + 1
R.lagrange_polynomial([(1, 2), (1, 2)]) -> ZeroDivisionError: inverse of Mod(0, 101) does not exist
S.lagrange_polynomial([(a, 1), (1, a), (0, a + 1)]) -> 2*y + a + 1
T.lagrange_polynomial([(0, 1), (1, 1)]) -> 1
R.cyclotomic_polynomial(12) -> x^4 + 100*x^2 + 1
T.cyclotomic_polynomial(7) -> z^6 + z^5 + z^4 + z^3 + z^2 + z + 1
R.cyclotomic_polynomial(1) -> x + 100
R.cyclotomic_polynomial(2) -> x + 1
R.cyclotomic_polynomial(30) -> x^8 + x^7 + 100*x^5 + 100*x^4 + 100*x^3 + x + 1
T.cyclotomic_polynomial(12) -> z^4 + z^2 + 1
S.cyclotomic_polynomial(9) -> y^6 + y^3 + 1
R.cyclotomic_polynomial(0) -> ArithmeticError: n=0 must be positive
len(list(T.monics(of_degree=3))) -> 8
list(T.monics(of_degree=2)) -> [z^2, z^2 + 1, z^2 + z, z^2 + z + 1]
list(T.monics(max_degree=2)) -> [1, z, z + 1, z^2, z^2 + 1, z^2 + z, z^2 + z + 1]
list(T.monics(of_degree=0)) -> [1]
list(GF(3)["u"].monics(of_degree=2)) -> [u^2, u^2 + 1, u^2 + 2, u^2 + u, u^2 + u + 1, u^2 + u + 2, u^2 + 2*u, u^2 + 2*u + 1, u^2 + 2*u + 2]
list(S.monics(of_degree=1)) -> [y, y + a, y + a + 1, y + 2*a + 1, y + 2, y + 2*a, y + 2*a + 2, y + a + 2, y + 1]
len(list(R.monics(of_degree=2))) -> 10201
list(R.monics(of_degree=2))[:3] -> [x^2, x^2 + 1, x^2 + 2]
list(T.monics()) -> ValueError: you should pass exactly one of of_degree and max_degree
