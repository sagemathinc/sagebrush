# Elements of two quotients meet through the canonical quotient maps, or not at all
# (astra's CORR-3E3-1: a == b and b == a differed, and a + b was taken in a's parent)
def T(name, fun):
    try: print(name, '::', fun())
    except Exception as e: print(name, '::', type(e).__name__, str(e)[:150])
R.<x,y> = QQ[]
A = R.quo([x^2 - 1]); B = R.quo([x - 1]); C = R.quo([x]); D = R.quo([x^2 - 1, y])
a, b = A(x), B(x)
T('A is R.quo again', lambda: A is R.quo([x^2 - 1]))
T('A is quo by ideal', lambda: A is R.quo(R.ideal(x^2 - 1)))
T('eq ab ba', lambda: (a == b, b == a, a != b, b != a))
T('add', lambda: ((a + b), (a + b).parent() is B, (b + a), (b + a).parent() is B))
T('mul sub', lambda: (a * b, b * a, a - b, b - a))
T('incompatible eq', lambda: (C(x) == B(x), B(x) == C(x), C(0) == B(0), B(1) == C(1)))
T('incompatible add', lambda: C(x) + B(x))
T('incompatible mul', lambda: B(x) * C(y))
T('D to A', lambda: (A(x) + D(y), (A(x) + D(y)).parent() is D, A(x) == D(x)))
T('conv B(a)', lambda: (B(a), B(a).parent() is B))
T('conv A(b)', lambda: A(b))
T('conv C(b)', lambda: C(b))
T('names', lambda: (R.quo([x^2 - 1], names='u,v')(x) + a))
T('names eq', lambda: R.quo([x^2 - 1], names='u,v')(x) == a)
S.<x,y> = PolynomialRing(QQ, order='lex')
E = S.quo([x^2 - 1])
T('other order', lambda: (E(x) == a, a == E(x)))
T('other order add', lambda: E(x) + a)
F = PolynomialRing(GF(5), 'x,y').quo([x^2 - 1])
T('other base add', lambda: F(x) + a)
T('other base eq', lambda: (F(x) == a, a == F(x)))
T('with poly', lambda: (a + R(y), R(y) + a, a == R(x), R(x) == a))
T('with int', lambda: (a + 1, 1 + a, a == 1, 2 * a))
R.<x,y> = QQ[]
A = R.quo([x - 1]); B = R.quo([x*y])
a, b = A(x), B(x)
T('push eq', lambda: (a == b, b == a, A(y) == B(y), A(y) == B(0)))
T('push add', lambda: (a + b, b + a))
T('push parent', lambda: ((a + b).parent(), (b + a).parent()))
T('push parent gens', lambda: (a + b).parent().defining_ideal().gens())
T('push names', lambda: (R.quo([x - 1], names='u,v')(y) + B(y), B(y) + R.quo([x - 1], names='u,v')(y)))
T('push mul', lambda: (A(y) * B(y), B(x*y) * A(1)))
T('push unit', lambda: R.quo([x])(x) + R.quo([x - 1])(x))
T('push three', lambda: (a + b + R.quo([y - 2])(y)))
T('push lift', lambda: (a + b).lift())
S.<u,v> = GF(7)[]
T('gf7 latex', lambda: (latex(3*u^2*v - v + 2), latex(u^2 - 3*u*v + 2*v^3 - 1), latex(-u - v - 1), latex(-2*u - 1), latex(-u + 6), latex(S(-1)), latex(S(-3)), latex(-u)))
S2.<s,t> = GF(2)[]
T('gf2 latex', lambda: (latex(s + t + 1), latex(-s)))
S3.<p,q> = GF(3)[]
T('gf3 latex', lambda: (latex(-p - q - 1), latex(2*p*q + 2), latex(-p^2*q)))
R.<x,y> = QQ[]
A = R.quo([x^2 - 1]); B = R.quo([x - 1]); Bn = R.quo([x - 1], names='u,v'); An = R.quo([x^2 - 1], names='u,v')
T('names contain', lambda: (A(x) + Bn(x), Bn(x) + A(x), (A(x) + Bn(x)).parent() is Bn))
T('names contain rev', lambda: (An(x) + B(x), B(x) + An(x)))
T('names eq', lambda: (A(x) == Bn(x), Bn(x) == A(x), An(x) == B(y), An(x) == R.quo([x*y])(x)))
C = R.quo([x*y]); D = R.quo([y^2])
T('push order', lambda: ((C(x) + D(y)).parent(), (D(y) + C(x)).parent()))
E = R.quo([x^2 + y]); F = R.quo([y^3 - x])
T('push order2', lambda: ((E(x) + F(y)).parent(), (F(y) + E(x)).parent()))
T('push order3', lambda: ((R.quo([x - 1])(x) + R.quo([y^2 + 1])(y)).parent()))
R.<x,y> = QQ[]
T('zero ideal', lambda: [R.quo(I) is R for I in ([0], [], R.ideal(0), [0, 0])] + [R.quo([0], names='u,v') is R])
T('zero ideal mix', lambda: (R.quo([0])(x) + R.quo([x - 1])(x), R.quo([x - 1])(x) == R.quo([0])(x)))
