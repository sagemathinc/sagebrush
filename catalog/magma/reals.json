[
  {
    "name": "RealField",
    "kind": "function",
    "signature": "(<RngIntElt> k) -> FldRe",
    "summary": "The real numbers to k significant decimal digits (30 by default, RealField()).",
    "examples": [
      {
        "code": "R := RealField(10); R; R!(1/3);",
        "expected": "Real field of precision 10\n0.3333333333\n"
      }
    ],
    "differs": [
      "A precision above 1000 digits is refused."
    ],
    "status": "partial",
    "see_also": [
      "Pi",
      "Sqrt"
    ],
    "upstream_version": "Magma 2.18",
    "tags": [
      "rationals and reals"
    ]
  },
