# Elliptic curves over RR (base_extend(RR)) and lift_x with real x (Sage 10.9); one line per statement:
# S<nn> <value> or S<nn> ERR <type>: <msg>
def show(n, f):
    try:
        print('S%02d %s' % (n, str(f()).replace('\n', ' ; ')))
    except Exception as e:
        print('S%02d ERR %s: %s' % (n, type(e).__name__, str(e)[:160]))
E2 = EllipticCurve([-1, 0])
E37 = EllipticCurve('37a')
ER = E2.base_extend(RR)
show(1, lambda: ER)
show(2, lambda: ER.base_ring())
show(3, lambda: ER.a_invariants())
show(4, lambda: ER.lift_x(RR(-0.5), all=True))
show(5, lambda: ER.lift_x(RR(1.1), all=True))
show(6, lambda: ER.lift_x(RR(0.5), all=True))
show(7, lambda: ER.lift_x(RR(-0.5)))
show(8, lambda: ER.lift_x(RR(0.5)))
show(9, lambda: ER.lift_x(-0.8, all=True))
show(10, lambda: ER.lift_x(1))
P = ER.lift_x(RR(-0.5), all=True)[0]
Q = ER.lift_x(RR(1.1), all=True)[0]
show(11, lambda: P)
show(12, lambda: (P[0], P[1], P[2]))
show(13, lambda: -P)
show(14, lambda: P.xy())
show(16, lambda: P + Q)
show(17, lambda: 2 * P)
show(18, lambda: P - P)
show(19, lambda: P.parent())
show(20, lambda: bool(1 * P[1] < 0))
show(21, lambda: ER(0))
show(22, lambda: ER(0).xy())
show(23, lambda: ER((1, 0)))
show(24, lambda: ER(1, 0))
show(25, lambda: ER((1, 1)))
show(26, lambda: E2.lift_x(-0.5))
show(27, lambda: E2.lift_x(-0.5).xy())
show(28, lambda: (-E2.lift_x(-0.5)).xy())
show(29, lambda: E2.lift_x(-0.5, all=True))
show(30, lambda: E2.lift_x(-1/2))
show(31, lambda: E2.lift_x(1/2, all=True))
show(32, lambda: E2((1, 0)).xy())
show(33, lambda: E37.base_extend(RR))
show(34, lambda: E37.base_extend(RR).lift_x(RR(2), all=True))
show(35, lambda: E37.base_extend(RR).lift_x(RR(-1)))
show(36, lambda: E37.lift_x(2.5))
show(37, lambda: ER.discriminant())
show(38, lambda: ER.j_invariant())
show(39, lambda: plot(ER))
show(40, lambda: ER.change_ring(RR) == ER)
show(41, lambda: ER == E2)
show(42, lambda: E2.base_extend(RR) == ER)
show(43, lambda: P == ER.lift_x(RR(-0.5), all=True)[0])
show(44, lambda: P.xy()[1] > 0)
show(45, lambda: ER.lift_x(RR(-0.8), all=True)[0].xy())
show(46, lambda: (P + Q).xy())
show(47, lambda: P.is_zero())
show(48, lambda: (P - P).is_zero())
show(49, lambda: E2.base_extend(RR).lift_x(RR(0), all=True))
show(50, lambda: list(ER.lift_x(RR(2.0), all=True)[1]))
# (daybreak3's B1: user coordinates are checked exactly, as in Sage; a point itself is accepted)
E = EllipticCurve([-1, 0]).base_extend(RR)
P = E.lift_x(RR(-0.5))
show(51, lambda: E(1, 2e-5))
show(52, lambda: E(P.xy()))
show(53, lambda: E(P))
show(54, lambda: E(list(P)))
show(55, lambda: E(RR(-0.5), RR(-0.5)^3 + 0.5))
show(56, lambda: E(2, sqrt(RR(6))))
show(57, lambda: E(0, 0))
# (grader's #492 TESTS: a general Weierstrass curve, a1 and a3 nonzero, so the b- and c-invariants,
# negation, doubling and addition see every coefficient; projective input; negative multiples)
E = EllipticCurve([1, 2, 3, 4, 5]).base_extend(RR)
show(58, lambda: E.b_invariants())
show(59, lambda: E.discriminant())
show(60, lambda: E.j_invariant())
P = E.lift_x(RR(1.5), all=True)[0]
Q = E.lift_x(RR(-0.25), all=True)[0]
show(61, lambda: P)
show(62, lambda: -P)
show(63, lambda: 2 * P)
show(64, lambda: P + Q)
show(65, lambda: (-3) * P)
show(66, lambda: P - Q)
E2 = EllipticCurve([-1, 0]).base_extend(RR)
show(67, lambda: E2([2, 0, 2]))
show(68, lambda: E2([1, 1, 0]))
show(69, lambda: E2([0, 3, 0]))
show(70, lambda: (-2) * E2.lift_x(RR(-0.5)))
