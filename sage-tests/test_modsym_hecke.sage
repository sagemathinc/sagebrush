# Modular symbols: Hecke matrices, basis, dimension, Sturm bound, sign (Sage mode), as Sage gives them.
M = ModularSymbols(11, 2)
M37 = ModularSymbols(37, 2, sign=1)
M37m = ModularSymbols(37, 2, sign=-1)
M33 = ModularSymbols(33, 2)
M4 = ModularSymbols(1, 12)
M23 = ModularSymbols(23, 2, sign=1)
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('M.hecke_matrix(2)', lambda: M.hecke_matrix(2))
show('M.hecke_matrix(3).charpoly()', lambda: M.hecke_matrix(3).charpoly())
show('M.dimension()', lambda: M.dimension())
show('M37.dimension()', lambda: M37.dimension())
show('M37.hecke_matrix(2)', lambda: M37.hecke_matrix(2))
show('M.sturm_bound()', lambda: M.sturm_bound())
show('M.sign()', lambda: M.sign())
show('M37.sign()', lambda: M37.sign())
show('M37m.sign()', lambda: M37m.sign())
show('M37m.dimension()', lambda: M37m.dimension())
show('M37m.hecke_matrix(2)', lambda: M37m.hecke_matrix(2))
show('M.hecke_matrix(5)', lambda: M.hecke_matrix(5))
show('M.hecke_matrix(11)', lambda: M.hecke_matrix(11))
show('M.hecke_matrix(4)', lambda: M.hecke_matrix(4))
show('M.hecke_matrix(6) == M.hecke_matrix(2)*M.hecke_matrix(3)', lambda: M.hecke_matrix(6) == M.hecke_matrix(2)*M.hecke_matrix(3))
show('M37.hecke_matrix(3)', lambda: M37.hecke_matrix(3))
show('M37.hecke_matrix(37)', lambda: M37.hecke_matrix(37))
show('M33.dimension()', lambda: M33.dimension())
show('M33.hecke_matrix(2).charpoly()', lambda: M33.hecke_matrix(2).charpoly())
show('M33.hecke_matrix(5).charpoly().factor()', lambda: M33.hecke_matrix(5).charpoly().factor())
show('M4.dimension()', lambda: M4.dimension())
show('M4.hecke_matrix(2)', lambda: M4.hecke_matrix(2))
show('M4.sturm_bound()', lambda: M4.sturm_bound())
show('M37.sturm_bound()', lambda: M37.sturm_bound())
show('M33.sturm_bound()', lambda: M33.sturm_bound())
show('M23.hecke_matrix(2).charpoly().factor()', lambda: M23.hecke_matrix(2).charpoly().factor())
show('M.basis()', lambda: M.basis())
show('M37.basis()', lambda: M37.basis())
show('M.hecke_matrix(2).parent()', lambda: M.hecke_matrix(2).parent())
show('M.hecke_matrix(0)', lambda: M.hecke_matrix(0))
show('M.hecke_matrix(-1)', lambda: M.hecke_matrix(-1))
show('M.T(2).matrix()', lambda: M.T(2).matrix())
show('M.hecke_operator(2).matrix() == M.hecke_matrix(2)', lambda: M.hecke_operator(2).matrix() == M.hecke_matrix(2))
show('ModularSymbols(11, 4).dimension()', lambda: ModularSymbols(11, 4).dimension())
show('ModularSymbols(11, 4).hecke_matrix(2).charpoly()', lambda: ModularSymbols(11, 4).hecke_matrix(2).charpoly())
show('ModularSymbols(11, 2, sign=1).hecke_matrix(2)', lambda: ModularSymbols(11, 2, sign=1).hecke_matrix(2))
show('M.weight()', lambda: M.weight())
show('M.level()', lambda: M.level())
show('M37.hecke_polynomial(2)', lambda: M37.hecke_polynomial(2))
show('M.hecke_polynomial(3)', lambda: M.hecke_polynomial(3))
show('ModularSymbols(11, 3).hecke_matrix(2)', lambda: ModularSymbols(11, 3).hecke_matrix(2))
show('ModularSymbols(11, 3).basis()', lambda: ModularSymbols(11, 3).basis())
show('ModularSymbols(1, 2).hecke_matrix(2)', lambda: ModularSymbols(1, 2).hecke_matrix(2))
show('ModularSymbols(1, 2).cuspidal_submodule().dimension()', lambda: ModularSymbols(1, 2).cuspidal_submodule().dimension())
show('ModularSymbols(11, 2).hecke_matrix(1)', lambda: ModularSymbols(11, 2).hecke_matrix(1))
show('ModularSymbols(11, 2).hecke_matrix(121).charpoly()', lambda: ModularSymbols(11, 2).hecke_matrix(121).charpoly())
show('ModularSymbols(2, 8).hecke_matrix(2)', lambda: ModularSymbols(2, 8).hecke_matrix(2))
show('ModularSymbols(49, 2, sign=1).eisenstein_submodule().hecke_matrix(3).charpoly()', lambda: ModularSymbols(49, 2, sign=1).eisenstein_submodule().hecke_matrix(3).charpoly())
show('ModularSymbols(25, 4).cuspidal_submodule().hecke_matrix(2).charpoly()', lambda: ModularSymbols(25, 4).cuspidal_submodule().hecke_matrix(2).charpoly())
show('ModularSymbols(11, 2).T(3).matrix()', lambda: ModularSymbols(11, 2).T(3).matrix())
