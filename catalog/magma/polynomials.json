  {
    "name": "IsIrreducible",
    "kind": "function",
    "signature": "(<RngUPolElt> f) -> BoolElt",
    "summary": "Whether a nonzero polynomial is irreducible over its coefficient ring (a constant never is).",
    "examples": [
      {
        "code": "P<x> := PolynomialRing(Integers()); IsIrreducible(x^2 + 1); IsIrreducible(x^2 - 1); IsIrreducible(2*x + 4);",
        "expected": "true\nfalse\nfalse\n"
      }
    ],
    "differs": [],
    "status": "full",
    "upstream_version": "Magma 2.18",
    "tags": [
      "polynomials"
    ]
  },
  {
    "name": "Factorization",
    "kind": "function",
    "signature": "(<RngUPolElt> f) -> SeqEnum, RngElt",
    "summary": "The factorization of a nonzero polynomial into irreducibles, as [<factor, exponent>, ...], and its leading coefficient.",
    "examples": [
      {
        "code": "P<x> := PolynomialRing(Integers()); Factorization(x^4 - 1);",
        "expected": "[\n    <x - 1, 1>,\n    <x + 1, 1>,\n    <x^2 + 1, 1>\n]\n"
      },
      {
        "code": "Q<t> := PolynomialRing(Rationals()); Factorization(2*t^2 - 1/2);",
        "expected": "[\n    <t - 1/2, 1>,\n    <t + 1/2, 1>\n]\n"
      }
    ],
    "differs": [
      "Polynomial rings over the integers and the rationals only: over other rings, PolynomialRing is refused."
    ],
    "status": "partial",
    "see_also": [
      "Roots",
      "IsIrreducible"
    ],
    "upstream_version": "Magma 2.18",
    "tags": [
      "polynomials"
    ]
  },
  {
    "name": "Gcd",
    "kind": "function",
    "signature": "(<RngUPolElt> f, <RngUPolElt> g) -> RngUPolElt",
    "summary": "The greatest common divisor of two polynomials (monic over the rationals).",
    "examples": [
      {
        "code": "P<x> := PolynomialRing(Integers()); Gcd(x^2 - 1, x^2 - 2*x + 1);",
        "expected": "x - 1\n"
      }
    ],
    "differs": [],
    "status": "full",
    "upstream_version": "Magma 2.18",
    "tags": [
      "polynomials"
    ]
  }
]
