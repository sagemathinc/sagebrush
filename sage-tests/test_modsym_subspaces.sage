# Modular symbols: cuspidal, Eisenstein and new subspaces (Sage mode), as Sage gives them.
M = ModularSymbols(11, 2)
M33 = ModularSymbols(33, 2)
M37 = ModularSymbols(37, 2, sign=1)
M1 = ModularSymbols(1, 12)
M24 = ModularSymbols(24, 2)
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('M.cuspidal_submodule().dimension()', lambda: M.cuspidal_submodule().dimension())
show('M.eisenstein_submodule().dimension()', lambda: M.eisenstein_submodule().dimension())
show('M33.new_submodule().dimension()', lambda: M33.new_submodule().dimension())
show('M33.cuspidal_submodule().dimension()', lambda: M33.cuspidal_submodule().dimension())
show('M.cuspidal_submodule().is_cuspidal()', lambda: M.cuspidal_submodule().is_cuspidal())
show('M.is_cuspidal()', lambda: M.is_cuspidal())
show('M33.cuspidal_submodule().hecke_matrix(2).charpoly()', lambda: M33.cuspidal_submodule().hecke_matrix(2).charpoly())
show('M33.eisenstein_submodule().dimension()', lambda: M33.eisenstein_submodule().dimension())
show('M33.new_submodule().cuspidal_submodule().dimension()', lambda: M33.new_submodule().cuspidal_submodule().dimension())
show('M33.cuspidal_submodule().new_submodule().dimension()', lambda: M33.cuspidal_submodule().new_submodule().dimension())
show('M33.eisenstein_submodule().hecke_matrix(2).charpoly()', lambda: M33.eisenstein_submodule().hecke_matrix(2).charpoly())
show('M33.new_submodule().hecke_matrix(2).charpoly()', lambda: M33.new_submodule().hecke_matrix(2).charpoly())
show('M37.cuspidal_submodule().dimension()', lambda: M37.cuspidal_submodule().dimension())
show('M37.eisenstein_submodule().dimension()', lambda: M37.eisenstein_submodule().dimension())
show('M37.cuspidal_submodule().hecke_matrix(2).charpoly()', lambda: M37.cuspidal_submodule().hecke_matrix(2).charpoly())
show('M37.new_submodule().dimension()', lambda: M37.new_submodule().dimension())
show('M1.cuspidal_submodule().dimension()', lambda: M1.cuspidal_submodule().dimension())
show('M1.eisenstein_submodule().dimension()', lambda: M1.eisenstein_submodule().dimension())
show('M1.cuspidal_submodule().hecke_matrix(2)', lambda: M1.cuspidal_submodule().hecke_matrix(2))
show('M24.new_submodule().dimension()', lambda: M24.new_submodule().dimension())
show('M24.cuspidal_submodule().dimension()', lambda: M24.cuspidal_submodule().dimension())
show('M24.eisenstein_submodule().dimension()', lambda: M24.eisenstein_submodule().dimension())
show('M.eisenstein_submodule().is_cuspidal()', lambda: M.eisenstein_submodule().is_cuspidal())
show('M.cuspidal_submodule().is_eisenstein()', lambda: M.cuspidal_submodule().is_eisenstein())
show('M.eisenstein_submodule().is_eisenstein()', lambda: M.eisenstein_submodule().is_eisenstein())
show('M.cuspidal_submodule()', lambda: M.cuspidal_submodule())
show('M.eisenstein_submodule()', lambda: M.eisenstein_submodule())
show('M33.new_submodule()', lambda: M33.new_submodule())
show('M.new_submodule() == M', lambda: M.new_submodule() == M)
show('M.cuspidal_submodule().hecke_matrix(3)', lambda: M.cuspidal_submodule().hecke_matrix(3))
show('M33.cuspidal_submodule().sign()', lambda: M33.cuspidal_submodule().sign())
show('M.cuspidal_subspace().dimension()', lambda: M.cuspidal_subspace().dimension())

show('ModularSymbols(25, 2).new_submodule().hecke_matrix(2).charpoly()', lambda: ModularSymbols(25, 2).new_submodule().hecke_matrix(2).charpoly())
show('ModularSymbols(24, 4).new_submodule().dimension()', lambda: ModularSymbols(24, 4).new_submodule().dimension())
show('ModularSymbols(36, 2, sign=1).new_submodule().hecke_matrix(5).charpoly()', lambda: ModularSymbols(36, 2, sign=1).new_submodule().hecke_matrix(5).charpoly())
show('M37.new_submodule() == M37', lambda: M37.new_submodule() == M37)
show('ModularSymbols(22, 2).new_submodule().is_cuspidal()', lambda: ModularSymbols(22, 2).new_submodule().is_cuspidal())
show('ModularSymbols(50, 2).cuspidal_submodule().new_submodule().hecke_matrix(3).charpoly()', lambda: ModularSymbols(50, 2).cuspidal_submodule().new_submodule().hecke_matrix(3).charpoly())
show('ModularSymbols(22, 4).new_submodule().hecke_matrix(3).charpoly()', lambda: ModularSymbols(22, 4).new_submodule().hecke_matrix(3).charpoly())
show('ModularSymbols(36, 2, sign=-1).new_submodule().dimension()', lambda: ModularSymbols(36, 2, sign=-1).new_submodule().dimension())
show('ModularSymbols(45, 2, sign=1).new_submodule().hecke_matrix(2).charpoly()', lambda: ModularSymbols(45, 2, sign=1).new_submodule().hecke_matrix(2).charpoly())
show('ModularSymbols(30, 4, sign=1).new_submodule().hecke_matrix(7).charpoly()', lambda: ModularSymbols(30, 4, sign=1).new_submodule().hecke_matrix(7).charpoly())
show('ModularSymbols(26, 2).new_submodule().hecke_matrix(3)', lambda: ModularSymbols(26, 2).new_submodule().hecke_matrix(3))
show('ModularSymbols(18, 4).new_submodule().dimension()', lambda: ModularSymbols(18, 4).new_submodule().dimension())
show('ModularSymbols(20, 6, sign=-1).new_submodule().hecke_matrix(3).charpoly()', lambda: ModularSymbols(20, 6, sign=-1).new_submodule().hecke_matrix(3).charpoly())
