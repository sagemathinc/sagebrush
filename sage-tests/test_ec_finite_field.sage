# Elliptic curves over GF(p) and Zmod(p), p prime, as the pcimc cryptography book (github.com/lrfinotti/pcimc,
# ch. 16) uses them: curves from Mod/GF(p) coefficients, points and their arithmetic, orders (secp256k1's included),
# lift_x, points(), and the errors.  The .out is SageMath 10.9's output of these statements (VM2, ~/sage-conda),
# verbatim, less S106-S108 and S112 (see test_ec_finite_field.deviations.md).  show prints the value and its parent;
# showr prints only the value, where Sage's parent is a Python class name.
def show(n, f):
    try:
        v = f()
        print('S%02d %s | %s' % (n, repr(v).replace('\n', ' ; '), parent(v)))
    except Exception as e:
        print('S%02d ERR %s: %s' % (n, type(e).__name__, str(e)[:160]))
def showr(n, f):
    try:
        print('S%02d %s' % (n, repr(f()).replace('\n', ' ; ')))
    except Exception as e:
        print('S%02d ERR %s: %s' % (n, type(e).__name__, str(e)[:160]))
E = EllipticCurve([Mod(7, 11), Mod(2, 11)])
showr(1, lambda: E)
x1, y1 = Mod(8, 11), Mod(3, 11)
x2, y2 = Mod(10, 11), Mod(4, 11)
a, b = Mod(7, 11), Mod(2, 11)
show(2, lambda: ((x1, y1) in E, (x2, y2) in E))
show(3, lambda: (Mod(1, 11), Mod(1, 11)) in E)
P = E((x1, y1)); Q = E(x2, y2)
show(4, lambda: (P, Q))
show(5, lambda: (P.xy(), Q.xy()))
show(6, lambda: (P + Q).xy())
show(7, lambda: (-Q).xy())
show(8, lambda: (3 * P - 4 * Q).xy())
O = E(0)
show(9, lambda: O)
show(10, lambda: (O + P == P, O + Q == Q))
showr(11, lambda: E.points())
show(12, lambda: (E.a4() == a, E.a6() == b))
show(13, lambda: [k * P for k in range(2, 8)])
show(14, lambda: (P.order(), Q.order()))
show(15, lambda: E.order())
show(16, lambda: E.cardinality())
showr(17, lambda: E.base_ring())
show(18, lambda: E.discriminant())
show(19, lambda: E.j_invariant())
show(20, lambda: E((1, 1)))
show(21, lambda: O.xy())
show(22, lambda: (P[0], P[1], P[2]))
show(23, lambda: P.order() * P)
show(24, lambda: E.lift_x(Mod(8, 11)))
show(25, lambda: E.lift_x(8, all=True))
show(26, lambda: E.lift_x(Mod(1, 11)))
show(27, lambda: E.a_invariants())
show(28, lambda: EllipticCurve(GF(11), [7, 2]) == E)
showr(29, lambda: EllipticCurve(GF(11), [1, 2, 3, 4, 5]))
showr(30, lambda: EllipticCurve(GF(11), [1, 2, 3, 4, 5]).points())
show(31, lambda: EllipticCurve([Mod(1, 11), Mod(2, 11), Mod(3, 11), Mod(4, 11), Mod(5, 11)]).order())
show(32, lambda: EllipticCurve([Mod(0, 11), Mod(0, 11)]))
showr(33, lambda: EllipticCurve(GF(13), [0, 1]).points())
show(34, lambda: P == Q)
show(35, lambda: P - P)
show(36, lambda: 0 * P)
show(37, lambda: -O)
show(38, lambda: P.is_zero())
show(39, lambda: O.is_zero())
show(40, lambda: hash(P) == hash(E((x1, y1))))
p = 42997061
Fp = FiniteField(p)
a, b = Fp(32122457), Fp(12623843)
E = EllipticCurve([a, b])
showr(41, lambda: E)
P = E((22035006, 41971927))
show(42, lambda: P)
show(43, lambda: P.order())
show(44, lambda: E.order())
show(45, lambda: (123456 * P).xy())
show(46, lambda: (123456 * P)[0])
showr(47, lambda: parent((123456 * P)[0]))
xB = (777 * P)[0]
yyB = sqrt(xB^3 + a * xB + b)
show(48, lambda: yyB)
show(49, lambda: (999 * E((xB, yyB))).xy())
show(50, lambda: (999 * 777 * P).xy())
G = E((14600094, 16940532))
q = G.order()
show(51, lambda: (q, is_prime(q)))
show(52, lambda: (1780580 * G).xy())
show(53, lambda: E.lift_x(Fp(22035006)))
show(54, lambda: E.lift_x(Fp(22035006), all=True))
p = 2^256 - 2^32 - 977
E = EllipticCurve([Mod(0, p), Mod(7, p)])
showr(55, lambda: E)
show(56, lambda: E.order())
show(57, lambda: is_prime(E.order()))
Gx = 0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798
Gy = 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8
G = E(Gx, Gy)
show(58, lambda: (2 * G).xy())
show(59, lambda: G.order())
show(60, lambda: EllipticCurve(GF(10007), [-2, 0]).order())
show(61, lambda: EllipticCurve(GF(10009), [0, 5]).order())
show(62, lambda: EllipticCurve(GF(1000003), [3, 0]).order())
show(63, lambda: EllipticCurve(GF(1000033), [0, 3]).order())
showr(64, lambda: EllipticCurve(GF(2), [1, 1]))
showr(65, lambda: EllipticCurve(GF(2), [1, 1]).points())
showr(66, lambda: EllipticCurve(GF(3), [1, 1]).points())
show(67, lambda: EllipticCurve(GF(5), [1, 1]).order())
showr(68, lambda: EllipticCurve(GF(101), [Mod(1, 101), 3]))
show(69, lambda: EllipticCurve([Mod(1, 11), Mod(2, 13)]))
showr(70, lambda: EllipticCurve([Mod(1, 11), 2]))
show(71, lambda: EllipticCurve([Mod(1, 11), 1/2]))
show(72, lambda: EllipticCurve(GF(11), [7, 2])(8, 3, 1))
show(73, lambda: EllipticCurve(GF(11), [7, 2])([8, 3]))
show(74, lambda: EllipticCurve(GF(11), [7, 2])(2, 6, 2))
show(75, lambda: E(0) == 0)
show(76, lambda: EllipticCurve(GF(11), [7, 2]).random_point() in EllipticCurve(GF(11), [7, 2]))
showr(77, lambda: EllipticCurve(GF(7), [3, 0]).points())
show(78, lambda: EllipticCurve(GF(1000003), [5, 7]).order())
show(79, lambda: EllipticCurve(GF(1000000007), [5, 7]).order())
show(80, lambda: EllipticCurve(GF(11), [7, 2]).change_ring(GF(11)) == EllipticCurve(GF(11), [7, 2]))

F = GF(10007); E = EllipticCurve(F, [3, 5])
showr(81, lambda: [E.lift_x(F(x)) for x in range(1, 40) if E.is_x_coord(F(x))][:12])
showr(82, lambda: [E.lift_x(F(x), all=True) for x in range(1, 12)])
E = EllipticCurve([Mod(7, 11), Mod(2, 11)])
showr(83, lambda: [E.lift_x(x) for x in range(11) if E.is_x_coord(x)])
showr(84, lambda: E(0).xy())
showr(85, lambda: EllipticCurve(GF(11), [7, 2])(0).xy())
showr(86, lambda: [EllipticCurve(GF(10009), [0, b]).order() for b in range(1, 13)])
showr(87, lambda: [EllipticCurve(GF(10009), [a, 0]).order() for a in range(1, 13)])
showr(88, lambda: [EllipticCurve(GF(10007), [0, b]).order() for b in range(1, 5)])
showr(89, lambda: [EllipticCurve(GF(10007), [a, 0]).order() for a in range(1, 5)])
showr(90, lambda: [EllipticCurve(GF(1000033), [a, 0]).order() for a in range(1, 9)])
showr(91, lambda: [EllipticCurve(GF(1000033), [0, b]).order() for b in range(1, 9)])
showr(92, lambda: EllipticCurve(GF(2^61 - 1), [5, 7]).order())
showr(93, lambda: EllipticCurve(GF(2^61 - 1), [0, 7]).order())
showr(94, lambda: EllipticCurve(GF(2^61 - 1), [7, 0]).order())
showr(95, lambda: EllipticCurve(GF(1009), [1, 2, 3, 4, 5]).order())
showr(96, lambda: EllipticCurve(GF(1009), [1, 2, 3, 4, 5]))
showr(97, lambda: EllipticCurve(GF(1009), [1, 2, 3, 4, 5]).lift_x(3, all=True))
showr(98, lambda: (lambda E: (E(3, 0) if E.is_x_coord(3) else None))(EllipticCurve(GF(1009), [1, 2, 3, 4, 5])))
showr(99, lambda: EllipticCurve(GF(1009), [1, 2, 3, 4, 5]).points()[:6])
showr(100, lambda: (lambda E: [P.order() for P in E.points()[:8]])(EllipticCurve(GF(1009), [1, 2, 3, 4, 5])))
showr(101, lambda: EllipticCurve(GF(1009), [1, 2, 3, 4, 5]).j_invariant())
showr(102, lambda: EllipticCurve(GF(1009), [1, 2, 3, 4, 5]).discriminant())
showr(103, lambda: EllipticCurve(GF(3), [1, 1, 0, 1, 1]).points())
showr(104, lambda: EllipticCurve(GF(2), [1, 0, 1, 1, 1]).points())
showr(105, lambda: EllipticCurve(GF(2), [1, 0, 1, 1, 1]).order())
showr(109, lambda: (lambda E: E(8, 3) + E(8, 8))(EllipticCurve(GF(11), [7, 2])))
showr(110, lambda: (lambda E: 2 * E(2, 0) if E.is_x_coord(2) else 'no')(EllipticCurve(GF(7), [3, 0])))
showr(111, lambda: EllipticCurve(GF(7), [3, 0])(2, 0).order())
showr(113, lambda: str(EllipticCurve(GF(11), [7, 2])(8, 3)))
showr(114, lambda: EllipticCurve(GF(11), [7, 2])(8, 3) * 3)
showr(115, lambda: EllipticCurve(GF(11), [7, 2])(8, 3) * Mod(3, 11))
showr(116, lambda: (-1) * EllipticCurve(GF(11), [7, 2])(8, 3))
showr(117, lambda: EllipticCurve(GF(11), [7, 2]).is_x_coord(1))
showr(118, lambda: EllipticCurve(GF(11), [7, 2]).is_on_curve(8, 3))
showr(119, lambda: EllipticCurve(GF(11), [7, 2]).a_invariants())
showr(120, lambda: (EllipticCurve(GF(11), [7, 2]).a1(), EllipticCurve(GF(11), [7, 2]).a2(), EllipticCurve(GF(11), [7, 2]).a3()))
