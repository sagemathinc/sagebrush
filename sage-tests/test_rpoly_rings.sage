# Polynomial rings over inexact fields (RR, RDF, CC, CDF, RealField(100), ComplexField(100)):
# the ring, printing, conversions, arithmetic, evaluation and calculus, as Sage 10.9 (1b stage 1).
# Left out, with their reasons: negative powers (the fraction field, 1b stage 2); RDF, CDF and
# RealField(100) coefficients in SR (they print as RR there until 1d-i and 1d-ii); the hash of
# t + 1.5 against QQ's t + 3/2 (equal for sagebrush, which keeps equal objects' hashes equal,
# different in Sage); error messages that name Sage's classes.
def show(label, f):
    try:
        v = f()
        if isinstance(v, (bool, list, tuple, dict)) or v is None:
            print(label, '|', v)
        else:
            print(label, '|', str(v).replace('\n', ' ; '), '|', v.parent())
    except Exception as e:
        print(label, '| ERR', type(e).__name__)
R100 = RealField(100); C100 = ComplexField(100)
for bn, B in [('RR', RR), ('RDF', RDF), ('CC', CC), ('CDF', CDF), ('R100', R100), ('C100', C100)]:
    P = PolynomialRing(B, 't'); t = P.gen()
    cplx = bn in ('CC', 'CDF', 'C100')
    print(bn, 'ring |', P, '|', latex(P), '|', P is B['t'], P is PolynomialRing(B, 't'), P.base_ring(), P.is_field(), P.is_exact(), P.characteristic())
    show(bn + ' gen', lambda: t)
    show(bn + ' f', lambda: 1.5*t^2 - 2*t + 1)
    print(bn, 'f latex |', latex(1.5*t^2 - 2*t + 1))
    show(bn + ' (t-1)(t+1)', lambda: (t - 1.0)*(t + 1.0))
    show(bn + ' (t-1)(t+1) list', lambda: ((t - 1.0)*(t + 1.0)).list())
    show(bn + ' zero lead', lambda: P([1, 2, 0.0]))
    print(bn, 'degrees |', P([1, 2, 0.0]).degree(), P(0).degree(), P(0.0).degree(), (t - t).degree(), (t^100).degree(), P([1, 2, 0.0]).list())
    show(bn + ' P(-0.0)', lambda: P(-0.0))
    show(bn + ' t - t', lambda: t - t)
    show(bn + ' 1/3*t', lambda: 1/3*t)
    show(bn + ' t/3', lambda: t/3)
    show(bn + ' (t+1/3)^3', lambda: (t + 1/3)^3)
    show(bn + ' f(2)', lambda: (1.5*t^2 - 2*t + 1)(2))
    show(bn + ' f(1/3)', lambda: (1.5*t^2 - 2*t + 1)(1/3))
    if bn in ('RR', 'CC'):
        show(bn + ' f(x)', lambda: (1.5*t^2 - 2*t + 1)(SR.var('x')))
        show(bn + ' t + x', lambda: t + SR.var('x'))
        show(bn + ' t*sqrt2', lambda: t*sqrt(2))
    show(bn + ' f(t+1)', lambda: (1.5*t^2 - 2*t + 1)(t + 1))
    show(bn + ' deriv', lambda: (1.5*t^3 - 2*t + 1).derivative())
    show(bn + ' diff', lambda: (1.5*t^3 - 2*t + 1).diff(t))
    show(bn + ' change_ring QQ', lambda: (1.5*t^2 + 1).change_ring(QQ))
    show(bn + ' change_ring RDF', lambda: (1.5*t^2 + 1/3).change_ring(RDF))
    show(bn + ' change_ring CC', lambda: (1.5*t^2 + 1/3).change_ring(CC))
    show(bn + ' P(list)', lambda: P([1, 1/3, 2]))
    show(bn + ' P(SR)', lambda: P(SR.var('t')^2 + 1/3))
    show(bn + ' P(QQt)', lambda: P(QQ['t']([1, 1/3])))
    show(bn + ' P(str)', lambda: P('t^2 + 1'))
    print(bn, 'eq |', (t + 1) == (t + 1.0), (t + 1) == QQ['t'].gen() + 1, P(2) == 2, t == 1, P(1/3) == 1/3, t^2 != t)
    print(bn, 'hash |', hash(P(2)) == hash(2), hash(t) == hash(QQ['t'].gen()))
    show(bn + ' ZZt + t', lambda: ZZ['t'].gen() + t)
    show(bn + ' t + QQt', lambda: t + QQ['t'].gen()/3)
    show(bn + ' QQt * t', lambda: (QQ['t'].gen()/3) * t)
    show(bn + ' t + ZZx', lambda: t + ZZ['x'].gen())
    show(bn + ' t^0', lambda: t^0)
    print(bn, 'coefficients |', (1.5*t^3 + 1).coefficients(), (1.5*t^3 + 1).list(), (1.5*t^3 + 2*t + 1)[1], (1.5*t^3 + 1).leading_coefficient(), (1.5*t^3 + 1).dict(), (1.5*t^3 + 1).exponents())
    show(bn + ' small', lambda: t + 1e-20)
    show(bn + ' big', lambda: 1e20*t^2 + 1)
    show(bn + ' neg lead', lambda: -t^2 - 1)
    if cplx:
        show(bn + ' I coeff', lambda: P([0, CC(0, 1)]))
        show(bn + ' cplx', lambda: P([CC(1, 2), CC(0, -1), CC(3, 0)]))
    print(bn, 'zero |', P(0.0).is_zero(), bool(t - t), bool(t), (t^2).is_monic(), P(3).is_constant(), t.is_constant(), (t^2 + 1).constant_coefficient(), (t^2).variables())
    show(bn + ' monic', lambda: (2*t + 1).monic())
    show(bn + ' nan', lambda: P([1, float('nan')]))
    show(bn + ' inf', lambda: P([1, float('inf')]))
    show(bn + ' pow', lambda: (t + 1)^5)
    show(bn + ' pow 1.1', lambda: (1.1*t + 1)^3)
    show(bn + ' call B', lambda: (t^2 + 1)(B(2)))
    show(bn + ' call QQ', lambda: (t^2 + 1)(1/2))
    show(bn + ' call RDF', lambda: (t^2 + 1)(RDF(2)))
    show(bn + ' call I', lambda: (t^2 + 1)(CC(0, 1)))
    show(bn + ' call poly', lambda: (t^2 + 1)(QQ['s'].gen()))
    show(bn + ' call mat', lambda: (t^2 + 1)(matrix(QQ, [[1, 2], [3, 4]])))
    show(bn + ' neg', lambda: -(t^2 - 2*t + 1))
    show(bn + ' subs', lambda: (t^2 + 1).subs(t=3))
    show(bn + ' trunc', lambda: (t^3 + 2*t + 1).truncate(2))
    show(bn + ' shift', lambda: (t^3 + 2*t + 1).shift(1))
    show(bn + ' reverse', lambda: (t^3 + 2*t).reverse())
    show(bn + ' int', lambda: (t^2 + 1).integral())
    print(bn, 'iter |', list(t^2 + 2))
    print(bn, 'latex |', latex(t^3), '|', latex(t^2 - t), '|', latex(P([1, 0, 2])), '|', latex(P(0)), '|', latex(2*t^5 - 3), '|', latex(PolynomialRing(B, 'y_2').gen()^2 + 1/3))
