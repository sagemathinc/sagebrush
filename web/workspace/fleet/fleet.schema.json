    "b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "maxLength": 21868,
      "$comment": "variable-length base64url (ciphertext); canonical form is checked by the decoder."
    },
    "b64_16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "$comment": "16 bytes, canonical base64url (§1.2): 22 characters, the last with zero pad bits."
    },
    "b64_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "$comment": "32 bytes: 43 characters, zero pad bits. Keys and SHA-256 values."
    },
    "b64_64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "$comment": "64 bytes: 86 characters, zero pad bits. Signatures."
    },
