[
  {
    "name": "IsPrime",
    "kind": "function",
    "signature": "(<RngIntElt> n : Proof := true) -> BoolElt",
    "summary": "Whether the integer n is prime; a negative n is prime when -n is.",
    "examples": [
      {
        "code": "IsPrime(97); IsPrime(91); IsPrime(-7);",
        "expected": "true\nfalse\ntrue\n"
      }
    ],
    "differs": [
      "Magma's default (Proof := true) proves primality; Sagebrush's default proves it up to 3.3e24 and uses a BPSW probable-prime test above (pass Proof := true for a proof)."
    ],
    "status": "partial",
    "see_also": [
      "NextPrime",
      "Factorization"
    ],
    "upstream_version": "Magma 2.18",
    "tags": [
      "integers"
    ]
  },
