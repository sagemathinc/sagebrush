# A series over a polynomial base meeting an element of another ring (ZZ['x'], QQ['x'], GF(5)['x'], ZZ['a'],
# QQ['a'] as bases; polynomials in x or a, and numbers, as the other operand). These are the 266 cases of
# a 480-case probe that Sagebrush answers as Sage 10.9 does. The other 214 need Sage's common parent
# (QQ[x] times ZZ[x][[x]] lands in QQ[x][[x]]), which is a later PR, so they are not pinned here.
def show(label, f):
    try:
        v = f()
        try:
            l = v.list()
        except Exception as e:
            l = 'ERR %s' % type(e).__name__
        print(label, '|', v, '|', l, '|', v.parent())
    except Exception as e:
        print(label, '| ERR', type(e).__name__)
OTHERS = {'QQ[x].gen': lambda: QQ['x'].gen(), 'ZZ[x].gen': lambda: ZZ['x'].gen(), 'GF5[x].gen': lambda: GF(5)['x'].gen(), 'QQ[a].gen': lambda: QQ['a'].gen(), 'ZZ[a].gen': lambda: ZZ['a'].gen(), '1/2': lambda: QQ(1/2), '2': lambda: ZZ(2), 'GF5(2)': lambda: GF(5)(2)}
