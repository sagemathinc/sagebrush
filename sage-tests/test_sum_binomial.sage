n, k, x, y = var('n k x y')
s = sum(binomial(n, k)*x^k*y^(n-k), k, 0, n)
print(s)
print(s.subs(n=2, x=1, y=0))
print(s.subs(n=3, x=0, y=0))
print(sum(binomial(n, k)*x^k, k, 0, n))
print(sum(binomial(n, k)*3^k, k, 0, n))
print(sum(binomial(n, k)*x^k/y^k, k, 0, n))
t = sum(binomial(n, k)*2*x^(2*k)*y^(n-k), k, 0, n)
print(t)
print(t.subs(n=2, x=1, y=0))
print(sum(binomial(n, k)*x^(n-k), k, 0, n).subs(n=2, x=0))
print(sum(binomial(n, k), k, 0, n))
print(sum(binomial(n, k)*x^k*(y+1)^(n-k), k, 0, n))
