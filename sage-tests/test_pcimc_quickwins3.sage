# pcimc quick wins 3 (Sage 10.9): an integer to the power of an element of Z/nZ, and vector(ZZ, ...) of
# elements of Z/nZ (the book's 12-Factorization cells 51-53); one line per statement:
# S<nn> <value> or S<nn> ERR <type>: <msg>
def show(n, f):
    try:
        print('S%02d %s' % (n, str(f()).replace('\n', ' ; ')))
    except Exception as e:
        print('S%02d ERR %s: %s' % (n, type(e).__name__, str(e)[:160]))
show(1, lambda: 3^GF(2)(1))
show(2, lambda: 3^GF(2)(0))
show(3, lambda: parent(3^GF(2)(1)))
show(4, lambda: int(3)^GF(2)(1))
show(5, lambda: type(int(3)^GF(2)(1)) == type(3))
show(6, lambda: 2^Mod(3, 7))
show(7, lambda: parent(2^Mod(3, 7)))
show(8, lambda: 2^GF(5)(3))
show(9, lambda: (1/2)^GF(3)(2))
show(10, lambda: Mod(3, 7)^Mod(2, 5))
show(11, lambda: 2.0^GF(5)(3))
show(13, lambda: vector(ZZ, [GF(2)(1), GF(2)(0), GF(2)(1)]))
show(14, lambda: parent(vector(ZZ, [GF(2)(1), GF(2)(0)])))
show(15, lambda: vector(QQ, [GF(5)(3), GF(5)(4)]))
show(16, lambda: vector(ZZ, [Mod(5, 7), Mod(6, 7)]))
show(17, lambda: 1/2 * vector(ZZ, [GF(2)(1), GF(2)(1)]))
list_c = [2 * 3 * 5, 3 * 5^2 * 7, 2 * 7, 3 * 11^2, 3^3 * 5 * 7^2]
list_p = list(primes(12))
coef_matrix = matrix(ZZ, [[valuation(c, p) for c in list_c] for p in list_p])
K = matrix(GF(2), coef_matrix).right_kernel()
show(18, lambda: K)
v = K[1]
show(19, lambda: v)
show(20, lambda: prod(c^x for (c, x) in zip(list_c, v)))
show(21, lambda: sqrt(prod(c^x for (c, x) in zip(list_c, v))))
show(22, lambda: coef_matrix * vector(ZZ, list(v)))
show(23, lambda: 1/2 * coef_matrix * vector(ZZ, list(v)))
show(24, lambda: parent(1/2 * coef_matrix * vector(ZZ, list(v))))
show(25, lambda: prod(p^x for (p, x) in zip(list_p, 1/2 * coef_matrix * vector(ZZ, list(v)))))
show(26, lambda: [c^x for (c, x) in zip([int(2), int(3)], [GF(2)(1), GF(2)(1)])])
show(27, lambda: 0^GF(2)(0))
show(28, lambda: 2^Mod(-1, 7))
show(29, lambda: Integer(10)^Mod(2, 4))
show(31, lambda: matrix(ZZ, [[1, 2], [3, 4]]) * vector(GF(2), [1, 1]))
show(32, lambda: parent(matrix(ZZ, [[1, 2], [3, 4]]) * vector(GF(2), [1, 1])))
show(33, lambda: 1/2 * vector(GF(5), [1, 2]))
show(34, lambda: 1/2 * vector(GF(2), [1, 1]))
show(35, lambda: matrix(QQ, [[1/2, 1]]) * vector(GF(5), [1, 2]))
show(36, lambda: vector(GF(7), [1, 2]) * matrix(ZZ, [[1, 0], [0, 3]]))
