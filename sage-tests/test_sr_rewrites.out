== collect
collect(a*x^2 + b*x + x^2 + x + 1, x) = ['(a + 1)*x^2', '(b + 1)*x', '1']
collect(a*x + b*x + y, x) = ['(a + b)*x', 'y']
collect(x*y + x*z + y, x) = ['x*(y + z)', 'y']
collect((a + x)^2, x) = ['2*a*x', 'a^2', 'x^2']
collect(a^2*b + a^2*x + 2*a*b*x + 2*a*x^2 + b*x^2 + x^3, x) = ['(2*a + b)*x^2', '(a^2 + 2*a*b)*x', 'a^2*b', 'x^3']
collect(x^2*y + x*y^2 + x*y, y) = ['(x^2 + x)*y', 'x*y^2']
collect(a*x^2 + x^2 + 3, x) = ['(a + 1)*x^2', '3']
collect(a*sin(x) + b*sin(x), sin(x)) = ['a + b', 'sin(x)']
== sage_eval
sage_eval('2^10') = 1024
sage_eval('x^2+1', locals={'x':3}) = 10
sage_eval('1/3 + 1/6') = 1/2
sage_eval('[1..5]') = [1, 2, 3, 4, 5]
sage_eval('sqrt(8)') = ['2', 'sqrt(2)']
sage_eval('t^2', locals={'t': x+1}) = (x + 1)^2
sage_eval('a', locals={'a': 2}) = 2
sage_eval('1.5^2') = 2.25000000000000
parent = Rational Field
sage_eval(cmds) = 9
