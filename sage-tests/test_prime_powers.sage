# Sage's prime_powers(start, stop): the prime powers p^k (k >= 1) in [start, stop), or below start with one
# argument; 1 is not one; both bounds converted as integers (ZZ's errors). (Not pinned: narrow
# windows near 2^64, where Sage 10.10 runs for minutes; the entries' type
# name, Sage's Integer being Python's int here throughout; the runtime's arity message.)
def show(label, f):
    try:
        r = f(); print(label, "->", repr(r)[:200], type(r).__name__)
    except Exception as e:
        print(label, "->", "%s: %s" % (type(e).__name__, e))
show("prime_powers(10)", lambda: prime_powers(10))
show("prime_powers(1)", lambda: prime_powers(1))
show("prime_powers(2)", lambda: prime_powers(2))
show("prime_powers(0)", lambda: prime_powers(0))
show("prime_powers(-5)", lambda: prime_powers(-5))
show("prime_powers(2,10)", lambda: prime_powers(2, 10))
show("prime_powers(1,10)", lambda: prime_powers(1, 10))
show("prime_powers(0,10)", lambda: prime_powers(0, 10))
show("prime_powers(-10,10)", lambda: prime_powers(-10, 10))
show("prime_powers(8,30)", lambda: prime_powers(8, 30))
show("prime_powers(30,8)", lambda: prime_powers(30, 8))
show("prime_powers(10,10)", lambda: prime_powers(10, 10))
show("prime_powers(9.5)", lambda: prime_powers(9.5))
show("prime_powers(10.0)", lambda: prime_powers(10.0))
show("prime_powers(QQ(10))", lambda: prime_powers(QQ(10)))
show("prime_powers(1/2)", lambda: prime_powers(1/2))
show("prime_powers('a')", lambda: prime_powers('a'))
show("prime_powers(None)", lambda: prime_powers(None))
show("len(prime_powers(10^6))", lambda: len(prime_powers(10^6)))
show("prime_powers(100)[-5:]", lambda: prime_powers(100)[-5:])
show("prime_powers(start=2, stop=10)", lambda: prime_powers(start=2, stop=10))
show("prime_powers(stop=10)", lambda: prime_powers(stop=10))
show("prime_powers(int(10))", lambda: prime_powers(int(10)))
show("sum(prime_powers(1000))", lambda: [sum(prime_powers(1000))])
show("prime_powers(3)", lambda: prime_powers(3))
show("prime_powers(None, 10)", lambda: prime_powers(None, 10))
show("prime_powers(5, None)", lambda: prime_powers(5, None))
show("prime_powers(1024, 1025)", lambda: prime_powers(1024, 1025))
show("prime_powers(RR(10))", lambda: prime_powers(RR(10)))
show("prime_powers(ZZ(10), 20.0)", lambda: prime_powers(ZZ(10), 20.0))
show("prime_powers(10, 'b')", lambda: prime_powers(10, 'b'))
show("prime_powers(True)", lambda: prime_powers(True))
show("prime_powers(GF(7)(5))", lambda: prime_powers(GF(7)(5)))
