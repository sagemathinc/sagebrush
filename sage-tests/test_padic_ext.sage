t('R(5)', lambda: R(5))
t('2*x', lambda: 2*x)
t('x/19', lambda: x/19)
t('x - x', lambda: x - x)
t('K(1,2)*x + 3', lambda: K(1, 2)*x + 3)
t('x^2 + K(19, 3)', lambda: x^2 + K(19, 3))
t('-x', lambda: -x)
t('x*19', lambda: x*19)
t('x^3 + 1/19', lambda: x^3 + 1/19)
t('(x^2+19).is_eisenstein()', lambda: (x^2 + 19).is_eisenstein())
t('PolynomialRing(K, "y")', lambda: PolynomialRing(K, 'y'))
t('Zp(19,5)["z"]', lambda: Zp(19, 5)['z'])
Z = Zp(19, 5)
S.<z> = Z[]
t('z^2 + 19', lambda: z^2 + 19)
t('S', lambda: S)
t('latex(x^2+19)', lambda: latex(x^2 + 19))
t('parent(x^2+19)', lambda: parent(x^2 + 19))
t('(x+1)*(x-1)', lambda: (x + 1)*(x - 1))
t('R.gen()', lambda: R.gen())
t('(x^2+19).leading_coefficient()', lambda: (x^2 + 19).leading_coefficient())
t('(x^2+19).coefficients()', lambda: (x^2 + 19).coefficients())
t('(x^2+19)[0]', lambda: (x^2 + 19)[0])
t('K.extension(ZZ["w"]("w^2+19"), names="c")', lambda: K.extension(ZZ['w']('w^2+19'), names='c'))
t('K.extension(QQ["w"]("w^2+19"), names="c")', lambda: K.extension(QQ['w']('w^2+19'), names='c'))
# random arithmetic in eleven extensions, as rings and fields
K = Qp(3, 4)
R.<x> = K[]
L.<a> = K.extension(x^2 - 3*x + 3)
t('0 Qp L', lambda: L)
t('0 Qp (L(-15) + L(1)*a) + L(25)', lambda: (L(-15) + L(1)*a) + L(25))
t('0 Qp L(K(-15, 4))^-3', lambda: L(K(-15, 4))^-3)
t('0 Qp (L(16) + L(27)*a).add_bigoh(4) - L(K(-16, 3))', lambda: (L(16) + L(27)*a).add_bigoh(4) - L(K(-16, 3)))
t('0 Qp (L(16) + -12*a)*a^-1 + L(K(-2, 1))', lambda: (L(16) + -12*a)*a^-1 + L(K(-2, 1)))
t('0 Qp (24*a + K(25, 5)).trace()', lambda: (24*a + K(25, 5)).trace())
t('0 Qp (L(-20).valuation(), L(-20).precision_absolute(), L(-20).precision_relative())', lambda: (L(-20).valuation(), L(-20).precision_absolute(), L(-20).precision_relative()))
t('0 Qp (L(3) + L(-26)*a).norm()', lambda: (L(3) + L(-26)*a).norm())
t('0 Qp (L(18) + L(25)*a).norm()', lambda: (L(18) + L(25)*a).norm())
t('0 Qp L(K(-5, 4))^1', lambda: L(K(-5, 4))^1)
