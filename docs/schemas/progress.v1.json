  {
   "properties": {
    "call_id": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^[0-9]+$",
       "type": "string"
      }
     ]
    },
    "elapsed_s": {
     "minimum": 0,
     "type": "number"
    },
    "op": {
     "type": "string"
    },
    "parent_id": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^[0-9]+$",
       "type": "string"
      }
     ]
    },
    "reason": {
     "type": "string"
    },
    "schema": {
     "const": "sagebrush.progress/1"
    },
    "status": {
     "const": "untracked"
