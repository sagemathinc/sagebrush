{
 "cases": [
  {
   "name": "redefinition",
   "cells": [
    "x = 1;",
    "fprintf('%d\\n', x^2)",
    "x = 17;",
    "fprintf('%d\\n', x^3)"
   ],
   "out": "1\n4913\n"
  },
  {
   "name": "reads its own earlier value",
   "cells": [
    "x = 1;",
    "x = x + 1;",
    "fprintf('%d\\n', x)"
   ],
   "out": "2\n"
  },
  {
   "name": "three definitions",
   "cells": [
    "x = 1;",
    "x = x * 10;",
    "x = x + 5;",
    "fprintf('%d\\n', x)"
   ],
   "out": "15\n"
  },
  {
   "name": "read before the definition, in the cell",
   "cells": [
    "x = 5;",
    "fprintf('%d\\n', x); x = 7;",
    "fprintf('%d\\n', x)"
   ],
   "out": "5\n7\n"
  },
  {
   "name": "an indexed assignment",
   "cells": [
    "v = [1 2 3];",
    "v(2) = 20;",
    "fprintf('%d ', v); fprintf('\\n')"
   ],
   "out": "1 20 3 \n"
  },
  {
   "name": "a field assignment",
   "cells": [
    "s.a = 1;",
    "s.b = 2;",
    "fprintf('%d %d\\n', s.a, s.b)"
   ],
   "out": "1 2\n"
  },
  {
   "name": "a loop variable",
   "cells": [
    "i = 10;",
    "for i = 1:3\nend",
    "fprintf('%d\\n', i)"
   ],
   "out": "3\n"
  },
  {
   "name": "a while loop",
   "cells": [
    "n = 0;",
    "while n < 3\n  n = n + 1;\nend",
    "fprintf('%d\\n', n)"
   ],
   "out": "3\n"
  },
  {
   "name": "a branch taken",
   "cells": [
    "x = 1;",
    "if true\n  x = 2;\nend",
    "fprintf('%d\\n', x)"
   ],
   "out": "2\n"
  },
  {
   "name": "a branch not taken",
   "cells": [
    "x = 1;",
    "if false\n  x = 2;\nend",
    "fprintf('%d\\n', x)"
   ],
   "out": "1\n"
  },
  {
   "name": "an anonymous function's capture",
   "cells": [
    "x = 2;",
    "f = @(t) t * x;",
    "x = 3;",
    "fprintf('%d %d\\n', f(10), x)"
   ],
   "out": "20 3\n"
  },
  {
   "name": "a function's parameter of the same name",
   "cells": [
    "function y = sq(x)\n  y = x^2;\nend",
    "x = 4;",
    "x = sq(x);",
    "fprintf('%d\\n', x)"
   ],
   "out": "16\n"
  },
  {
   "name": "catch's variable",
   "cells": [
    "e = 1;",
    "try\n  error('boom');\ncatch e\nend",
    "fprintf('%s\\n', e.message)"
   ],
   "out": "boom\n"
  },
  {
   "name": "two names",
   "cells": [
    "a = 1; b = 2;",
    "a = a + b; b = a * 10;",
    "fprintf('%d %d\\n', a, b)"
   ],
   "out": "3 30\n"
  }
 ]
