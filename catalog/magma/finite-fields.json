    "kind": "function",
    "signature": "(<RngIntElt> q) -> FldFin",
    "summary": "The finite field with q elements, for a prime power q; F<a> := GF(q) names its generator a.",
    "examples": [
      {
        "code": "F<a> := GF(16); F; a^4;",
        "expected": "Finite field of size 2^4\na^4\n"
      }
    ],
