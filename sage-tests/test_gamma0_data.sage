# Gamma0(N) group data (Sage mode), as Sage gives them.
G = Gamma0(11)
H = Gamma0(36)
K = Gamma0(13)
O = Gamma0(1)
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('G.index()', lambda: G.index())
show('H.index()', lambda: H.index())
show('O.index()', lambda: O.index())
show('G.ncusps()', lambda: G.ncusps())
show('H.ncusps()', lambda: H.ncusps())
show('O.ncusps()', lambda: O.ncusps())
show('K.nu2()', lambda: K.nu2())
show('K.nu3()', lambda: K.nu3())
show('G.nu2()', lambda: G.nu2())
show('G.nu3()', lambda: G.nu3())
show('O.nu2()', lambda: O.nu2())
show('O.nu3()', lambda: O.nu3())
show('Gamma0(4).nu2()', lambda: Gamma0(4).nu2())
show('Gamma0(9).nu3()', lambda: Gamma0(9).nu3())
show('G.genus()', lambda: G.genus())
show('H.genus()', lambda: H.genus())
show('O.genus()', lambda: O.genus())
show('Gamma0(389).genus()', lambda: Gamma0(389).genus())
show('[Gamma0(N).genus() for N in range(1, 40)]', lambda: [Gamma0(N).genus() for N in range(1, 40)])
show('G.cusps()', lambda: G.cusps())
show('H.cusps()', lambda: H.cusps())
show('O.cusps()', lambda: O.cusps())
show('Gamma0(8).cusps()', lambda: Gamma0(8).cusps())
show('Gamma0(12).cusps()', lambda: Gamma0(12).cusps())
show('Gamma0(25).cusps()', lambda: Gamma0(25).cusps())
show('Gamma0(48).cusps()', lambda: Gamma0(48).cusps())
show('[H.cusp_width(c) for c in H.cusps()]', lambda: [H.cusp_width(c) for c in H.cusps()])
show('[Gamma0(48).cusp_width(c) for c in Gamma0(48).cusps()]', lambda: [Gamma0(48).cusp_width(c) for c in Gamma0(48).cusps()])
show('G.cusp_width(Infinity)', lambda: G.cusp_width(Infinity))
show('G.cusp_width(1/2)', lambda: G.cusp_width(1/2))
show('H.cusp_width(5/7)', lambda: H.cusp_width(5/7))
show('G.is_even()', lambda: G.is_even())
show('O.is_even()', lambda: O.is_even())
show('G.sturm_bound(2)', lambda: G.sturm_bound(2))
show('H.sturm_bound(4)', lambda: H.sturm_bound(4))
show('O.sturm_bound(12)', lambda: O.sturm_bound(12))
show('G.sturm_bound()', lambda: G.sturm_bound())
show('Gamma0(11).sturm_bound(3)', lambda: Gamma0(11).sturm_bound(3))
show('G.level()', lambda: G.level())
show('G.is_congruence()', lambda: G.is_congruence())
show('G.is_odd()', lambda: G.is_odd())
show('H.index() == H.projective_index()', lambda: H.index() == H.projective_index())
show('G.ncusps() == len(G.cusps())', lambda: G.ncusps() == len(G.cusps()))
show('G.cusps()[0].parent()', lambda: G.cusps()[0].parent())
show('Gamma0(65).genus()', lambda: Gamma0(65).genus())
show('Gamma0(91).genus()', lambda: Gamma0(91).genus())
show('(Gamma0(65).nu2(), Gamma0(91).nu3())', lambda: (Gamma0(65).nu2(), Gamma0(91).nu3()))
