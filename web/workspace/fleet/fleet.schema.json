              "$ref": "#/$defs/ms"
            },
            "auth_time_ms": {
              "$ref": "#/$defs/ms"
            },
            "op": {
              "const": "policy"
            },
            "policy": {
              "$ref": "#/$defs/policy"
            }
          }
        }
      ],
      "$comment": "§2.1. Who may sign each op (tiers, recovery key, the predecessor rule) is checked by the verifier, not the schema."
    },
