# Sage's display and errors: Gaussian rationals in QQbar print exactly (I, not 1*I), every matrix pads its entries to one width, and AA, QQbar and number-field values convert to GF(p) as Sage
def T(name, fun):
    try: print(name, '::', fun())
    except Exception as e: print(name, '::', type(e).__name__, str(e)[:90])
x = QQbar(-1).sqrt()
T('I forms', lambda: (x, x + 1, -x, x - 1, 2*x, x/2 + QQ(1)/3, QQbar(-4).sqrt(), QQbar(-4).sqrt() + 1, -QQbar(-4).sqrt() - 1, QQbar(I), QQbar(I) - 3, QQbar(-2).sqrt() + 1, QQbar(-1/4).sqrt()))
T('I matrix', lambda: matrix(QQbar, [[x, x + 1], [2*x, 3]]))
F.<z> = GF(9)
T('GF9 mat', lambda: matrix(F, [[1, z + 1], [z, 2*z + 1]]))
T('GF9 mat2', lambda: matrix(F, [[1, z + 1, 0], [z, 1, 2*z + 1]]))
T('GF11 mat', lambda: matrix(GF(11), [[1, 10], [10, 1], [5, 3]]))
T('ZZ mat', lambda: matrix(ZZ, [[1, 100], [20, 3]]))
T('QQ mat', lambda: matrix(QQ, [[1, 1/100], [20, 3]]))
P.<t> = QQ[]; K.<a> = NumberField(t^2 - 2)
T('K mat', lambda: matrix(K, [[1, a + 1], [2*a, 3]]))
T('AA mat', lambda: matrix(AA, [[1, AA(2).sqrt()], [20, 3]]))
T('GF7 AA', lambda: GF(7)(AA(2).sqrt()))
T('GF7 AA rational', lambda: GF(7)(AA(3)))
T('GF7 QQbar', lambda: GF(7)(QQbar(I)))
T('GF7 K', lambda: GF(7)(a))
T('GF7 K rational', lambda: GF(7)(K(3)))
T('Zmod6 AA', lambda: Zmod(6)(AA(2).sqrt()))
T('GF101 mat', lambda: matrix(GF(101), [[1, 100], [2, 3]]))
T('Zmod1000 mat', lambda: matrix(Zmod(1000), [[1, 999, 5], [2, 3, 4]]))
F.<w> = GF(2^4)
T('GF16 mat', lambda: matrix(F, [[1, w^3 + w + 1], [w, 1]]))
T('RDF mat', lambda: matrix(RDF, [[1, 2.5], [100, 3]]))
