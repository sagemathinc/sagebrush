# GF(p) matrix builders (Sage mode), as Sage gives them.
F = GF(101)
A = matrix(F, [[1, 2, 3], [4, 5, 6], [7, 8, 10]])
B = matrix(F, [[2, 1, 0], [0, 2, 0], [0, 0, 3]])
N = matrix(F, [[0, 1, 0], [0, 0, 1], [0, 0, 0]])
S = matrix(F, [[1, 2], [2, 1]])
E = matrix(F, 0, 0)
R = matrix(F, [[1, 2, 3], [4, 5, 6]])
G9.<a> = GF(9)
M9 = matrix(G9, [[a, 1], [0, a + 1]])
T2 = matrix(GF(2), [[1, 1, 0], [0, 1, 1]])
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('A.delete_rows([1])', lambda: A.delete_rows([1]))
show('A.delete_columns([0, 2])', lambda: A.delete_columns([0, 2]))
show('A.delete_rows([0, 1, 2])', lambda: A.delete_rows([0, 1, 2]))
show('A.delete_rows([2, 0])', lambda: A.delete_rows([2, 0]))
show('A.delete_rows([5])', lambda: A.delete_rows([5]))
show('A.matrix_from_rows([2, 0])', lambda: A.matrix_from_rows([2, 0]))
show('A.matrix_from_rows([1, 1])', lambda: A.matrix_from_rows([1, 1]))
show('A.matrix_from_columns([1])', lambda: A.matrix_from_columns([1]))
show('A.matrix_from_columns([])', lambda: A.matrix_from_columns([]))
show('A.matrix_from_rows_and_columns([0, 2], [1, 2])', lambda: A.matrix_from_rows_and_columns([0, 2], [1, 2]))
show('A.matrix_from_rows_and_columns([2, 2], [0])', lambda: A.matrix_from_rows_and_columns([2, 2], [0]))
show('A.antitranspose()', lambda: A.antitranspose())
show('R.antitranspose()', lambda: R.antitranspose())
show('E.antitranspose()', lambda: E.antitranspose())
show('A.elementwise_product(B)', lambda: A.elementwise_product(B))
show('A.elementwise_product(R)', lambda: A.elementwise_product(R))
show('R.elementwise_product(R)', lambda: R.elementwise_product(R))
show('S.block_sum(matrix(F, [[7]]))', lambda: S.block_sum(matrix(F, [[7]])))
show('R.block_sum(S)', lambda: R.block_sum(S))
show('E.block_sum(S)', lambda: E.block_sum(S))
show('S.tensor_product(matrix(F, [[1, 1]]))', lambda: S.tensor_product(matrix(F, [[1, 1]])))
show('S.tensor_product(S)', lambda: S.tensor_product(S))
show('R.tensor_product(matrix(F, [[2], [3]]))', lambda: R.tensor_product(matrix(F, [[2], [3]])))
show('S.tensor_product(matrix(F, [[1, 1]]), subdivide=False)', lambda: S.tensor_product(matrix(F, [[1, 1]]), subdivide=False))
show('M9.antitranspose()', lambda: M9.antitranspose())
show('M9.tensor_product(M9)', lambda: M9.tensor_product(M9))
show('T2.elementwise_product(T2)', lambda: T2.elementwise_product(T2))
show('(lambda M: (M.subdivide([1], [1]), M)[1])(copy(S))', lambda: (lambda M: (M.subdivide([1], [1]), M)[1])(copy(S)))
show('(lambda M: (M.subdivide([1], [2]), copy(M).subdivisions(), M.transpose().subdivisions(), (M + M).subdivisions(), M.subdivisions())[1:])(copy(R))', lambda: (lambda M: (M.subdivide([1], [2]), copy(M).subdivisions(), M.transpose().subdivisions(), (M + M).subdivisions(), M.subdivisions())[1:])(copy(R)))
show('S.tensor_product(S).transpose()', lambda: S.tensor_product(S).transpose())
show('R.tensor_product(S).subdivisions()', lambda: R.tensor_product(S).subdivisions())

# subdivision lines at the edges and repeated, and mirrored by antitranspose
A7 = matrix(GF(7), 3, 3, range(9))
for rs, cs in [([3], []), ([0], []), ([1, 1], []), ([], [3]), ([], [0]), ([], [1, 1]), ([0, 3], []), ([3, 3], []), ([1, 1, 1], [2, 2])]:
    B7 = copy(A7); B7.subdivide(rs, cs)
    print(rs, cs); print(B7)
    print("anti:"); print(B7.antitranspose())
