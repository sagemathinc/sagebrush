  {
    "name": "mod",
    "kind": "function",
    "signature": "b = mod(a, m)",
    "summary": "The remainder after division, with the sign of the divisor: a - m*floor(a/m).",
    "doc": "`mod(a, 0)` is a. Integer classes and doubles mix as in arithmetic.",
    "examples": [
      {
        "code": "mod([7 -7], 3)",
        "expected": "\nans =\n\n     1     2\n\n"
      },
      {
        "code": "mod(7, -3)",
        "expected": "\nans =\n\n    -2\n\n"
      }
    ],
    "differs": [
      "Complex arguments give an unclear error rather than MATLAB's message."
    ],
    "status": "full",
    "see_also": [
      "rem",
      "floor"
    ],
    "tags": [
      "elementary math"
    ]
  },
