# QQ (and Rational) of decimal literals of up to 15 significant digits,
# not yet used in arithmetic: from the interval around the decimal value
# rounded to 54 bits; and of their doubles, as floats, RDF and RR elements:
# the simplest rational rounding to each (both signs, subnormal, huge,
# beyond the doubles).  (A literal of more than 15 digits has more than 53
# bits in Sage, and is refused here: test/sage-qq-real.test.ts.)
def show(f):
    try:
        return f()
    except Exception as e:
        return type(e).__name__ + ": " + str(e)

print(0, '517.88e-315', show(lambda: QQ(517.88e-315)), show(lambda: Rational(517.88e-315)), show(lambda: QQ(float(517.88e-315))), show(lambda: QQ(RDF(float(517.88e-315)))), show(lambda: QQ(RR(float(517.88e-315)))))
