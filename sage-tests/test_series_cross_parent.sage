for kind, bname, oname, op in C:
    B = sage_eval(bname)
    S = (PowerSeriesRing if kind == 'Power' else LaurentSeriesRing)(B, 'x', default_prec=4)
    t = S.gen()
    o = OTHERS[oname]()
    show('%s %s %s %s' % (kind, bname, oname, op), lambda: sage_eval({'o*t': 'o*t', 't*o': 't*o', 'o+t': 'o + t', 't-o': 't - o', 't/o': 't/o', '(o*t)/o': '(o*t)/o'}[op], locals={'o': o, 't': t}))
