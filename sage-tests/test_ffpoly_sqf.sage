# GF(p) polynomial: squarefree_decomposition, radical, is_square, sqrt (Sage mode), as Sage gives them.
R.<x> = GF(101)[]
f = x^5 + 3*x + 1
F9.<a> = GF(9)
S.<y> = F9[]
T.<z> = GF(2)[]
U.<u> = GF(3)[]
V.<v> = GF(7)[]
G4.<b> = GF(4); W.<w> = G4[]
G25.<c> = GF(25); X.<t> = G25[]
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", "%s: %s" % (type(e).__name__, str(e).split(chr(10))[0]), flush=True)
show('((x + 1)^2 * (x + 2)^3).squarefree_decomposition()', lambda: ((x + 1)^2 * (x + 2)^3).squarefree_decomposition())
show('((x + 1)^2 * (x + 2)^3).radical()', lambda: ((x + 1)^2 * (x + 2)^3).radical())
show('(x^2 + 2*x + 1).is_square()', lambda: (x^2 + 2*x + 1).is_square())
show('(x^2 + 2*x + 1).is_square(root=True)', lambda: (x^2 + 2*x + 1).is_square(root=True))
show('(x^2 + 2*x + 2).is_square()', lambda: (x^2 + 2*x + 2).is_square())
show('(x^2 + 2*x + 1).sqrt()', lambda: (x^2 + 2*x + 1).sqrt())
show('(z^4 + 1).squarefree_decomposition()', lambda: (z^4 + 1).squarefree_decomposition())
show('(z^4 + z^2).radical()', lambda: (z^4 + z^2).radical())
show('(3*x^2).is_square()', lambda: (3*x^2).is_square())
show('R(0).is_square()', lambda: R(0).is_square())
show('(3*x^2 + 3).radical()', lambda: (3*x^2 + 3).radical())
show('(4*x^2).is_square(root=True)', lambda: (4*x^2).is_square(root=True))
show('(4*x^2 + 8*x + 4).is_square(root=True)', lambda: (4*x^2 + 8*x + 4).is_square(root=True))
show('(x^2 + 2*x + 2).is_square(root=True)', lambda: (x^2 + 2*x + 2).is_square(root=True))
show('(3*(x + 1)^2).squarefree_decomposition()', lambda: (3*(x + 1)^2).squarefree_decomposition())
show('(x^2 + x + 1).sqrt()', lambda: (x^2 + x + 1).sqrt())
show('(4*x^2).sqrt()', lambda: (4*x^2).sqrt())
show('R(0).squarefree_decomposition()', lambda: R(0).squarefree_decomposition())
show('R(5).squarefree_decomposition()', lambda: R(5).squarefree_decomposition())
show('R(0).radical()', lambda: R(0).radical())
show('R(5).radical()', lambda: R(5).radical())
show('((y + a)^3 * (y + 1)).squarefree_decomposition()', lambda: ((y + a)^3 * (y + 1)).squarefree_decomposition())
show('((z^2 + z + 1)^2 * z^4).squarefree_decomposition()', lambda: ((z^2 + z + 1)^2 * z^4).squarefree_decomposition())
show('(2*u^4 + u^2).radical()', lambda: (2*u^4 + u^2).radical())
show('(2*u^3 + 2*u).radical()', lambda: (2*u^3 + 2*u).radical())
show('(2*u^3 + 2).radical()', lambda: (2*u^3 + 2).radical())
show('(2*u^5 + u).radical()', lambda: (2*u^5 + u).radical())
show('(2*u^2 + 2).radical()', lambda: (2*u^2 + 2).radical())
show('(2*u^3).radical()', lambda: (2*u^3).radical())
show('(2*u^6 + 2).radical()', lambda: (2*u^6 + 2).radical())
show('U(1).squarefree_decomposition()', lambda: U(1).squarefree_decomposition())
show('R(1).factor()', lambda: R(1).factor())
show('(z^3*(z + 1)^2).squarefree_decomposition()', lambda: (z^3*(z + 1)^2).squarefree_decomposition())
show('((x + 2)^2*(x + 1)^3).squarefree_decomposition()', lambda: ((x + 2)^2*(x + 1)^3).squarefree_decomposition())
show('((x^2 + 1)*(x + 5)^2).squarefree_decomposition()', lambda: ((x^2 + 1)*(x + 5)^2).squarefree_decomposition())
show('((x + 1)^3*(x^2 + 3)^2*(x + 7)).squarefree_decomposition()', lambda: ((x + 1)^3*(x^2 + 3)^2*(x + 7)).squarefree_decomposition())
show('(2*u^9*(u + 1)^3*(u + 2)).squarefree_decomposition()', lambda: (2*u^9*(u + 1)^3*(u + 2)).squarefree_decomposition())
show('((y + a)^6*(y + 1)).squarefree_decomposition()', lambda: ((y + a)^6*(y + 1)).squarefree_decomposition())
show('(3*(u + 1)^3).radical()', lambda: (3*(u + 1)^3).radical())
show('(3*(u + 1)^4).radical()', lambda: (3*(u + 1)^4).radical())
show('(3*(v + 1)^7).radical()', lambda: (3*(v + 1)^7).radical())
show('(3*(v + 1)^8).radical()', lambda: (3*(v + 1)^8).radical())
show('(3*(x + 1)^101).radical()', lambda: (3*(x + 1)^101).radical())
show('(3*(x + 1)^102).radical()', lambda: (3*(x + 1)^102).radical())
show('((b*w + 1)^2).radical()', lambda: ((b*w + 1)^2).radical())
show('((a*y + 1)^2).sqrt()', lambda: ((a*y + 1)^2).sqrt())
show('((a*y + 1)^2).is_square(root=True)', lambda: ((a*y + 1)^2).is_square(root=True))
show('((c*t + 1)^2).sqrt()', lambda: ((c*t + 1)^2).sqrt())
show('((c*t + 1)^2).is_square(root=True)', lambda: ((c*t + 1)^2).is_square(root=True))
show('((a*y^2 + 2*y + a)^2).sqrt()', lambda: ((a*y^2 + 2*y + a)^2).sqrt())
show('[F9(e).sqrt() for e in F9 if e.is_square()]', lambda: [F9(e).sqrt() for e in F9 if e.is_square()])
show('[G25(e).sqrt() for e in G25 if e.is_square()]', lambda: [G25(e).sqrt() for e in G25 if e.is_square()])
show('((u + 1)^7*(u + 2)^3*(u^2 + u + 2)).squarefree_decomposition()', lambda: ((u + 1)^7*(u + 2)^3*(u^2 + u + 2)).squarefree_decomposition())
