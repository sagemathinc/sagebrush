{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The notebook window: open and save the user's files (anywhere, like any document app), set its title, and talk to the engine subprocess. A template: it grants nothing as it stands (no origin); the app adds it at launch for its page's exact origin, http://127.0.0.1:<the port it holds> (src/nav.rs page_capability).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-startup-files",
    "allow-selftest-file",
    "allow-selftest-persist",
    "allow-selftest-report",
    "allow-app-log",
    "allow-engine-start",
    "allow-engine-send",
    "allow-engine-ack",
    "allow-engine-stop",
    "allow-disk-list",
    "allow-disk-stat",
    "allow-disk-read",
    "allow-disk-write",
    "allow-disk-mkdir",
    "allow-disk-rename",
    "allow-disk-remove",
    "allow-disk-where",
    "allow-settings-write",
    "allow-app-quit-hold",
    "allow-app-quit-now",
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "/**"
        }
      ]
    }
  ],
  "local": false,
  "remote": {
    "urls": []
  }
}
