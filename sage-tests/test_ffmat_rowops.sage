# GF(p) matrix row and column operations (Sage mode), as Sage gives them.
F = GF(101)
A = matrix(F, [[1, 2, 3], [4, 5, 6], [7, 8, 10]])
B = matrix(F, [[2, 1, 0], [0, 2, 0], [0, 0, 3]])
N = matrix(F, [[0, 1, 0], [0, 0, 1], [0, 0, 0]])
S = matrix(F, [[1, 2], [2, 1]])
E = matrix(F, 0, 0)
R = matrix(F, [[1, 2, 3], [4, 5, 6]])
G9.<a> = GF(9)
M9 = matrix(G9, [[a, 1], [0, a + 1]])
T2 = matrix(GF(2), [[1, 1, 0], [0, 1, 1]])
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('(lambda M: (M.add_multiple_of_row(0, 1, 3), M)[1])(copy(A))', lambda: (lambda M: (M.add_multiple_of_row(0, 1, 3), M)[1])(copy(A)))
show('(lambda M: (M.add_multiple_of_column(2, 0, -1), M)[1])(copy(A))', lambda: (lambda M: (M.add_multiple_of_column(2, 0, -1), M)[1])(copy(A)))
show('(lambda M: (M.rescale_row(1, 5), M)[1])(copy(A))', lambda: (lambda M: (M.rescale_row(1, 5), M)[1])(copy(A)))
show('(lambda M: (M.rescale_col(0, 2), M)[1])(copy(A))', lambda: (lambda M: (M.rescale_col(0, 2), M)[1])(copy(A)))
show('(lambda M: (M.swap_rows(0, 2), M)[1])(copy(A))', lambda: (lambda M: (M.swap_rows(0, 2), M)[1])(copy(A)))
show('(lambda M: (M.swap_columns(0, 1), M)[1])(copy(A))', lambda: (lambda M: (M.swap_columns(0, 1), M)[1])(copy(A)))
show('(lambda M: M.add_multiple_of_row(0, 1, 3))(copy(A))', lambda: (lambda M: M.add_multiple_of_row(0, 1, 3))(copy(A)))
show('A.add_multiple_of_row(0, 1, 3)', lambda: A.add_multiple_of_row(0, 1, 3))
show('A.with_added_multiple_of_row(0, 2, 7)', lambda: A.with_added_multiple_of_row(0, 2, 7))
show('A.with_added_multiple_of_column(1, 0, 100)', lambda: A.with_added_multiple_of_column(1, 0, 100))
show('A.with_swapped_rows(0, 2)', lambda: A.with_swapped_rows(0, 2))
show('A.with_swapped_columns(0, 2)', lambda: A.with_swapped_columns(0, 2))
show('A.with_rescaled_row(2, 0)', lambda: A.with_rescaled_row(2, 0))
show('A.with_rescaled_col(1, 3)', lambda: A.with_rescaled_col(1, 3))
show('A', lambda: A)
show('R.with_rescaled_col(2, 1/2)', lambda: R.with_rescaled_col(2, 1/2))
show('R.with_swapped_rows(0, 1)', lambda: R.with_swapped_rows(0, 1))
show('(lambda M: (M.add_multiple_of_row(1, 0, a), M)[1])(copy(M9))', lambda: (lambda M: (M.add_multiple_of_row(1, 0, a), M)[1])(copy(M9)))
show('M9.with_rescaled_row(0, a)', lambda: M9.with_rescaled_row(0, a))
show('T2.with_added_multiple_of_row(1, 0, 1)', lambda: T2.with_added_multiple_of_row(1, 0, 1))
show('(lambda M: (M.rescale_row(0, 2, 1), M)[1])(copy(A))', lambda: (lambda M: (M.rescale_row(0, 2, 1), M)[1])(copy(A)))
show('(lambda M: (M.add_multiple_of_row(0, 1, 3, 1), M)[1])(copy(A))', lambda: (lambda M: (M.add_multiple_of_row(0, 1, 3, 1), M)[1])(copy(A)))
show('A.with_swapped_rows(0, 3)', lambda: A.with_swapped_rows(0, 3))
