[
  {
    "name": "abs",
    "kind": "function",
    "signature": "Y = abs(X)",
    "summary": "The absolute value of each element, or the magnitude of a complex one.",
    "doc": "Keeps the input's class. An integer class's minimum saturates to its maximum: `abs(int8(-128))` is 127.",
    "examples": [
      {
        "code": "abs([-3 2 -1.5])",
        "expected": "\nans =\n\n    3.0000    2.0000    1.5000\n\n"
      },
      {
        "code": "abs(-2 + 1i)",
        "expected": "\nans =\n\n    2.2361\n\n"
      },
      {
        "code": "abs(3 + 4i)",
        "expected": "\nans =\n\n     5\n\n"
      }
    ],
    "differs": [
      "abs of int64's minimum is refused: Sagebrush's 64-bit integers are exact only below 2^53."
    ],
    "status": "full",
    "see_also": [
      "sign",
      "angle"
    ],
    "tags": [
      "elementary math"
    ]
  },
