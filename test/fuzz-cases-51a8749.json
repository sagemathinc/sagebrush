[
  {
    "name": "repeated formfeeds control",
    "codes": [
      "x = 1",
      "print(((x:=10) if '\ud83d\ude00'\f\f'' > \"\" else 0, x))",
      "print(x)"
    ],
    "change": [
      0,
      "x = 5"
    ],
    "expect": "run"
  },
  {
    "name": "mixed whitespace around formfeed control",
    "codes": [
      "x = 1",
      "print(((x:=10) if '\\U00010000' \t\f \t'' > \"\" else 0, x))",
      "print(x)"
    ],
    "change": [
      0,
      "x = 5"
    ],
    "expect": "run"
  },
