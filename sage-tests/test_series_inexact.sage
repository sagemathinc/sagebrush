# A series meeting an inexact number (RR, RDF, CC, CDF, RealField(100), ComplexField(100), a float literal), as
# Sage 10.9: an exact base (ZZ, QQ, ZZ['a'] ...) moves to the number's field (QQ[[y]] times RR(1.5) is
# 1.50000000000000 + 1.50000000000000*y + O(y^3) over RR, never 3/2 over QQ), a division by an inexact
# number multiplies by its inverse; and CC's operations leave a series (or any other object) to its own.
# These are the 96 + 88 cases of the sweep (/scratch/sage2-notes/ccbug) that Sagebrush answers as Sage; not
# here: power series over ZZ, whose lifted zeros Sage prints (Bug 3), polynomial rings over RR (refused),
# and CDF's inverse (its last bits).
def show(label, f):
    try:
        v = f()
        print(label, '|', str(v).replace('\n', ' ; '), '|', v.parent())
    except Exception as e:
        print(label, '| ERR', type(e).__name__)
S.<y> = PowerSeriesRing(QQ, default_prec=3)
L.<z> = LaurentSeriesRing(QQ, default_prec=3)
SC = {'CC(1,2)': lambda: CC(1, 2), 'RR(1.5)': lambda: RR(1.5), 'RDF(1.5)': lambda: RDF(1.5), 'CDF(1,2)': lambda: CDF(1, 2),
      'R100(1.5)': lambda: RealField(100)(1.5), 'C100(1,2)': lambda: ComplexField(100)(1, 2), '1.5': lambda: 1.5}
OB = {'y': lambda: 1 + y + O(y^3), 'z': lambda: z^-1 + 1}
OP1 = {'c*o': 'c*o', 'o*c': 'o*c', 'c+o': 'c + o', 'o+c': 'o + c', 'c-o': 'c - o', 'o-c': 'o - c', 'o/c': 'o/c'}
C1 = [('CC(1,2)', 'y', 'c*o'), ('CC(1,2)', 'y', 'o*c'), ('CC(1,2)', 'y', 'c+o'), ('CC(1,2)', 'y', 'o+c'), ('CC(1,2)', 'y', 'c-o'), ('CC(1,2)', 'y', 'o-c'), ('CC(1,2)', 'y', 'o/c'), ('CC(1,2)', 'z', 'c*o'), ('CC(1,2)', 'z', 'o*c'), ('CC(1,2)', 'z', 'c+o'), ('CC(1,2)', 'z', 'o+c'), ('CC(1,2)', 'z', 'c-o'), ('CC(1,2)', 'z', 'o-c'), ('CC(1,2)', 'z', 'o/c'), ('RR(1.5)', 'y', 'c*o'), ('RR(1.5)', 'y', 'o*c'), ('RR(1.5)', 'y', 'c+o'), ('RR(1.5)', 'y', 'o+c'), ('RR(1.5)', 'y', 'c-o'), ('RR(1.5)', 'y', 'o-c'), ('RR(1.5)', 'y', 'o/c'), ('RR(1.5)', 'z', 'c*o'), ('RR(1.5)', 'z', 'o*c'), ('RR(1.5)', 'z', 'c+o'), ('RR(1.5)', 'z', 'o+c'), ('RR(1.5)', 'z', 'c-o'), ('RR(1.5)', 'z', 'o-c'), ('RR(1.5)', 'z', 'o/c'), ('RDF(1.5)', 'y', 'c*o'), ('RDF(1.5)', 'y', 'o*c'), ('RDF(1.5)', 'y', 'c+o'), ('RDF(1.5)', 'y', 'o+c'), ('RDF(1.5)', 'y', 'c-o'), ('RDF(1.5)', 'y', 'o-c'), ('RDF(1.5)', 'y', 'o/c'), ('RDF(1.5)', 'z', 'c*o'), ('RDF(1.5)', 'z', 'o*c'), ('RDF(1.5)', 'z', 'c+o'), ('RDF(1.5)', 'z', 'o+c'), ('RDF(1.5)', 'z', 'c-o'), ('RDF(1.5)', 'z', 'o-c'), ('RDF(1.5)', 'z', 'o/c'), ('CDF(1,2)', 'y', 'c*o'), ('CDF(1,2)', 'y', 'o*c'), ('CDF(1,2)', 'y', 'c+o'), ('CDF(1,2)', 'y', 'o+c'), ('CDF(1,2)', 'y', 'c-o'), ('CDF(1,2)', 'y', 'o-c'), ('CDF(1,2)', 'z', 'c*o'), ('CDF(1,2)', 'z', 'o*c'), ('CDF(1,2)', 'z', 'c+o'), ('CDF(1,2)', 'z', 'o+c'), ('CDF(1,2)', 'z', 'c-o'), ('CDF(1,2)', 'z', 'o-c'), ('R100(1.5)', 'y', 'c*o'), ('R100(1.5)', 'y', 'o*c'), ('R100(1.5)', 'y', 'c+o'), ('R100(1.5)', 'y', 'o+c'), ('R100(1.5)', 'y', 'c-o'), ('R100(1.5)', 'y', 'o-c'), ('R100(1.5)', 'y', 'o/c'), ('R100(1.5)', 'z', 'c*o'), ('R100(1.5)', 'z', 'o*c'), ('R100(1.5)', 'z', 'c+o'), ('R100(1.5)', 'z', 'o+c'), ('R100(1.5)', 'z', 'c-o'), ('R100(1.5)', 'z', 'o-c'), ('R100(1.5)', 'z', 'o/c'), ('C100(1,2)', 'y', 'c*o'), ('C100(1,2)', 'y', 'o*c'), ('C100(1,2)', 'y', 'c+o'), ('C100(1,2)', 'y', 'o+c'), ('C100(1,2)', 'y', 'c-o'), ('C100(1,2)', 'y', 'o-c'), ('C100(1,2)', 'y', 'o/c'), ('C100(1,2)', 'z', 'c*o'), ('C100(1,2)', 'z', 'o*c'), ('C100(1,2)', 'z', 'c+o'), ('C100(1,2)', 'z', 'o+c'), ('C100(1,2)', 'z', 'c-o'), ('C100(1,2)', 'z', 'o-c'), ('C100(1,2)', 'z', 'o/c'), ('1.5', 'y', 'c*o'), ('1.5', 'y', 'o*c'), ('1.5', 'y', 'c+o'), ('1.5', 'y', 'o+c'), ('1.5', 'y', 'c-o'), ('1.5', 'y', 'o-c'), ('1.5', 'y', 'o/c'), ('1.5', 'z', 'c*o'), ('1.5', 'z', 'o*c'), ('1.5', 'z', 'c+o'), ('1.5', 'z', 'o+c'), ('1.5', 'z', 'c-o'), ('1.5', 'z', 'o-c'), ('1.5', 'z', 'o/c')]
for sn, on, op in C1:
    c, o = SC[sn](), OB[on]()
    show('%s %s %s' % (sn, on, op), lambda: sage_eval(OP1[op], locals={'c': c, 'o': o}))
OP2 = {'c*t': 'c*t', 't*c': 't*c', 'c+t': 'c + t', 't-c': 't - c', '(1+t)/c': '(1 + t)/c'}
C2 = [('Power', 'ZZ', 'CC(1,2)', 'c+t'), ('Power', 'ZZ', 'CC(1,2)', 't-c'), ('Power', 'ZZ', 'CC(1,2)', '(1+t)/c'), ('Power', 'ZZ', 'RR(1.5)', 'c+t'), ('Power', 'ZZ', 'RR(1.5)', 't-c'), ('Power', 'ZZ', 'RR(1.5)', '(1+t)/c'), ('Power', 'ZZ', 'RDF(1.5)', 'c+t'), ('Power', 'ZZ', 'RDF(1.5)', 't-c'), ('Power', 'ZZ', 'RDF(1.5)', '(1+t)/c'), ('Power', 'ZZ', 'R100(1.5)', 'c+t'), ('Power', 'ZZ', 'R100(1.5)', 't-c'), ('Power', 'ZZ', 'R100(1.5)', '(1+t)/c'), ('Power', 'ZZ', 'C100(1,2)', 'c+t'), ('Power', 'ZZ', 'C100(1,2)', 't-c'), ('Power', 'ZZ', 'C100(1,2)', '(1+t)/c'), ('Power', 'ZZ', '1.5', 'c+t'), ('Power', 'ZZ', '1.5', 't-c'), ('Power', 'ZZ', '1.5', '(1+t)/c'), ('Power', "QQ['a,b']", 'RR(1.5)', 'c*t'), ('Power', "QQ['a,b']", 'RR(1.5)', 't*c'), ('Power', "QQ['a,b']", 'RR(1.5)', 'c+t'), ('Power', "QQ['a,b']", 'RR(1.5)', 't-c'), ('Power', "QQ['a,b']", 'RR(1.5)', '(1+t)/c'), ('Power', "QQ['a,b']", 'RDF(1.5)', 'c*t'), ('Power', "QQ['a,b']", 'RDF(1.5)', 't*c'), ('Power', "QQ['a,b']", 'RDF(1.5)', 'c+t'), ('Power', "QQ['a,b']", 'RDF(1.5)', 't-c'), ('Power', "QQ['a,b']", 'RDF(1.5)', '(1+t)/c'), ('Power', "QQ['a,b']", 'R100(1.5)', 'c*t'), ('Power', "QQ['a,b']", 'R100(1.5)', 't*c'), ('Power', "QQ['a,b']", 'R100(1.5)', 'c+t'), ('Power', "QQ['a,b']", 'R100(1.5)', 't-c'), ('Power', "QQ['a,b']", 'R100(1.5)', '(1+t)/c'), ('Power', "QQ['a,b']", '1.5', 'c*t'), ('Power', "QQ['a,b']", '1.5', 't*c'), ('Power', "QQ['a,b']", '1.5', 'c+t'), ('Power', "QQ['a,b']", '1.5', 't-c'), ('Power', "QQ['a,b']", '1.5', '(1+t)/c'), ('Laurent', 'ZZ', 'CC(1,2)', 'c*t'), ('Laurent', 'ZZ', 'CC(1,2)', 't*c'), ('Laurent', 'ZZ', 'CC(1,2)', 'c+t'), ('Laurent', 'ZZ', 'CC(1,2)', 't-c'), ('Laurent', 'ZZ', 'CC(1,2)', '(1+t)/c'), ('Laurent', 'ZZ', 'RR(1.5)', 'c*t'), ('Laurent', 'ZZ', 'RR(1.5)', 't*c'), ('Laurent', 'ZZ', 'RR(1.5)', 'c+t'), ('Laurent', 'ZZ', 'RR(1.5)', 't-c'), ('Laurent', 'ZZ', 'RR(1.5)', '(1+t)/c'), ('Laurent', 'ZZ', 'RDF(1.5)', 'c*t'), ('Laurent', 'ZZ', 'RDF(1.5)', 't*c'), ('Laurent', 'ZZ', 'RDF(1.5)', 'c+t'), ('Laurent', 'ZZ', 'RDF(1.5)', 't-c'), ('Laurent', 'ZZ', 'RDF(1.5)', '(1+t)/c'), ('Laurent', 'ZZ', 'R100(1.5)', 'c*t'), ('Laurent', 'ZZ', 'R100(1.5)', 't*c'), ('Laurent', 'ZZ', 'R100(1.5)', 'c+t'), ('Laurent', 'ZZ', 'R100(1.5)', 't-c'), ('Laurent', 'ZZ', 'R100(1.5)', '(1+t)/c'), ('Laurent', 'ZZ', 'C100(1,2)', 'c*t'), ('Laurent', 'ZZ', 'C100(1,2)', 't*c'), ('Laurent', 'ZZ', 'C100(1,2)', 'c+t'), ('Laurent', 'ZZ', 'C100(1,2)', 't-c'), ('Laurent', 'ZZ', 'C100(1,2)', '(1+t)/c'), ('Laurent', 'ZZ', '1.5', 'c*t'), ('Laurent', 'ZZ', '1.5', 't*c'), ('Laurent', 'ZZ', '1.5', 'c+t'), ('Laurent', 'ZZ', '1.5', 't-c'), ('Laurent', 'ZZ', '1.5', '(1+t)/c'), ('Laurent', "QQ['a,b']", 'RR(1.5)', 'c*t'), ('Laurent', "QQ['a,b']", 'RR(1.5)', 't*c'), ('Laurent', "QQ['a,b']", 'RR(1.5)', 'c+t'), ('Laurent', "QQ['a,b']", 'RR(1.5)', 't-c'), ('Laurent', "QQ['a,b']", 'RR(1.5)', '(1+t)/c'), ('Laurent', "QQ['a,b']", 'RDF(1.5)', 'c*t'), ('Laurent', "QQ['a,b']", 'RDF(1.5)', 't*c'), ('Laurent', "QQ['a,b']", 'RDF(1.5)', 'c+t'), ('Laurent', "QQ['a,b']", 'RDF(1.5)', 't-c'), ('Laurent', "QQ['a,b']", 'RDF(1.5)', '(1+t)/c'), ('Laurent', "QQ['a,b']", 'R100(1.5)', 'c*t'), ('Laurent', "QQ['a,b']", 'R100(1.5)', 't*c'), ('Laurent', "QQ['a,b']", 'R100(1.5)', 'c+t'), ('Laurent', "QQ['a,b']", 'R100(1.5)', 't-c'), ('Laurent', "QQ['a,b']", 'R100(1.5)', '(1+t)/c'), ('Laurent', "QQ['a,b']", '1.5', 'c*t'), ('Laurent', "QQ['a,b']", '1.5', 't*c'), ('Laurent', "QQ['a,b']", '1.5', 'c+t'), ('Laurent', "QQ['a,b']", '1.5', 't-c'), ('Laurent', "QQ['a,b']", '1.5', '(1+t)/c')]
for kind, bname, sn, op in C2:
    B = sage_eval(bname)
    T = (PowerSeriesRing if kind == 'Power' else LaurentSeriesRing)(B, 'x', default_prec=3); t = T.gen()
    c = SC[sn]()
    show('%s %s %s %s' % (kind, bname, sn, op), lambda: sage_eval(OP2[op], locals={'c': c, 't': t}))
