{
  "//": "The Terminal's python commands against CPython 3.14.10 (plan-term-3a r1.7 §5): each case's argv0, its arguments as bash gives them, its stdin (null: not redirected, an empty stdin at end of file), and the files in its folder. test/gen_term_cmd_cases.py records CPython's answers in test/term-cmd-oracle.json; web/shell/term-bridge-cases.js runs each in the Terminal and compares. \"compare\": exact by default; \"last-line\" compares a traceback's last line (and stdout and the status); \"after-name\" compares stderr after its first \": \", for CPython's message that begins with sys.executable (found on PATH: /usr/bin/python in a real terminal), where the Terminal says python.",
  "cases": [
    { "name": "-c", "argv0": "python", "argv": ["-c", "print('hi')"], "stdin": null, "files": {} },
    { "name": "-c with arguments", "argv0": "python", "argv": ["-c", "import sys; print(sys.argv)", "a b", "c"], "stdin": null, "files": {} },
    { "name": "argv with quotes and Unicode", "argv0": "python", "argv": ["-c", "import sys; print(sys.argv[1:])", "it's \"quoted\"", "héllo ✓"], "stdin": null, "files": {} },
    { "name": "python3", "argv0": "python3", "argv": ["-c", "import sys; print(sys.argv[0])"], "stdin": null, "files": {} },
    { "name": "SystemExit(3)", "argv0": "python", "argv": ["-c", "raise SystemExit(3)"], "stdin": null, "files": {} },
    { "name": "SystemExit(256)", "argv0": "python", "argv": ["-c", "raise SystemExit(256)"], "stdin": null, "files": {} },
    { "name": "SystemExit(-1)", "argv0": "python", "argv": ["-c", "raise SystemExit(-1)"], "stdin": null, "files": {} },
    { "name": "SystemExit(3.5)", "argv0": "python", "argv": ["-c", "raise SystemExit(3.5)"], "stdin": null, "files": {} },
    { "name": "SystemExit(None)", "argv0": "python", "argv": ["-c", "raise SystemExit(None)"], "stdin": null, "files": {} },
    { "name": "SystemExit('text')", "argv0": "python", "argv": ["-c", "raise SystemExit('bye')"], "stdin": null, "files": {} },
    { "name": "an uncaught exception, last line", "argv0": "python", "argv": ["-c", "raise ValueError('bad')"], "stdin": null, "files": {}, "compare": "last-line" },
    { "name": "FILE: argv, __file__, sys.path[0]", "argv0": "python", "argv": ["a.py", "x"], "stdin": null, "files": { "a.py": "import sys\nprint(sys.argv, __file__ == sys.argv[0], sys.path[0])\n" } },
    { "name": "FILE missing", "argv0": "python", "argv": ["nofile.py"], "stdin": null, "files": {} },
    { "name": "a folder without __main__.py", "argv0": "python", "argv": ["d"], "stdin": null, "files": { "d/x.txt": "x" }, "compare": "after-name" },
    { "name": "- reads the program from stdin", "argv0": "python", "argv": ["-", "arg"], "stdin": "import sys\nprint(6 * 7, sys.argv)\n", "files": {} },
    { "name": "a program piped in", "argv0": "python", "argv": [], "stdin": "import sys\nprint(sys.argv)\n", "files": {} },
    { "name": "stdin read by the program", "argv0": "python", "argv": ["-c", "import sys; print(repr(sys.stdin.read()))"], "stdin": "abc\ndef\n", "files": {} },
    { "name": "an empty redirected stdin", "argv0": "python", "argv": ["-c", "import sys; print(repr(sys.stdin.read()))"], "stdin": "", "files": {} },
    { "name": "input() from a redirected stdin", "argv0": "python", "argv": ["-c", "x = input('name? '); print('got', x)"], "stdin": "ann\nrest\n", "files": {} },
    { "name": "input() at end of file, last line", "argv0": "python", "argv": ["-c", "input()"], "stdin": "", "files": {}, "compare": "last-line" },
    { "name": "-B", "argv0": "python", "argv": ["-B", "-c", "import sys; print(sys.dont_write_bytecode)"], "stdin": null, "files": {} },
    { "name": "-u", "argv0": "python", "argv": ["-u", "-c", "print(1)"], "stdin": null, "files": {} },
    { "name": "-V", "argv0": "python", "argv": ["-V"], "stdin": null, "files": {} },
    { "name": "--version", "argv0": "python3", "argv": ["--version"], "stdin": null, "files": {} },
    { "name": "an unknown option", "argv0": "python", "argv": ["-j"], "stdin": null, "files": {} },
    { "name": "an unknown option, python3", "argv0": "python3", "argv": ["-j", "x.py"], "stdin": null, "files": {} },
    { "name": "-c without its argument", "argv0": "python", "argv": ["-c"], "stdin": null, "files": {} },
    { "name": "a file written and read back", "argv0": "python", "argv": ["-c", "open('out.txt', 'w').write('x' * 3); print(open('out.txt').read())"], "stdin": null, "files": {} },
    { "name": "a file listed", "argv0": "python", "argv": ["-c", "import os; print(sorted(os.listdir('.')))"], "stdin": null, "files": { "b.txt": "b", "a.txt": "a" } }
  ]
}
