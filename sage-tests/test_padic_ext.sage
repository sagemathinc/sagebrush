t('9 Zp 1/L(-2)', lambda: 1/L(-2))
t('9 Zp ((L(-1) + L(-6)*a).valuation(), (L(-1) + L(-6)*a).precision_absolute(), (L(-1) + L(-6)*a).precision_relative())', lambda: ((L(-1) + L(-6)*a).valuation(), (L(-1) + L(-6)*a).precision_absolute(), (L(-1) + L(-6)*a).precision_relative()))
t('9 Zp (-4*a + K(-2, 2)) * (-4*a + K(1, 7))', lambda: (-4*a + K(-2, 2)) * (-4*a + K(1, 7)))
t('9 Zp (-2*a + K(1, 7)).unit_part()', lambda: (-2*a + K(1, 7)).unit_part())
