{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagebrush.space/catalog/schema.json",
  "title": "A file of Sagebrush function catalog entries (catalog/SCHEMA.md)",
  "type": "array",
  "items": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "signature",
        "summary",
        "examples",
        "differs",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "maxItems": 20
        },
        "kind": {
          "enum": [
            "function",
            "procedure",
            "class",
            "method",
            "attribute",
            "constant",
            "module",
            "operator",
            "keyword"
          ]
        },
        "signature": {
          "type": "string",
          "maxLength": 1000
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "doc": {
          "type": "string",
          "maxLength": 20000
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "maxItems": 10
        },
        "differs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 20
        },
        "status": {
          "enum": [
            "full",
            "partial",
            "stub-error",
            "absent"
          ]
        },
        "alternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 20
        },
        "see_also": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 20
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "upstream_version": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "absent"
              }
            }
          },
          "then": {
            "required": [
              "alternative"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "absent"
                }
              }
            }
          },
          "then": {
            "properties": {
              "examples": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "differs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "expected"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected": {
          "type": "string",
          "pattern": "(^$|\\n$)",
          "maxLength": 8000
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "node",
              "deno",
              "bun",
              "browser",
              "package"
            ]
          }
        }
      }
    }
  }
}
