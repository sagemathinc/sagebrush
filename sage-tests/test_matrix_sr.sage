# Matrices over SR (kernel lane 4b, plan r3 44aaf3ce): Sage's Gauss-Jordan, det for n <= 3, inverse,
# solve, kernels, adjugate, entrywise maps and jacobian.  One statement per line; an error prints as
# ERR <type>, each statement on one line (a matrix's rows joined by ' ; ').  The .out is Sage 10.9's from the counted VM2 run of this exact file, except the lines in
# test_matrix_sr.deviations.md.  The guard spies are in test_matrix_sr_guards.sage (sagebrush only).
def show(f):
    try:
        return str(f()).replace('\n', ' ; ')
    except Exception as e:
        return 'ERR %s' % type(e).__name__
def zero(f):
    try:
        return bool(f().simplify_full() == 0)
    except Exception as e:
        return 'ERR %s' % type(e).__name__
def zmat(f):
    try:
        return all(bool(SR(e).simplify_full() == 0) for e in f().list())
    except Exception as e:
        return 'ERR %s' % type(e).__name__
def zvec(f):
    try:
        return all(bool(SR(e).simplify_full() == 0) for e in f())
    except Exception as e:
        return 'ERR %s' % type(e).__name__
var('x y a b c d f g h t')
B = matrix([[x, 1], [1, y]]); T = matrix([[a, b, 0], [b, a, b], [0, b, a]]); G = matrix([[a, b, c], [d, x, f], [g, h, y]])
R = matrix([[x, 1, 0], [x^2, x, 0]]); S0 = matrix(SR, [[1, 2], [3, 4]]); Q2 = matrix(SR, [[sqrt(2), 1], [1, sqrt(2)]])
print(show(lambda: matrix(SR, [[x, 1], [0, y]])))
print(show(lambda: matrix(SR, 2, 2, [1, 2, 3, 4]).parent()))
print(show(lambda: matrix(SR, 2, 2, lambda i, j: x^(i + j))))
print(show(lambda: matrix([[1, 2], [3, 4]]).change_ring(SR).parent()))
print(show(lambda: (x * B).parent()))
print(show(lambda: (B + matrix(QQ, [[1, 0], [0, 1]])).parent()))
print(show(lambda: matrix(SR, [[x]]).det()))
print(show(lambda: B.det()))
print(show(lambda: T.det()))
print(show(lambda: G.det()))
print(zero(lambda: G.det() - (a*(x*y - f*h) - b*(d*y - f*g) + c*(d*h - x*g))))
print(show(lambda: matrix(SR, 0, 0, []).det()))
print(show(lambda: matrix(SR, [[x, 1, 0, 0], [1, x, 1, 0], [0, 1, x, 1], [0, 0, 1, x]]).det()))
print(show(lambda: B.inverse()))
print(zmat(lambda: B.inverse() * B - 1))
print(show(lambda: S0.inverse()))
print(show(lambda: Q2.det()))
print(show(lambda: Q2.inverse()))
print(show(lambda: matrix([[x, 1], [x^2, x]]).inverse()))
print(show(lambda: matrix(SR, 0, 0, []).inverse()))
print(show(lambda: matrix([[0, 1], [x, 2]]).echelon_form()))
print(show(lambda: matrix([[0, 1], [x, 2]]).inverse()))
print(show(lambda: matrix([[sin(x)^2 + cos(x)^2 - 1, 1], [x, y]]).echelon_form()))
print(show(lambda: matrix([[sin(x)^2 + cos(x)^2 - 1, 1], [x, y]]).pivots()))
print(show(lambda: matrix([[x + 1, 2], [1, x]]).echelon_form()))
print(show(lambda: matrix([[x, 1], [x*(sin(x)^2 + cos(x)^2), sin(x)^2 + cos(x)^2]]).rank()))
print(show(lambda: matrix([[x, 1], [x*(sin(x)^2 + cos(x)^2), sin(x)^2 + cos(x)^2]]).pivots()))
print(show(lambda: matrix([[x, 1], [x*(sin(x)^2 + cos(x)^2), sin(x)^2 + cos(x)^2]]).echelon_form()))
print(show(lambda: B.rank()))
print(show(lambda: matrix([[x, 1], [x^2, x]]).rank()))
print(show(lambda: R.echelon_form()))
print(show(lambda: R.rref()))
print(show(lambda: matrix([[x, 1, 2], [1, y, 3]]).echelon_form()))
print(show(lambda: matrix([[x, 1, 2], [1, y, 3]]).rref()))
print(show(lambda: T.echelon_form()))
print(show(lambda: B.solve_right(vector([1, 0]))))
print(zvec(lambda: B * B.solve_right(vector([1, 0])) - vector([1, 0])))
print(show(lambda: B.solve_left(vector([1, 0]))))
print(show(lambda: matrix([[x, 1, 2], [1, y, 3]]).solve_right(vector([1, 1]))))
print(show(lambda: matrix([[x, 1, 2], [1, y, 3]]).transpose().solve_left(vector([1, 1]))))
print(show(lambda: matrix([[x, 1], [x^2, x]]).solve_right(vector([1, 0]))))
print(show(lambda: matrix([[x, 1], [x^2, x]]).solve_right(vector([1, x]))))
print(show(lambda: B.solve_right(matrix([[1, 0], [0, 1]]))))
print(show(lambda: R.right_kernel()))
print(show(lambda: R.left_kernel()))
print(show(lambda: R.kernel()))
print(show(lambda: R * R.right_kernel().basis()[0]))
print(show(lambda: R.left_kernel().basis()[0] * R))
print(show(lambda: R.transpose().right_kernel()))
print(show(lambda: R.transpose().left_kernel()))
print(show(lambda: R.transpose().kernel()))
print(show(lambda: matrix([[x, x^2], [1, x]]).right_kernel()))
print(show(lambda: matrix(SR, 0, 3, []).right_kernel()))
print(show(lambda: matrix(SR, 0, 3, []).left_kernel()))
print(show(lambda: matrix(SR, 3, 0, []).right_kernel()))
print(show(lambda: matrix(SR, 3, 0, []).left_kernel()))
print(show(lambda: matrix(SR, 3, 0, []).kernel()))
print(show(lambda: matrix(SR, 0, 0, [])))
print(show(lambda: matrix(SR, 1, 3, [x, y, 1])))
print(show(lambda: matrix(SR, 1, 3, [x, y, 1]).rank()))
print(show(lambda: matrix(SR, 1, 3, [x, y, 1]).echelon_form()))
print(show(lambda: matrix(SR, 3, 0, []).dimensions()))
print(show(lambda: matrix(SR, 3, 0, []).rank()))
print(show(lambda: B.subs(x=2)))
print(show(lambda: B.subs({x: 2, y: a})))
print(show(lambda: B.subs(y=a)))
print(show(lambda: B(x=2)))
print(show(lambda: matrix([[x^2, sin(x)], [1, x*y]]).derivative(x)))
print(show(lambda: diff(matrix([[x^2*y, sin(x*y)], [1, x*y]]), x, y)))
print(show(lambda: diff(matrix([[x^3, sin(x)], [1, x*y]]), x, 2)))
print(show(lambda: matrix([[(x^2 - 1)/(x - 1), 1], [0, sin(x)^2 + cos(x)^2]]).simplify_full()))
print(show(lambda: matrix([[(x + 1)^2, 1], [0, x]]).expand()))
print(show(lambda: matrix([[x^2 - 1, 1], [0, x]]).factor()))
print(show(lambda: B.apply_map(lambda e: e^2)))
print(show(lambda: B.variables()))
print(show(lambda: matrix(SR, [[x]]).adjugate()))
print(show(lambda: B.adjugate()))
print(show(lambda: G.adjugate()))
print(zmat(lambda: G.adjugate() * G - G.det()))
print(show(lambda: matrix(SR, [[x, 1, 0, 0], [1, x, 1, 0], [0, 1, x, 1], [0, 0, 1, x]]).adjugate()))
print(show(lambda: matrix(SR, 5, 5, lambda i, j: x^(i + j)).adjugate()))
print(show(lambda: matrix(SR, 0, 0, []).adjugate()))
print(show(lambda: jacobian([x*y, x + y], [x, y])))
print(show(lambda: jacobian(x^2*y, [x, y])))
print(show(lambda: jacobian([x*y, x + y, x - y], [x, y])))
print(show(lambda: matrix([[sqrt(2), x], [1, sqrt(2)]]).det()))
print(show(lambda: matrix([[sqrt(2), x], [1, sqrt(2)]]).rank()))
print(show(lambda: S0.det()))
print(show(lambda: S0.rank()))
print(show(lambda: B.base_ring()))
print(show(lambda: B.inverse().base_ring()))
print(show(lambda: R.right_kernel().base_ring()))
print(show(lambda: matrix([[sin(2*x) - 2*sin(x)*cos(x)]]).rank()))
print(show(lambda: matrix([[sin(2*x) - 2*sin(x)*cos(x), 1], [x, y]]).echelon_form()))
