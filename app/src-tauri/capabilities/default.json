{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The notebook window: open and save the files the person picks in the app's own dialogs (by the grants the app makes, never a path; no fs plugin), set its title, and talk to the engine subprocess. A phone adds the dialog and fs plugins (src/nav.rs page_capability). A template: it grants nothing as it stands (no origin); the app adds it at launch for its page's exact origin, http://127.0.0.1:<the port it holds> (src/nav.rs page_capability).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-startup-files",
    "allow-selftest-open",
    "allow-file-open-dialog",
    "allow-file-save-dialog",
    "allow-file-read-text",
    "allow-file-write-text",
    "allow-folder-list",
    "allow-folder-read",
    "allow-folder-write",
    "allow-selftest-file",
    "allow-selftest-persist",
    "allow-selftest-report",
    "allow-app-log",
    "allow-engine-start",
    "allow-engine-send",
    "allow-engine-ack",
    "allow-engine-stop",
    "allow-disk-list",
    "allow-disk-stat",
    "allow-disk-read",
    "allow-disk-write",
    "allow-disk-mkdir",
    "allow-disk-rename",
    "allow-disk-remove",
    "allow-disk-where",
    "allow-settings-write",
    "allow-app-quit-hold",
    "allow-app-quit-now",
    "allow-agent-status",
    "allow-agent-connect",
    "allow-agent-pair-code",
    "allow-agent-disconnect",
    "core:default",
    "core:window:allow-set-title"
  ],
  "local": false,
  "remote": {
    "urls": []
  }
}
