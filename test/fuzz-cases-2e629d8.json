[
  {
    "name": "scalar greater than lone high must run control",
    "codes": [
      "x = 1",
      "print(((x:=10) if '\\U00010000' > '\\udbff' else 0, x))",
      "print(x)"
    ],
    "change": [
      0,
      "x = 5"
    ],
    "expect": "run"
  },
