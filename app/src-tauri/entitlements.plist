<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac app's entitlements under the hardened runtime: the app and its engine's Node (tauri.macos.conf.json's
     externalBin, signed with the same file).  Node's JavaScript engine compiles code as it runs (JIT), which the
     hardened runtime refuses without these two.  Nothing else: no sandbox, no library-validation exception. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
