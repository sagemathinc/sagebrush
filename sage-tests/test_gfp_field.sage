# GF(p) field methods (Sage mode), as Sage gives them.
F = GF(101)
K = GF(2)
G9.<a> = GF(9)
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('F.quadratic_nonresidue()', lambda: F.quadratic_nonresidue())
show('F.zeta(5)', lambda: F.zeta(5))
show('F.zeta_order()', lambda: F.zeta_order())
show('F.factored_order()', lambda: F.factored_order())
show('F.factored_unit_order()', lambda: F.factored_unit_order())
show('F.unit_group_exponent()', lambda: F.unit_group_exponent())
show('F.zeta(5)^5 == 1', lambda: F.zeta(5)^5 == 1)
show('K.quadratic_nonresidue()', lambda: K.quadratic_nonresidue())
show('F.zeta()', lambda: F.zeta())
show('F.zeta(2)', lambda: F.zeta(2))
show('F.zeta(4)', lambda: F.zeta(4))
show('F.zeta(100)', lambda: F.zeta(100))
show('F.zeta(3)', lambda: F.zeta(3))
show('F.zeta(1)', lambda: F.zeta(1))
show('K.zeta()', lambda: K.zeta())
show('K.zeta_order()', lambda: K.zeta_order())
show('K.factored_unit_order()', lambda: K.factored_unit_order())
show('K.unit_group_exponent()', lambda: K.unit_group_exponent())
show('GF(7).quadratic_nonresidue()', lambda: GF(7).quadratic_nonresidue())
show('GF(41).quadratic_nonresidue()', lambda: GF(41).quadratic_nonresidue())
show('GF(97).zeta(8)', lambda: GF(97).zeta(8))
show('GF(97).factored_unit_order()', lambda: GF(97).factored_unit_order())
show('F.is_conway()', lambda: F.is_conway())
show('G9.is_conway()', lambda: G9.is_conway())
show('GF(9, "b", modulus=GF(3)["t"]([1, 0, 1])).is_conway()', lambda: GF(9, "b", modulus=GF(3)["t"]([1, 0, 1])).is_conway())
show('GF(125, "c").is_conway()', lambda: GF(125, "c").is_conway())
show('GF(125, "c").zeta(31)', lambda: GF(125, "c").zeta(31))
show('GF(125, "c").quadratic_nonresidue()', lambda: GF(125, "c").quadratic_nonresidue())
show('GF(4, "d").quadratic_nonresidue()', lambda: GF(4, "d").quadratic_nonresidue())
show('Zmod(13).zeta(4)', lambda: Zmod(13).zeta(4))
show('G9.quadratic_nonresidue()', lambda: G9.quadratic_nonresidue())
show('G9.zeta_order()', lambda: G9.zeta_order())
show('G9.zeta(4)', lambda: G9.zeta(4))
show('G9.factored_order()', lambda: G9.factored_order())
show('G9.factored_unit_order()', lambda: G9.factored_unit_order())
show('G9.unit_group_exponent()', lambda: G9.unit_group_exponent())
