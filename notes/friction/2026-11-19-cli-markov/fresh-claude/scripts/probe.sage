def t(label, f):
    try: r = f(); print(label, "-> OK:", repr(r).replace("\n", " | "), "| parent:", getattr(r, "parent", lambda: None)())
    except Exception as e: print(label, "->", type(e).__name__ + ":", e)
A = matrix(QQ, [[2, 0], [0, 3]])
t("A^(1/2)", lambda: A^(1/2))
t("A^(0.5)", lambda: A^(0.5))
t("2x2+3x3", lambda: matrix(QQ, 2, 2, [1,1,1,1]) + matrix(QQ, 3, 3, range(9)))
t("3x3+2x2", lambda: matrix(QQ, 3, 3, range(9)) + matrix(QQ, 2, 2, [1,1,1,1]))
t("2x2-3x3", lambda: matrix(QQ, 2, 2, [1,1,1,1]) - matrix(QQ, 3, 3, range(9)))
M = matrix(QQ, [['a', 1], [0, 1]])
t("QQ matrix with 'a': entry type", lambda: type(M[0,0]))
t("  its det", lambda: M.det())
t("  M*M", lambda: M*M)
t("vector len mismatch N*v", lambda: identity_matrix(QQ, 2) * vector(QQ, [1, 2, 3]))
t("matrix(QQ,[[1/3,'x']])", lambda: matrix(QQ, [[1/3, 'x']]))
t("matrix(QQ, 2, 2, [1,2,3])", lambda: matrix(QQ, 2, 2, [1,2,3]))
