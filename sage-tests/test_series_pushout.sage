# A series over a polynomial base meeting an element of another ring, as Sage 10.9 finds the common
# parent: the coefficients move to the common ring (ZZ with QQ is QQ; ZZ or QQ with GF(p) is GF(p)); a
# polynomial over a subset of the base's variables is a constant; a Laurent series meets a ring with
# more variables; Sage's refusals (TypeError, and its RuntimeError for some divisions) are pinned too.
# The 869 cases are those of two probes (880 cases: bases ZZ['x'], QQ['x'], GF(5)['x'], ZZ['a'], QQ['a'],
# ZZ['y'], QQ['x,y'], GF(7)['x']) that Sagebrush answers as Sage; the 11 others are divisions by a
# polynomial whose quotient prints differently in the fraction field (1/2/y for Sage's 1/(2*y)).
def show(label, f):
    try:
        v = f()
        try:
            l = v.list()
        except Exception as e:
            l = 'ERR %s' % type(e).__name__
        print(label, '|', v, '|', l, '|', v.parent())
    except Exception as e:
        print(label, '| ERR', type(e).__name__)
OTHERS = {'QQ[x].gen': lambda: QQ['x'].gen(),
          'ZZ[x].gen': lambda: ZZ['x'].gen(),
          'GF5[x].gen': lambda: GF(5)['x'].gen(),
          'QQ[a].gen': lambda: QQ['a'].gen(),
          'ZZ[a].gen': lambda: ZZ['a'].gen(),
          '1/2': lambda: QQ(1/2),
          '2': lambda: ZZ(2),
          'GF5(2)': lambda: GF(5)(2),
          'QQ[y].gen': lambda: QQ['y'].gen(),
          'QQ[x,y].gen0': lambda: QQ['x,y'].gen(0),
          'GF7[x].gen': lambda: GF(7)['x'].gen(),
          '3/4': lambda: QQ(3/4),
          'GF7(3)': lambda: GF(7)(3),
          'ZZ[y].gen^2+1': lambda: ZZ['y'].gen()^2 + 1,
          'QQ[x].(x^2+3)': lambda: QQ['x'].gen()^2 + 3,
          'ZZ[b].gen': lambda: ZZ['b'].gen(),
          'GF5(3)': lambda: GF(5)(3)}
OPS = {'o*t': 'o*t', 't*o': 't*o', 'o+t': 'o + t', 't-o': 't - o', 't/o': 't/o', '(o*t)/o': '(o*t)/o', 'o^2*t': 'o^2*t', 't^2 + o': 't^2 + o', 'o - t^3': 'o - t^3', '(t + o)*t': '(t + o)*t', 't/(2*o)': 't/(2*o)'}
