# GF(p) polynomial basics: reverse, truncate, shift, valuation, padded_list, number_of_terms, monomial predicates, trailing_coefficient (Sage mode), as Sage gives them.
R.<x> = GF(101)[]
f = x^5 + 3*x + 1
F9.<a> = GF(9)
S.<y> = F9[]
T.<z> = GF(2)[]
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", "%s: %s" % (type(e).__name__, str(e).split(chr(10))[0]), flush=True)
show('f.reverse()', lambda: f.reverse())
show('f.reverse(7)', lambda: f.reverse(7))
show('f.truncate(2)', lambda: f.truncate(2))
show('f.shift(2)', lambda: f.shift(2))
show('f.shift(-1)', lambda: f.shift(-1))
show('(x^3 + x^2).valuation()', lambda: (x^3 + x^2).valuation())
show('R(0).valuation()', lambda: R(0).valuation())
show('f.padded_list(7)', lambda: f.padded_list(7))
show('f.number_of_terms()', lambda: f.number_of_terms())
show('(5*x^3).is_monomial()', lambda: (5*x^3).is_monomial())
show('(5*x^3).is_term()', lambda: (5*x^3).is_term())
show('x.is_gen()', lambda: x.is_gen())
show('(x^3 + 2*x).trailing_coefficient()', lambda: (x^3 + 2*x).trailing_coefficient())
show('f.monomial_coefficient(x^5)', lambda: f.monomial_coefficient(x^5))
show('f.exponents()', lambda: f.exponents())
show('f.coefficients(sparse=False)', lambda: f.coefficients(sparse=False))
show('R(0).reverse()', lambda: R(0).reverse())
show('R(0).truncate(3)', lambda: R(0).truncate(3))
show('R(0).shift(2)', lambda: R(0).shift(2))
show('R(0).padded_list(3)', lambda: R(0).padded_list(3))
show('f.padded_list(2)', lambda: f.padded_list(2))
show('R(0).number_of_terms()', lambda: R(0).number_of_terms())
show('R(0).is_monomial()', lambda: R(0).is_monomial())
show('x.is_monomial()', lambda: x.is_monomial())
show('R(1).is_monomial()', lambda: R(1).is_monomial())
show('R(0).is_term()', lambda: R(0).is_term())
show('(x + 1).is_gen()', lambda: (x + 1).is_gen())
show('R(0).trailing_coefficient()', lambda: R(0).trailing_coefficient())
show('(x^2 + 2*x).exponents()', lambda: (x^2 + 2*x).exponents())
show('R(0).exponents()', lambda: R(0).exponents())
show('(x^2 + 1).monomial_coefficient(x)', lambda: (x^2 + 1).monomial_coefficient(x))
show('(x^3).valuation()', lambda: (x^3).valuation())
show('R(5).valuation()', lambda: R(5).valuation())
show('(x^2 + 1).reverse(1)', lambda: (x^2 + 1).reverse(1))
show('(x^3 + 2*x^2).reverse(degree=1)', lambda: (x^3 + 2*x^2).reverse(degree=1))
show('(y^2 + a).reverse()', lambda: (y^2 + a).reverse())
show('(z^3 + z).shift(-1)', lambda: (z^3 + z).shift(-1))
show('f.monomial_coefficient(2*x)', lambda: f.monomial_coefficient(2*x))
show('f.monomial_coefficient(x + 1)', lambda: f.monomial_coefficient(x + 1))
show('f.monomial_coefficient(R(2))', lambda: f.monomial_coefficient(R(2)))
show('f.monomial_coefficient(R(0))', lambda: f.monomial_coefficient(R(0)))
