# The print order of symbolic sums and products (lane 4p): probe r4's statements, run on Sage 10.9 (counted-4, VM2).
# Each statement prints ONE line: 'S<nn> ' then str() and latex() joined by ' || ' (newlines -> ' ; '), or 'S<nn> ERR <type>'.
# Below line 2 the file is probe_r4.sage byte for byte; its 'OBS' comments are the probe's, and its OBS lines are ordinary lines here.
def show(f):
    # str() and latex() of one expression on one line, separated by ' || '
    try:
        v = f()
    except Exception as e:
        return 'ERR %s' % type(e).__name__
    try:
        l = str(latex(v))
    except Exception as e:
        l = 'ERR %s' % type(e).__name__
    return (str(v) + ' || ' + l).replace('\n', ' ; ')
var('a b c d f g h j k l m n p q r s t u v w x y z')
print('S01 ' + show(lambda: (y - 1/x)*x^2))
print('S02 ' + show(lambda: (y - 1/x)*x))
print('S03 ' + show(lambda: (x + 1)*x))
print('S04 ' + show(lambda: (x + 1)*y))
print('S05 ' + show(lambda: (y + 1)*x))
print('S06 ' + show(lambda: (a + b)*c))
print('S07 ' + show(lambda: (c + d)*a))
print('S08 ' + show(lambda: (b + c)*b))
print('S09 ' + show(lambda: (b + c)*c))
print('S10 ' + show(lambda: (x^2 + y)*x))
print('S11 ' + show(lambda: (y^2 + x)*y))
print('S12 ' + show(lambda: (z - 1/y)*x*y))
print('S13 ' + show(lambda: 1/((y - 1/x)*x^2)))
print('S14 ' + show(lambda: 1/((y - 1/x)*x)))
print('S15 ' + show(lambda: 1/((x - 1/y)*y)))
print('S16 ' + show(lambda: 1/((a + b)*c^2)))
print('S17 ' + show(lambda: 1/((c + d)*a^2)))
print('S18 ' + show(lambda: (x + y)*(x - y)))
print('S19 ' + show(lambda: (y + 1)*(x + 1)))
print('S20 ' + show(lambda: (x + 1)*(x + 2)*x))
# sums of equal-degree terms, with and without a sum factor
print('S21 ' + show(lambda: (a^2 - b^2)*a - a*b^2))
print('S22 ' + show(lambda: x^2 + (-x - y)*x + x*y - 1))
print('S23 ' + show(lambda: x*y + (x + y)*x))
print('S24 ' + show(lambda: x^2 + (x + y)*y))
print('S25 ' + show(lambda: y^2 + (x + y)*x))
print('S26 ' + show(lambda: a*b + (a + b)*c))
print('S27 ' + show(lambda: (a + b)*c + a*c))
print('S28 ' + show(lambda: c*d + (a - b)*c))
print('S29 ' + show(lambda: x^3 + (x + 1)*x^2 + x))
print('S30 ' + show(lambda: (x - 1)*x + x^2 + x))
print('S31 ' + show(lambda: a*(x*y - f*h) - b*(d*y - f*g) + c*(d*h - x*g)))
print('S32 ' + show(lambda: a*(x*y - f*h) - d*(b*y - c*h) + g*(b*f - c*x)))
# negated sums: as a term, in a quotient, as a coefficient
print('S33 ' + show(lambda: -(2/x - 3)/(y - 1/x)))
print('S34 ' + show(lambda: 2/x + (2/x - 3)/(x*(y - 1/x))))
print('S35 ' + show(lambda: (3 - 2/x)/(y - 1/x)))
print('S36 ' + show(lambda: -(x - 1)/y))
print('S37 ' + show(lambda: (1 - x)/y))
print('S38 ' + show(lambda: -(x - 1)*y))
print('S39 ' + show(lambda: (1 - x)*y))
print('S40 ' + show(lambda: -(x + 1)/y))
print('S41 ' + show(lambda: -(a - b)*c + d))
print('S42 ' + show(lambda: (b - a)*c + d))
print('S43 ' + show(lambda: 1/x + (1/x - 1)/(x*(y - 1/x))))
print('S44 ' + show(lambda: -(1/x - 1)/(y - 1/x)))
print('S45 ' + show(lambda: (1 - 1/x)/(y - 1/x)))
print('S46 ' + show(lambda: x - (y - 1)))
print('S47 ' + show(lambda: x - (1 - y)*z))
print('S48 ' + show(lambda: -(x - y)^2))
print('S49 ' + show(lambda: -(x - y)/(x + y)))
print('S50 ' + show(lambda: (y - x)/(x + y)))
# the ten 4b target lines' expressions, rebuilt (B = [[x, 1], [1, y]], T, G)
print('S51 ' + show(lambda: matrix([[a, b, 0], [b, a, b], [0, b, a]]).det()))
print('S52 ' + show(lambda: matrix([[a, b, c], [d, x, f], [g, h, y]]).det()))
print('S53 ' + show(lambda: matrix([[x, 1], [1, y]]).inverse()))
