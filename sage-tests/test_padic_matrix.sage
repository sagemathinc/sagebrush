# Matrices over Zp and Qp: construction, printing, the ring operations with
# their precision, det (n <= 3), trace and charpoly (n <= 2).
def t(label, f):
    try:
        print(label, '::', f())
    except Exception as e:
        print(label, '::', type(e).__name__)

K = Qp(5, 5)
Z = Zp(5, 4)
A = matrix(K, 2, 2, [1, 2, 3, 4])
t('A', lambda: A)
t('A.parent', lambda: A.parent())
B = matrix(K, 2, 2, [K(3260/5, absprec=5), K(13668/5, absprec=4), K(12265/5, absprec=5), K(12365/5, absprec=5)])
t('B', lambda: B)
t('-B^2', lambda: -B^2)
t('B*B', lambda: B*B)
t('B+A', lambda: B + A)
t('B-A', lambda: B - A)
t('5*B', lambda: 5*B)
t('B*5', lambda: B*5)
t('(1/5)*A', lambda: (1/5)*A)
t('K(25)*B', lambda: K(25)*B)
t('B^0', lambda: B^0)
t('B^1', lambda: B^1)
t('B^3', lambda: B^3)
t('B^5', lambda: B^5)
t('B.det', lambda: B.det())
t('B.trace', lambda: B.trace())
t('B.charpoly', lambda: B.charpoly())
t('A.charpoly', lambda: A.charpoly())
t('A.charpoly(t)', lambda: A.charpoly('t'))
t('B[0,1]', lambda: B[0,1])
t('B[-1,-1]', lambda: B[-1,-1])
t('B.list', lambda: B.list())
t('B.transpose', lambda: B.transpose())
t('B.T', lambda: B.T)
t('B==B', lambda: B == B)
t('A==B', lambda: A == B)
t('A!=B', lambda: A != B)
t('B.nrows', lambda: (B.nrows(), B.ncols(), B.dimensions(), B.is_square()))
t('B.base_ring', lambda: B.base_ring())
t('B.diagonal', lambda: B.diagonal())
ZM = matrix(Z, [[1, 5], [25, 7]])
t('Z', lambda: ZM)
t('Z.parent', lambda: ZM.parent())
t('Zdet', lambda: ZM.det())
t('Z^4', lambda: ZM^4)
t('Z*Z-Z', lambda: ZM*ZM - ZM)
t('Z.charpoly', lambda: ZM.charpoly())
t('M3', lambda: matrix(K, 3, 3, range(1, 10)))
t('M3det', lambda: matrix(K, 3, 3, [2, 0, 1, 1, 5, 0, 0, 1, 25]).det())
t('M3det2', lambda: matrix(K, 3, 3, [1/5, 3, 7, 25, 2, 1, 4, 4, 125]).det())
t('M3^2', lambda: matrix(K, 3, 3, [1/5, 3, 7, 25, 2, 1, 4, 4, 125])^2)
t('M3.trace', lambda: matrix(K, 3, 3, [1/5, 3, 7, 25, 2, 1, 4, 4, 125]).trace())
t('M23', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]))
t('M23*M32', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]) * matrix(K, 3, 2, [1, 2, 3, 4, 5, 6]))
t('M32*M23', lambda: matrix(K, 3, 2, [1, 2, 3, 4, 5, 6]) * matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]))
t('M23.T', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]).transpose())
t('M23*M23', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]) * matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]))
t('M23^2', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3])^2)
t('M23.det', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]).det())
t('M23+1', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]) + 1)
t('M23+A', lambda: matrix(K, 2, 3, [1, 5, 1/5, 0, 125, 3]) + A)
t('scalar', lambda: matrix(K, 2, 2, 3))
t('scalar 2x3 0', lambda: matrix(K, 2, 3, 0))
t('scalar 2x3 3', lambda: matrix(K, 2, 3, 3))
t('zero', lambda: matrix(K, 2, 2))
t('rows', lambda: matrix(K, [[1, 2], [3, 4]]))
t('nrows entries', lambda: matrix(K, 2, [1, 2, 3, 4, 5, 6]))
t('wrong length', lambda: matrix(K, 2, 2, [1, 2, 3]))
t('MS', lambda: MatrixSpace(K, 2))
t('MS23', lambda: MatrixSpace(K, 2, 3))
t('MScall', lambda: MatrixSpace(K, 2)([1, 2, 3, 4]))
t('MSzero', lambda: MatrixSpace(K, 2)())
t('MS==', lambda: (MatrixSpace(K, 2) == A.parent(), MatrixSpace(K, 2) == MatrixSpace(Z, 2)))
t('identity', lambda: identity_matrix(K, 2))
t('identity Z', lambda: identity_matrix(Z, 3))
t('zero_matrix', lambda: zero_matrix(K, 2, 3))
t('inexact0', lambda: matrix(K, 2, 2, [K(0, 3), 1, 1, K(0, 2)]))
t('inexact0^2', lambda: matrix(K, 2, 2, [K(0, 3), 1, 1, K(0, 2)])^2)
t('inexact0 det', lambda: matrix(K, 2, 2, [K(0, 3), 1, 1, K(0, 2)]).det())
t('inexact0 is_zero', lambda: (matrix(K, 2, 2, [K(0, 3), 0, 0, K(0, 2)]).is_zero(), matrix(K, 2, 2, [K(0, 3), 1, 1, K(0, 2)]).is_zero()))
t('inexact0 == 0', lambda: (matrix(K, 2, 2, [K(0, 3), 0, 0, K(0, 2)]) == 0, A == 0, A == A + 0))
t('mixed', lambda: matrix(K, 2, 2, [5^-2, O(5^3), 1 + O(5^2), 7]))
t('mixed^2', lambda: matrix(K, 2, 2, [5^-2, O(5^3), 1 + O(5^2), 7])^2)
t('mixed det', lambda: matrix(K, 2, 2, [5^-2, O(5^3), 1 + O(5^2), 7]).det())
t('A+1', lambda: A + 1)
t('1+A', lambda: 1 + A)
t('A-1', lambda: A - 1)
t('1-A', lambda: 1 - A)
t('A+K(5)', lambda: A + K(5))
t('A.is_zero', lambda: (A.is_zero(), matrix(K, 2, 2).is_zero()))
t('nobase', lambda: matrix([[K(1), K(5)], [K(2), K(3)]]))
t('nobase parent', lambda: matrix([[K(1), K(5)], [K(2), K(3)]]).parent())
t('nobase mixed ints', lambda: matrix([[K(1), 5], [1/5, 3]]))
t('big', lambda: matrix(Qp(7, 3), 2, 2, [7^10, 1/7^3, -1, 49]))
t('neg', lambda: -matrix(Qp(7, 3), 2, 2, [7^10, 1/7^3, -1, 49]))
t('big^2', lambda: matrix(Qp(7, 3), 2, 2, [7^10, 1/7^3, -1, 49])^2)
t('p=2', lambda: matrix(Qp(2, 6), 2, 2, [1, 3, 1/2, 6])^3)
t('p=101', lambda: matrix(Qp(101, 3), 2, 2, [100, 1/101, 5, 101^2]) * matrix(Qp(101, 3), 2, 2, [1, 2, 3, 4]))
C = A.__copy__()
C[0, 1] = 25
t('setitem', lambda: (C, A))
t('det 1x1', lambda: matrix(K, 1, 1, [1/25]).det())
t('charpoly 1x1', lambda: matrix(K, 1, 1, [1/25]).charpoly())
# review: the coercion lattice (as for p-adic numbers: the pushout of the
# rings, the same prime), integral exponents, exact dimensions
Q5 = Qp(5, 5); Z4 = Zp(5, 4); Q8 = Qp(5, 8)
A = matrix(Q5, 2, 2, [1, 2, 3, 4]); ZA = matrix(Z4, 2, 2, [1, 5, 25, 7]); B8 = matrix(Q8, 2, 2, [1/5, 2, 3, 4])
for name, f in [('A*ZA', lambda: A*ZA), ('ZA*A', lambda: ZA*A), ('A+ZA', lambda: A + ZA), ('ZA-A', lambda: ZA - A),
                ('A*B8', lambda: A*B8), ('B8+A', lambda: B8 + A), ('ZA*Zp(5,6)', lambda: ZA*matrix(Zp(5, 6), 2, 2, [1, 2, 3, 4])),
                ('A*Z4(2)', lambda: A*Z4(2)), ('Z4(2)*A', lambda: Z4(2)*A), ('ZA*Q5(2)', lambda: ZA*Q5(2)), ('ZA*Q8(1/5)', lambda: ZA*Q8(1/5)),
                ('ZA*(1/5)', lambda: ZA*(1/5)), ('(1/5)*ZA', lambda: (1/5)*ZA), ('ZA+1/5', lambda: ZA + 1/5), ('1/5-ZA', lambda: 1/5 - ZA),
                ('ZA*(2/3)', lambda: ZA*(2/3)), ('ZA+Q8(1)', lambda: ZA + Q8(1)),
                ('matrix(Q5, ZA)', lambda: matrix(Q5, ZA)), ('matrix(Z4, A)', lambda: matrix(Z4, A)), ('matrix(Z4, B8)', lambda: matrix(Z4, B8)),
                ('MS(Q5)(ZA)', lambda: MatrixSpace(Q5, 2)(ZA)), ('MS(Z4)(B8)', lambda: MatrixSpace(Z4, 2)(B8)),
                ('nobase mixed', lambda: matrix([[Q5(1), Z4(2)], [Q8(3), 4]])), ('nobase Z 1/5', lambda: matrix([[Z4(1), 1/5]])),
                ('matrix(Q5, [[Z4(2), Q8(1/5)]])', lambda: matrix(Q5, [[Z4(2), Q8(1/5)]])),
                ('A == ZA', lambda: (A == ZA, A == matrix(Z4, A), matrix(Z4, A) == A)),
                ('A^(4/2)', lambda: A^(4/2)), ('A^Integer(3)', lambda: A^Integer(3))]:
    try:
        X = f()
        print(name, '::', X.parent() if hasattr(X, 'parent') else '', '::', X)
    except Exception as e:
        print(name, '::', type(e).__name__)
t('A^(3/2)', lambda: A^(3/2))
t('A^2.9', lambda: A^2.9)
t('A^2.0', lambda: A^2.0)
t('A*Qp(7)', lambda: A*matrix(Qp(7, 5), 2, 2, [1, 2, 3, 4]))
t('A+Qp(7)(1)', lambda: A + Qp(7, 5)(1))
t('mixed primes', lambda: matrix([[Q5(1), Qp(7)(1)]]))
t('Q7 entry', lambda: matrix(Q5, [[Qp(7)(1)]]))
t('Zp neg val', lambda: matrix(Z4, [[Q5(1/5)]]))
t('zero -1', lambda: zero_matrix(Q5, -1, 2))
t('MS -1', lambda: MatrixSpace(Q5, -1, 2))
t('2.9 rows', lambda: matrix(Q5, 2.9, 2, 0))
t('2 x 2.0', lambda: matrix(Q5, 2, 2.0, 0))
t('identity -1', lambda: identity_matrix(Q5, -1))
t('rows gen', lambda: matrix(Q5, (r for r in [[1, 2], [3, 4]])))
t('entries gen', lambda: matrix(Q5, 2, 2, (i for i in range(4))))
t('entries range', lambda: matrix(Q5, 2, 2, range(4)))
t('too many', lambda: matrix(Q5, 2, 2, range(5)))
t('too few', lambda: matrix(Q5, 2, 2, range(3)))
# second review: dimensions and wrong lengths in the generic and finite-field
# constructors (Sage's errors; reading is bounded, tested sagebrush-only)
t('matrix(QQ, -1, 2)', lambda: matrix(QQ, -1, 2))
t('matrix(QQ, 2, -1)', lambda: matrix(QQ, 2, -1))
t('matrix(-2)', lambda: matrix(-2))
t('zero_matrix(QQ, -1, 2)', lambda: zero_matrix(QQ, -1, 2))
t('identity_matrix(-1)', lambda: identity_matrix(-1))
t('MatrixSpace(QQ, -1)', lambda: MatrixSpace(QQ, -1))
t('matrix(GF(5), -1, 2)', lambda: matrix(GF(5), -1, 2))
t('VectorSpace(QQ, -1)', lambda: VectorSpace(QQ, -1))
t('VectorSpace(QQ, 2.5)', lambda: VectorSpace(QQ, 2.5))
t('GF(5)^2.5', lambda: GF(5)^2.5)
t('GF(5)^-1', lambda: GF(5)^-1)
t('matrix(QQ, 2, 2, range(5))', lambda: matrix(QQ, 2, 2, range(5)))
t('matrix(QQ, 2, 2, range(3))', lambda: matrix(QQ, 2, 2, range(3)))
t('block_matrix(1, 1, [identity_matrix(QQ, 2)])', lambda: block_matrix(1, 1, [identity_matrix(QQ, 2)]))
t('block_matrix(2, [1, 2, 3])', lambda: block_matrix(2, [identity_matrix(QQ, 1), 2, 3]))
t('diagonal_matrix(QQ, (i for i in range(3)))', lambda: diagonal_matrix(QQ, (i for i in range(3))))
t('vector(i for i in range(3))', lambda: vector(i for i in range(3)))
t('vector([1, 2, 3]).cross_product([1, 2])', lambda: vector([1, 2, 3]).cross_product([1, 2]))
t('augment wrong', lambda: matrix(QQ, 2, 2, 1).augment([1, 2, 3]))
t('stack wrong', lambda: matrix(QQ, 2, 2, 1).stack([1, 2, 3]))
t('[1,2,3,4] in V3', lambda: [1, 2, 3, 4] in VectorSpace(QQ, 3))
t('zero_matrix(QQ, 3, 0)', lambda: zero_matrix(QQ, 3, 0))
