# moebius.range(start, stop=None, step=None) and prime_pi.plot(xmin=0, xmax=100, vertical_lines=True, **kwds), as Sage:
# the range's bounds and step through int(), moebius at range(start, stop, step) (one argument: from 1), with step 1 a
# stop below the start is PARI's error; the plot is a step line from (xmin, pi(xmin)), as Sage 10.10
# draws it: the steps at the primes of prime_range(xmin + 1, xmax + 1) (its bounds rounded, a half to
# even) and at xmax, sorted together, up by 1 at each but the last, which is doubled; the options are line()'s (the rows
# compare with line(), whose own option forms are not this file's); with vertical_lines=False, a segment per step.
def show(label, f):
    try:
        print(label, "->", repr(f()), flush=True)
    except Exception as e:
        print(label, "->", "%s: %s" % (type(e).__name__, e), flush=True)
def xy(G):
    return [(list(p.xdata), list(p.ydata)) for p in G]
show("moebius.range(1, 11)", lambda: moebius.range(1, 11))
show("moebius.range(10)", lambda: moebius.range(10))
show("moebius.range(0, 11, 2)", lambda: moebius.range(0, 11, 2))
show("moebius.range(-5, 5)", lambda: moebius.range(-5, 5))
show("moebius.range(1, 31)", lambda: moebius.range(1, 31))
show("moebius.range(10, 0, -1)", lambda: moebius.range(10, 0, -1))
show("moebius.range(1, 11, 3)", lambda: moebius.range(1, 11, 3))
show("moebius.range(3, -3, -2)", lambda: moebius.range(3, -3, -2))
show("moebius.range(10, 1, -3)", lambda: moebius.range(10, 1, -3))
show("moebius.range(-10, -1, 1)", lambda: moebius.range(-10, -1, 1))
show("moebius.range(5, 10, -1)", lambda: moebius.range(5, 10, -1))
show("moebius.range(10, 1, 2)", lambda: moebius.range(10, 1, 2))
show("moebius.range(1)", lambda: moebius.range(1))
show("moebius.range(5, 5)", lambda: moebius.range(5, 5))
show("moebius.range(0, 1)", lambda: moebius.range(0, 1))
show("moebius.range(-1, 0)", lambda: moebius.range(-1, 0))
show("moebius.range(0, 1, 2)", lambda: moebius.range(0, 1, 2))
show("moebius.range(0)", lambda: moebius.range(0))
show("moebius.range(5, 1)", lambda: moebius.range(5, 1))
show("moebius.range(5, 4, 1)", lambda: moebius.range(5, 4, 1))
show("moebius.range(1, 11, 0)", lambda: moebius.range(1, 11, 0))
show("moebius.range(1, 4, 0.5)", lambda: moebius.range(1, 4, 0.5))
show("moebius.range(1.5, 4)", lambda: moebius.range(1.5, 4))
show("moebius.range(2.9, 4)", lambda: moebius.range(2.9, 4))
show("moebius.range(-2.9, 4)", lambda: moebius.range(-2.9, 4))
show("moebius.range(-7/2, 1)", lambda: moebius.range(-7/2, 1))
show("moebius.range(1/2, 4)", lambda: moebius.range(1/2, 4))
show("moebius.range(1, 4.7)", lambda: moebius.range(1, 4.7))
show("moebius.range(1, 10, 2.5)", lambda: moebius.range(1, 10, 2.5))
show("moebius.range(1, 4, 1.0)", lambda: moebius.range(1, 4, 1.0))
show("moebius.range(1, '4')", lambda: moebius.range(1, '4'))
show("moebius.range('a')", lambda: moebius.range('a'))
show("moebius.range(1, None)", lambda: moebius.range(1, None))
show("moebius.range(1, 4, None)", lambda: moebius.range(1, 4, None))
show("moebius.range(GF(7)(3), 6)", lambda: moebius.range(GF(7)(3), 6))
show("moebius.range(True, 4)", lambda: moebius.range(True, 4))
show("moebius.range(1, 4, step=1)", lambda: moebius.range(1, 4, step=1))
show("moebius.range(start=1, stop=4)", lambda: moebius.range(start=1, stop=4))
show("moebius.range(10^6, 10^6 + 10)", lambda: moebius.range(10^6, 10^6 + 10))
show("moebius.range(2^64, 2^64 + 6)", lambda: moebius.range(2^64, 2^64 + 6))
show("sum(moebius.range(1, 10^5))", lambda: sum(moebius.range(1, 10^5)))
show("moebius.range(1, 10^5) == [moebius(n) for n in [1..10^5 - 1]]", lambda: moebius.range(1, 10^5) == [moebius(n) for n in [1..10^5 - 1]])
show("moebius(0), moebius(-6), moebius(10)", lambda: (moebius(0), moebius(-6), moebius(10)))
show("plot(0, 20)", lambda: prime_pi.plot(0, 20))
show("plot(0, 20) xy", lambda: xy(prime_pi.plot(0, 20)))
show("plot(2.5, 9.5) xy", lambda: xy(prime_pi.plot(2.5, 9.5)))
show("plot(2, 3) xy", lambda: xy(prime_pi.plot(2, 3)))
show("plot(2, 2) xy", lambda: xy(prime_pi.plot(2, 2)))
show("plot(3, 4) xy", lambda: xy(prime_pi.plot(3, 4)))
show("plot(-5, 5) xy", lambda: xy(prime_pi.plot(-5, 5)))
show("plot(0, 2) xy", lambda: xy(prime_pi.plot(0, 2)))
show("plot(1/2, 7/2) xy", lambda: xy(prime_pi.plot(1/2, 7/2)))
show("plot(RR(1.5), 4) xy", lambda: xy(prime_pi.plot(RR(1.5), 4)))
show("plot(QQ(3), 5) xy", lambda: xy(prime_pi.plot(QQ(3), 5)))
show("plot(xmin=3, xmax=8) xy", lambda: xy(prime_pi.plot(xmin=3, xmax=8)))
for a, b in [(2.4, 9.5), (2.6, 9.5), (3.5, 9.5), (4.5, 9.5), (6.5, 12.5), (5/2, 9), (7/2, 9), (9/2, 9), (1, 10.5), (1, 11.5), (1, 12.5), (0, 6.5), (0, 4.5), (2.0, 3.0)]:
    show("plot(%r, %r) xy" % (float(a), float(b)), lambda: xy(prime_pi.plot(a, b)))
for a, b in [(0, 6.5), (1, 12.5), (6.5, 12.5)]:
    show("plot(%r, %r, vertical_lines=False) xy" % (float(a), float(b)), lambda: xy(prime_pi.plot(a, b, vertical_lines=False)))
show("plot(10): first x, count", lambda: (list(prime_pi.plot(10)[0].xdata[:5]), len(prime_pi.plot(10)[0].xdata)))
show("plot() count", lambda: len(prime_pi.plot()[0].xdata))
show("plot(4, 250) count", lambda: len(prime_pi.plot(4, 250)[0].xdata))
show("plot(0, 2^20) count", lambda: len(prime_pi.plot(0, 2^20)[0].xdata))
show("plot(0, 20) minmax", lambda: prime_pi.plot(0, 20).get_minmax_data())
show("plot(10) minmax", lambda: prime_pi.plot(10).get_minmax_data())
show("plot() minmax", lambda: prime_pi.plot().get_minmax_data())
show("plot(0, 20, vertical_lines=False) xy", lambda: xy(prime_pi.plot(0, 20, vertical_lines=False)))
show("plot(2, 3, vertical_lines=False) xy", lambda: xy(prime_pi.plot(2, 3, vertical_lines=False)))
show("plot(2, 2, vertical_lines=False) xy", lambda: xy(prime_pi.plot(2, 2, vertical_lines=False)))
show("plot(2.5, 9.5, vertical_lines=False) xy", lambda: xy(prime_pi.plot(2.5, 9.5, vertical_lines=False)))
same = lambda P, **kw: P.options() == line([(0, 0), (1, 1)], **kw)[0].options()
show("plot(0, 20): line()'s options", lambda: same(prime_pi.plot(0, 20)[0]))
show("plot(0, 20, color='blue'): line()'s options", lambda: same(prime_pi.plot(0, 20, color='blue')[0], color='blue'))
show("plot(0, 20, thickness=3): line()'s options", lambda: same(prime_pi.plot(0, 20, thickness=3)[0], thickness=3))
show("plot(0, 20, legend_label='pi'): line()'s options", lambda: same(prime_pi.plot(0, 20, legend_label='pi')[0], legend_label='pi'))
show("plot(0, 20, color='red', thickness=2): line()'s options", lambda: same(prime_pi.plot(0, 20, color='red', thickness=2)[0], color='red', thickness=2))
show("plot(0, 20, color='red'): not line()'s default", lambda: same(prime_pi.plot(0, 20, color='red')[0]))
show("plot(0, 20, vertical_lines=False): line()'s options", lambda: all(same(q) for q in prime_pi.plot(0, 20, vertical_lines=False)))
show("plot(0, 20, vertical_lines=False, color='green'): line()'s options", lambda: all(same(q, color='green') for q in prime_pi.plot(0, 20, vertical_lines=False, color='green')))
show("plot(0, 20, False), plot(0, 20, 1), plot(0, 5, None)", lambda: (len(prime_pi.plot(0, 20, False)), len(prime_pi.plot(0, 20, 1)), len(prime_pi.plot(0, 5, None))))
show("plot(20, 0)", lambda: prime_pi.plot(20, 0))
show("plot(5, 3), plot(4.5, 4), plot(20, 0, vertical_lines=False)", lambda: (xy(prime_pi.plot(5, 3)), xy(prime_pi.plot(4.5, 4)), xy(prime_pi.plot(20, 0, vertical_lines=False))))
show("plot(0, 20, title='t')", lambda: prime_pi.plot(0, 20, title='t'))
show("plot(0, 20) + plot(0, 20, vertical_lines=False)", lambda: prime_pi.plot(0, 20) + prime_pi.plot(0, 20, vertical_lines=False))
