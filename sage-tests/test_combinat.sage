p = Partition([3, 1])
print(p, p.conjugate(), p.hook_lengths())
print(Partition([4, 2, 1]).conjugate())
print([3, 1] in Partitions(4), [2, 3] in Partitions(5))
print(Compositions(4).cardinality())
