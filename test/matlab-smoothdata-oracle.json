{
 "about": "MATLAB R2026b Update 2's smoothdata (MATLAB Online, 2026-11-25 and 2026-11-26): each program as it ran, and its rows, NAME|values printed at %.17g (a function's error as NAME|ERROR|identifier|message). p9: impulse, edge and ramp responses of each method with windows 3, 4, 5, 7 and [2 1], outliers, NaN, degrees, dimensions, classes and errors. p9b: the default window over lengths, shapes and smoothing factors (A), the robust methods on near-exact fits (B), NaN inside windows (C), and windows of 1, 2, 2.5, [0 0], [3 0] and past the data's length (D). The test compares every row: values within 1e-12 of each row's largest magnitude (B's, near 1e-15, within 1e-12 absolutely); the default window's rows (A_*, *_def_*, sf_*, def_*) and SamplePoints are refused in Sagebrush.",
 "p9": {
  "program": [
   "format long g",
   "% p9: smoothdata's kernels, edges and default windows, from impulse and ramp responses. Small fixed inputs, no timing.",
   "% Each row: NAME|winsize|%.17g of the result.",
   "try, show = @(name, B, w) fprintf('%s|%s|%s\\n', name, sprintf('%.17g ', w), sprintf('%.17g ', B)), catch e_, fprintf('L5|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "e = zeros(1, 15); e(8) = 1;          % an impulse in the middle",
   "e1 = zeros(1, 15); e1(1) = 1;        % at the first element",
   "e2 = zeros(1, 15); e2(2) = 1;        % at the second",
   "r = (1:15).^2;                        % a smooth curve",
   "for m = {'movmean', 'movmedian', 'gaussian', 'lowess', 'loess', 'rlowess', 'rloess', 'sgolay'}",
   "  for w = [3 4 5 7]",
   "    try, [B, ws] = smoothdata(e, m{1}, w); show(sprintf('%s_imp_%d', m{1}, w), B, ws), catch err, fprintf('%s_imp_%d|ERROR|%s|%s\\n', m{1}, w, err.identifier, err.message), end",
   "  end",
   "  try, [B, ws] = smoothdata(e1, m{1}, 5); show([m{1} '_edge1'], B, ws), catch err, fprintf('%s_edge1|ERROR|%s|%s\\n', m{1}, err.identifier, err.message), end",
   "  try, [B, ws] = smoothdata(e2, m{1}, 5); show([m{1} '_edge2'], B, ws), catch err, fprintf('%s_edge2|ERROR|%s|%s\\n', m{1}, err.identifier, err.message), end",
   "  try, [B, ws] = smoothdata(r, m{1}, 5); show([m{1} '_ramp'], B, ws), catch err, fprintf('%s_ramp|ERROR|%s|%s\\n', m{1}, err.identifier, err.message), end",
   "  try, [B, ws] = smoothdata(e, m{1}, [2 1]); show([m{1} '_bf'], B, ws), catch err, fprintf('%s_bf|ERROR|%s|%s\\n', m{1}, err.identifier, err.message), end",
   "end",
   "% robust methods with an outlier",
   "o = 1:15; o(8) = 100;",
   "for m = {'lowess', 'rlowess', 'loess', 'rloess'}",
   "  try, [B, ws] = smoothdata(o, m{1}, 7); show([m{1} '_outlier'], B, ws), catch e_, fprintf('%s_L22|ERROR|%s|%s\\n', m{1}, e_.identifier, e_.message), end",
   "end",
   "% the default window, per method and smoothing factor, on a few signals",
   "s1 = sin((1:100) / 5); s2 = (1:100) .^ 2; s3 = [zeros(1, 50) ones(1, 50)];",
   "rng(0); s4 = randn(1, 60);",
   "for m = {'movmean', 'gaussian', 'lowess', 'sgolay'}",
   "  try, [~, ws] = smoothdata(s1, m{1}); fprintf('%s_def_s1|%s\\n', m{1}, sprintf('%.17g ', ws)), catch e_, fprintf('%s_L28|ERROR|%s|%s\\n', m{1}, e_.identifier, e_.message), end",
   "  try, [~, ws] = smoothdata(s2, m{1}); fprintf('%s_def_s2|%s\\n', m{1}, sprintf('%.17g ', ws)), catch e_, fprintf('%s_L29|ERROR|%s|%s\\n', m{1}, e_.identifier, e_.message), end",
   "  try, [~, ws] = smoothdata(s3, m{1}); fprintf('%s_def_s3|%s\\n', m{1}, sprintf('%.17g ', ws)), catch e_, fprintf('%s_L30|ERROR|%s|%s\\n', m{1}, e_.identifier, e_.message), end",
   "  try, [~, ws] = smoothdata(s4, m{1}); fprintf('%s_def_s4|%s\\n', m{1}, sprintf('%.17g ', ws)), catch e_, fprintf('%s_L31|ERROR|%s|%s\\n', m{1}, e_.identifier, e_.message), end",
   "end",
   "for f = [0 0.1 0.25 0.5 0.9 1]",
   "  try, [~, ws] = smoothdata(s1, 'SmoothingFactor', f); fprintf('sf_%g|%s\\n', f, sprintf('%.17g ', ws)), catch e_, fprintf('sf_|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "end",
   "try, [B, ws] = smoothdata(s4); show('def_s4', B, ws), catch e_, fprintf('def_s4|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, [B, ws] = smoothdata([1 2 3]); show('def_short', B, ws), catch e_, fprintf('def_short|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "% sgolay degree, NaN, SamplePoints, dimensions, classes",
   "try, show('sg_deg1', smoothdata(r, 'sgolay', 5, 'Degree', 1), 5), catch e_, fprintf('sg_deg1|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('sg_deg3', smoothdata(r, 'sgolay', 7, 'Degree', 3), 7), catch e_, fprintf('sg_deg3|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('nan_omit', smoothdata([1 NaN 3 4 NaN NaN NaN 8], 'movmean', 3), 3), catch e_, fprintf('nan_omit|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('nan_incl', smoothdata([1 NaN 3 4 5], 'movmean', 3, 'includenan'), 3), catch e_, fprintf('nan_incl|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('nan_gauss', smoothdata([1 NaN 3 4 5], 'gaussian', 3), 3), catch e_, fprintf('nan_gauss|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('nan_lowess', smoothdata([1 NaN 3 4 5 6 7], 'lowess', 3), 3), catch e_, fprintf('nan_lowess|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('sp', smoothdata([1 2 10 4 5], 'movmean', 2, 'SamplePoints', [0 1 1.5 3 4]), 2), catch e_, fprintf('sp|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, show('dim2', smoothdata([1 2 10; 4 5 6], 2, 'movmean', 3), 3), catch e_, fprintf('dim2|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, fprintf('cls|%s|%s\\n', class(smoothdata(single([1 2 3]), 'movmean', 3)), class(smoothdata(int8([1 2 3]), 'movmean', 3))), catch e_, fprintf('cls|ERROR|%s|%s\\n', e_.identifier, e_.message), end",
   "try, smoothdata([1 2 3], 'bogus', 3), catch err, fprintf('bad|%s|%s\\n', err.identifier, err.message), end",
   "try, smoothdata([1 2 3], 'sgolay', 3, 'Degree', 3), catch err, fprintf('baddeg|%s|%s\\n', err.identifier, err.message), end",
   "try, smoothdata([1 2 3], 'movmean', 3, 'SmoothingFactor', 0.5), catch err, fprintf('badsf|%s|%s\\n', err.identifier, err.message), end",
   "",
   "disp('DONE')"
  ],
