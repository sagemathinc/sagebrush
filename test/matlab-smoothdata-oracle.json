 "p9b": {
  "program": [
   "% p9b (for smoothdata): the default window heuristic, the robust methods' small-residual rule,",
   "% NaN inside local-regression windows, and windows at or past the data's length. Small fixed inputs, no timing.",
   "% Each row: NAME|values printed with %.17g (or ERROR|identifier|message).",
   "format long g",
   "W = @(name, w) fprintf('%s|%s\\n', name, sprintf('%.17g ', w));",
   "S = @(name, B) fprintf('%s|%s\\n', name, sprintf('%.17g ', B));",
   "% A. default window: signals of several lengths, shapes, scales and smoothing factors",
   "for n = [3 4 5 6 8 10 15 20 30 50 100 200 400]",
   "  try, [~, w] = smoothdata(1:n); W(sprintf('A_lin_%d', n), w), catch e, fprintf('A_lin_%d|ERROR|%s|%s\\n', n, e.identifier, e.message), end",
   "  try, [~, w] = smoothdata(ones(1, n)); W(sprintf('A_one_%d', n), w), catch e, fprintf('A_one_%d|ERROR|%s|%s\\n', n, e.identifier, e.message), end",
   "  try, [~, w] = smoothdata((1:n).^2); W(sprintf('A_sq_%d', n), w), catch e, fprintf('A_sq_%d|ERROR|%s|%s\\n', n, e.identifier, e.message), end",
   "  for f = [1 2 5]",
   "    try, [~, w] = smoothdata(sin(2*pi*f*(1:n)/n)); W(sprintf('A_sin%d_%d', f, n), w), catch e, fprintf('A_sin%d_%d|ERROR|%s|%s\\n', f, n, e.identifier, e.message), end",
   "  end",
   "  rng(1); x = randn(1, n);",
   "  try, [~, w] = smoothdata(x); W(sprintf('A_rnd_%d', n), w), catch e, fprintf('A_rnd_%d|ERROR|%s|%s\\n', n, e.identifier, e.message), end",
   "  try, [~, w] = smoothdata(cumsum(x)); W(sprintf('A_walk_%d', n), w), catch e, fprintf('A_walk_%d|ERROR|%s|%s\\n', n, e.identifier, e.message), end",
   "end",
   "s1 = sin((1:100) / 5);",
   "for f = 0:0.05:1",
   "  try, [~, w] = smoothdata(s1, 'SmoothingFactor', f); W(sprintf('A_sf_%g', f), w), catch e, fprintf('A_sf_%g|ERROR|%s|%s\\n', f, e.identifier, e.message), end",
   "  try, [~, w] = smoothdata(1:100, 'SmoothingFactor', f); W(sprintf('A_sflin_%g', f), w), catch e, fprintf('A_sflin_%g|ERROR|%s|%s\\n', f, e.identifier, e.message), end",
   "  try, [~, w] = smoothdata(1:37, 'SmoothingFactor', f); W(sprintf('A_sflin37_%g', f), w), catch e, fprintf('A_sflin37_%g|ERROR|%s|%s\\n', f, e.identifier, e.message), end",
   "end",
   "try, [~, w] = smoothdata(1000 * s1); W('A_scale', w), catch e, fprintf('A_scale|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, [~, w] = smoothdata(s1 + 100); W('A_shift', w), catch e, fprintf('A_shift|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, [~, w] = smoothdata(fliplr(s1)); W('A_flip', w), catch e, fprintf('A_flip|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, [~, w] = smoothdata([s1' (1:100)'.^2]); W('A_matrix', w), catch e, fprintf('A_matrix|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, [~, w] = smoothdata([s1(1:50) NaN s1(52:100)]); W('A_nan', w), catch e, fprintf('A_nan|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "for m = {'movmedian', 'loess', 'rlowess', 'rloess'}",
   "  try, [~, w] = smoothdata(s1, m{1}); W(['A_m_' m{1}], w), catch e, fprintf('A_m_%s|ERROR|%s|%s\\n', m{1}, e.identifier, e.message), end",
   "end",
   "% B. robust methods when the plain fit (nearly) interpolates: an impulse of size d on a line",
   "for p = 0:2:16",
   "  d = 10^(-p); y = 1:15; y(8) = y(8) + d;",
   "  try, B = smoothdata(y, 'rlowess', 5); S(sprintf('B_rlowess_%d', p), B(8) - 8), catch e, fprintf('B_rlowess_%d|ERROR|%s|%s\\n', p, e.identifier, e.message), end",
   "  y = 1e6 * (1:15); y(8) = y(8) + d * 1e6;",
   "  try, B = smoothdata(y, 'rlowess', 5); S(sprintf('B_big_%d', p), (B(8) - 8e6) / 1e6), catch e, fprintf('B_big_%d|ERROR|%s|%s\\n', p, e.identifier, e.message), end",
   "end",
   "e8 = zeros(1, 15); e8(8) = 1;",
   "try, S('B_rloess_imp5_e', smoothdata(e8, 'rloess', 5)), catch e, fprintf('B_rloess_imp5_e|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('B_rloess_imp5_s', smoothdata(e8 * 1e-10, 'rloess', 5) * 1e10), catch e, fprintf('B_rloess_imp5_s|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('B_rloess_imp5_r', smoothdata(e8 + (1:15), 'rloess', 5) - (1:15)), catch e, fprintf('B_rloess_imp5_r|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "% C. NaN inside local-regression and sgolay windows",
   "c1 = [1 NaN 3 4 5 6 7]; c2 = [1 NaN NaN 4 5 6 7 8 9]; c3 = [NaN 2 3 4 5 6 7]; c4 = [1 4 NaN 16 25 36 49 64];",
   "for m = {'lowess', 'loess', 'rlowess', 'rloess', 'sgolay', 'movmedian'}",
   "  for w = [3 4 5]",
   "    try, S(sprintf('C1_%s_%d', m{1}, w), smoothdata(c1, m{1}, w)), catch e, fprintf('C1_%s_%d|ERROR|%s|%s\\n', m{1}, w, e.identifier, e.message), end",
   "    try, S(sprintf('C2_%s_%d', m{1}, w), smoothdata(c2, m{1}, w)), catch e, fprintf('C2_%s_%d|ERROR|%s|%s\\n', m{1}, w, e.identifier, e.message), end",
   "    try, S(sprintf('C3_%s_%d', m{1}, w), smoothdata(c3, m{1}, w)), catch e, fprintf('C3_%s_%d|ERROR|%s|%s\\n', m{1}, w, e.identifier, e.message), end",
   "    try, S(sprintf('C4_%s_%d', m{1}, w), smoothdata(c4, m{1}, w)), catch e, fprintf('C4_%s_%d|ERROR|%s|%s\\n', m{1}, w, e.identifier, e.message), end",
   "  end",
   "  try, S(sprintf('C1_%s_incl', m{1}), smoothdata(c1, m{1}, 3, 'includenan')), catch e, fprintf('C1_%s_incl|ERROR|%s|%s\\n', m{1}, e.identifier, e.message), end",
   "  try, S(sprintf('C5_%s_allnan', m{1}), smoothdata([NaN NaN NaN 4 5], m{1}, 3)), catch e, fprintf('C5_%s_allnan|ERROR|%s|%s\\n', m{1}, e.identifier, e.message), end",
   "end",
   "% D. small windows, and windows at or past the data's length",
   "r5 = [1 4 2 8 5];",
   "for m = {'movmean', 'movmedian', 'gaussian', 'lowess', 'loess', 'rlowess', 'rloess', 'sgolay'}",
   "  for w = [1 2 5 6 9]",
   "    try, [B, ws] = smoothdata(r5, m{1}, w); S(sprintf('D_%s_%d', m{1}, w), [ws NaN B]), catch e, fprintf('D_%s_%d|ERROR|%s|%s\\n', m{1}, w, e.identifier, e.message), end",
   "  end",
   "  try, [B, ws] = smoothdata(r5, m{1}, [0 0]); S(sprintf('D_%s_00', m{1}), [ws NaN B]), catch e, fprintf('D_%s_00|ERROR|%s|%s\\n', m{1}, e.identifier, e.message), end",
   "  try, [B, ws] = smoothdata(r5, m{1}, [3 0]); S(sprintf('D_%s_30', m{1}), [ws NaN B]), catch e, fprintf('D_%s_30|ERROR|%s|%s\\n', m{1}, e.identifier, e.message), end",
   "  try, [B, ws] = smoothdata(r5, m{1}, 2.5); S(sprintf('D_%s_2p5', m{1}), [ws NaN B]), catch e, fprintf('D_%s_2p5|ERROR|%s|%s\\n', m{1}, e.identifier, e.message), end",
   "end",
   "try, S('D_sg_deg0', smoothdata(r5, 'sgolay', 3, 'Degree', 0)), catch e, fprintf('D_sg_deg0|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('D_sg_deg2_w9', smoothdata(r5, 'sgolay', 9, 'Degree', 4)), catch e, fprintf('D_sg_deg2_w9|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('D_col', smoothdata([1 4 2 8 5]', 'lowess', 3)), catch e, fprintf('D_col|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('D_mat_rlowess', smoothdata([1 4 2 8 5; 0 0 9 0 0]', 'rlowess', 3)), catch e, fprintf('D_mat_rlowess|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('D_cplx', smoothdata([1+2i 3 5i 7], 'lowess', 3)), catch e, fprintf('D_cplx|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('D_single_lowess', double(smoothdata(single([1 4 2 8 5]), 'lowess', 3))), catch e, fprintf('D_single_lowess|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "try, S('D_empty', size(smoothdata(zeros(1, 0), 'lowess', 3))), catch e, fprintf('D_empty|ERROR|%s|%s\\n', e.identifier, e.message), end",
   "disp('DONE')"
