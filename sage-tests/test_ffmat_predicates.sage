# GF(p) matrix predicates (Sage mode), as Sage gives them.
F = GF(101)
A = matrix(F, [[1, 2, 3], [4, 5, 6], [7, 8, 10]])
B = matrix(F, [[2, 1, 0], [0, 2, 0], [0, 0, 3]])
N = matrix(F, [[0, 1, 0], [0, 0, 1], [0, 0, 0]])
S = matrix(F, [[1, 2], [2, 1]])
E = matrix(F, 0, 0)
R = matrix(F, [[1, 2, 3], [4, 5, 6]])
G9.<a> = GF(9)
M9 = matrix(G9, [[a, 1], [0, a + 1]])
T2 = matrix(GF(2), [[1, 1, 0], [0, 1, 1]])
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('S.is_symmetric()', lambda: S.is_symmetric())
show('A.is_symmetric()', lambda: A.is_symmetric())
show('R.is_symmetric()', lambda: R.is_symmetric())
show('E.is_symmetric()', lambda: E.is_symmetric())
show('B.is_diagonal()', lambda: B.is_diagonal())
show('matrix.diagonal(F, [2, 3]).is_diagonal()', lambda: matrix.diagonal(F, [2, 3]).is_diagonal())
show('R.is_diagonal()', lambda: R.is_diagonal())
show('E.is_diagonal()', lambda: E.is_diagonal())
show('matrix(F, 2, 2, 3).is_scalar()', lambda: matrix(F, 2, 2, 3).is_scalar())
show('matrix.diagonal(F, [2, 3]).is_scalar()', lambda: matrix.diagonal(F, [2, 3]).is_scalar())
show('matrix(F, 2, 2, 3).is_scalar(3)', lambda: matrix(F, 2, 2, 3).is_scalar(3))
show('matrix(F, 2, 2, 3).is_scalar(4)', lambda: matrix(F, 2, 2, 3).is_scalar(4))
show('matrix(F, 2, 2, 0).is_scalar()', lambda: matrix(F, 2, 2, 0).is_scalar())
show('R.is_scalar()', lambda: R.is_scalar())
show('N.is_nilpotent()', lambda: N.is_nilpotent())
show('A.is_nilpotent()', lambda: A.is_nilpotent())
show('matrix(F, 2, 2, 0).is_nilpotent()', lambda: matrix(F, 2, 2, 0).is_nilpotent())
show('E.is_nilpotent()', lambda: E.is_nilpotent())
show('matrix(F, [[1, 0], [0, 0]]).is_idempotent()', lambda: matrix(F, [[1, 0], [0, 0]]).is_idempotent())
show('A.is_idempotent()', lambda: A.is_idempotent())
show('N.is_singular()', lambda: N.is_singular())
show('A.is_singular()', lambda: A.is_singular())
show('R.is_singular()', lambda: R.is_singular())
show('E.is_singular()', lambda: E.is_singular())
show('B.is_triangular()', lambda: B.is_triangular())
show("B.is_triangular('lower')", lambda: B.is_triangular('lower'))
show("B.is_triangular('upper')", lambda: B.is_triangular('upper'))
show('N.is_triangular()', lambda: N.is_triangular())
show("N.is_triangular('lower')", lambda: N.is_triangular('lower'))
show("N.transpose().is_triangular('lower')", lambda: N.transpose().is_triangular('lower'))
show('R.is_triangular()', lambda: R.is_triangular())
show("A.is_triangular('sideways')", lambda: A.is_triangular('sideways'))
show('matrix.identity(F, 2).is_one()', lambda: matrix.identity(F, 2).is_one())
show('A.is_one()', lambda: A.is_one())
show('R.is_one()', lambda: R.is_one())
show('E.is_one()', lambda: E.is_one())
show('M9.is_triangular()', lambda: M9.is_triangular())
show('M9.is_symmetric()', lambda: M9.is_symmetric())
show('M9.is_singular()', lambda: M9.is_singular())
