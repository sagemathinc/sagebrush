x,y = var('x y')
def tr(l, f):
    try: print(l, "=>", f())
    except Exception as e: print(l, "!!", type(e).__name__, str(e)[:150])
tr("SR num eig", lambda: matrix(SR,[[2,1],[1,2]]).eigenvalues())
tr("SR sym eig", lambda: matrix(SR,[[x,1],[1,x]]).eigenvalues())
tr("QQ irr eig", lambda: matrix(QQ,[[1,2],[3,4]]).eigenvalues())
tr("QQ irr eigv", lambda: matrix(QQ,[[1,2],[3,4]]).eigenvectors_right())
tr("charpoly", lambda: matrix(QQ,[[1,2],[3,4]]).charpoly('x'))
tr("mp", lambda: SR(2).n(digits=30))
tr("SR(mp)", lambda: SR(SR(2).n(digits=30)))
tr("type mp", lambda: type(pi.n(digits=30)).__name__)
tr("latex", lambda: latex(var('x')^2/sqrt(var('y'))))
tr("kernel", lambda: matrix(QQ,[[1,2],[2,4]]).right_kernel().basis())
tr("desolve2", lambda: desolve(diff(function('y')(x),x,2)+function('y')(x), function('y')(x)))
tr("desolve_ivp", lambda: desolve(diff(function('y')(x),x)-2*function('y')(x), function('y')(x), ics=[0,1]))
