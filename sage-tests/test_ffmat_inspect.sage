# GF(p) matrix inspection (Sage mode), as Sage gives them.
F = GF(101)
A = matrix(F, [[1, 2, 3], [4, 5, 6], [7, 8, 10]])
B = matrix(F, [[2, 1, 0], [0, 2, 0], [0, 0, 3]])
N = matrix(F, [[0, 1, 0], [0, 0, 1], [0, 0, 0]])
S = matrix(F, [[1, 2], [2, 1]])
E = matrix(F, 0, 0)
R = matrix(F, [[1, 2, 3], [4, 5, 6]])
G9.<a> = GF(9)
M9 = matrix(G9, [[a, 1], [0, a + 1]])
T2 = matrix(GF(2), [[1, 1, 0], [0, 1, 1]])
def show(label, f):
    try:
        r = f()
        print(label, "->", repr(r), flush=True)
    except Exception as e:
        print(label, "->", ("%s: %s" % (type(e).__name__, str(e).split(chr(10))[0])).rstrip(), flush=True)
show('matrix(F, [[1, 2, 3], [2, 4, 6]]).nonpivots()', lambda: matrix(F, [[1, 2, 3], [2, 4, 6]]).nonpivots())
show('A.nonpivots()', lambda: A.nonpivots())
show('N.nonpivots()', lambda: N.nonpivots())
show('E.nonpivots()', lambda: E.nonpivots())
show('matrix(F, [[1, 2, 3], [2, 4, 6], [0, 1, 1]]).pivot_rows()', lambda: matrix(F, [[1, 2, 3], [2, 4, 6], [0, 1, 1]]).pivot_rows())
show('A.pivot_rows()', lambda: A.pivot_rows())
show('N.pivot_rows()', lambda: N.pivot_rows())
show('matrix(F, 3, 2, 0).pivot_rows()', lambda: matrix(F, 3, 2, 0).pivot_rows())
show('matrix(F, [[0, 0], [1, 2], [2, 4], [0, 1]]).pivot_rows()', lambda: matrix(F, [[0, 0], [1, 2], [2, 4], [0, 1]]).pivot_rows())
show('N.nonzero_positions()', lambda: N.nonzero_positions())
show('N.nonzero_positions(copy=False)', lambda: N.nonzero_positions(copy=False))
show('N.nonzero_positions(column_order=True)', lambda: N.nonzero_positions(column_order=True))
show('A.nonzero_positions_in_row(0)', lambda: A.nonzero_positions_in_row(0))
show('N.nonzero_positions_in_column(2)', lambda: N.nonzero_positions_in_column(2))
show('N.density()', lambda: N.density())
show('A.density()', lambda: A.density())
show('matrix(F, 2, 3, 0).density()', lambda: matrix(F, 2, 3, 0).density())
show('E.density()', lambda: E.density())
show('matrix(F, [[1, 2], [2, 4]]).left_kernel_matrix()', lambda: matrix(F, [[1, 2], [2, 4]]).left_kernel_matrix())
show('matrix(F, [[1, 2], [2, 4]]).right_kernel_matrix()', lambda: matrix(F, [[1, 2], [2, 4]]).right_kernel_matrix())
show('R.left_kernel_matrix()', lambda: R.left_kernel_matrix())
show('R.right_kernel_matrix()', lambda: R.right_kernel_matrix())
show('A.left_kernel_matrix()', lambda: A.left_kernel_matrix())
show('N.left_kernel_matrix()', lambda: N.left_kernel_matrix())
show("N.left_kernel_matrix(basis='pivot')", lambda: N.left_kernel_matrix(basis='pivot'))
show("R.right_kernel_matrix(basis='pivot')", lambda: R.right_kernel_matrix(basis='pivot'))
show('M9.left_kernel_matrix()', lambda: M9.left_kernel_matrix())
show('T2.left_kernel_matrix()', lambda: T2.left_kernel_matrix())
show('T2.nonpivots()', lambda: T2.nonpivots())
