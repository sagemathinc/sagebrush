x, y, n, t = var('x y n t')
def tr(label, f):
    try:
        print(label, "=>", f())
    except Exception as e:
        print(label, "!!", type(e).__name__, str(e)[:120])
tr("diff", lambda: diff(sin(x)^2, x))
tr("diff2", lambda: diff(x^3*y^2, x, y))
tr("integrate", lambda: integrate(x*exp(x), x))
tr("integrate_def", lambda: integrate(sin(x), x, 0, pi))
tr("integrate_gauss", lambda: integrate(exp(-x^2), x, -oo, oo))
tr("integrate_rat", lambda: integrate(1/(x^2+1), x))
tr("integrate_parts", lambda: integrate(x^2*sin(x), x))
tr("integrate_sqrt", lambda: integrate(sqrt(1-x^2), x))
tr("integrate_ln", lambda: integrate(log(x), x))
tr("limit", lambda: limit(sin(x)/x, x=0))
tr("limit_inf", lambda: limit((1+1/x)^x, x=oo))
tr("limit_right", lambda: limit(1/x, x=0, dir='+'))
tr("series", lambda: taylor(exp(x), x, 0, 4))
tr("series_sin", lambda: series(sin(x), x==0, 6))
tr("sum", lambda: sum(1/n^2, n, 1, oo))
tr("sum_fin", lambda: sum(n^2, n, 1, 10))
tr("sum_sym", lambda: sum(n, n, 1, t))
tr("solve", lambda: solve(x^2-3*x+2==0, x))
tr("solve_sys", lambda: solve([x+y==3, x-y==1], x, y))
tr("solve_cubic", lambda: solve(x^3-2==0, x))
tr("find_root", lambda: find_root(cos(x)-x, 0, 1))
tr("simplify", lambda: (sin(x)^2+cos(x)^2).simplify_full())
tr("expand", lambda: expand((x+1)^3))
tr("factor", lambda: factor(x^2-1))
tr("factor_int", lambda: factor(360))
tr("partial_fraction", lambda: (1/(x^2-1)).partial_fraction(x))
tr("together", lambda: (1/x+1/y).combine())
tr("trig_simplify", lambda: (sin(x)^2+cos(x)^2).simplify_trig())
tr("n_pi", lambda: N(pi, digits=20))
tr("matrix_det", lambda: matrix([[1,2],[3,4]]).det())
tr("matrix_inv", lambda: matrix(QQ,[[1,2],[3,4]]).inverse())
tr("eigenvalues", lambda: matrix([[2,1],[1,2]]).eigenvalues())
tr("eigenvectors", lambda: matrix(QQ,[[2,1],[1,2]]).eigenvectors_right())
tr("rref", lambda: matrix(QQ,[[1,2,3],[4,5,6]]).rref())
tr("matrix_sym_det", lambda: matrix(SR,[[x,1],[1,x]]).det())
tr("desolve", lambda: desolve(diff(function('f')(x),x)-function('f')(x), function('f')(x)))
tr("gcd", lambda: gcd(12, 18))
tr("prime", lambda: nth_prime(10))
tr("isprime", lambda: is_prime(97))
tr("binomial", lambda: binomial(10,3))
tr("factorial", lambda: factorial(20))
tr("plot", lambda: type(plot(sin(x), (x, 0, 2*pi))).__name__)
tr("plot3d", lambda: type(plot3d(sin(x*y), (x,-2,2), (y,-2,2))).__name__)
tr("parametric", lambda: type(parametric_plot((cos(t), sin(t)), (t, 0, 2*pi))).__name__)
tr("contour", lambda: type(contour_plot(x^2+y^2, (x,-1,1), (y,-1,1))).__name__)
tr("subs", lambda: (x^2+y).subs(x=2))
tr("numerator", lambda: ((x+1)/(x-1)).numerator())
tr("coeff", lambda: expand((x+1)^3).coefficient(x, 2))
tr("roots_poly", lambda: (x^2-2).roots(x))
tr("nintegrate", lambda: numerical_integral(exp(-x^2), 0, 1))
tr("grad", lambda: (x^2*y).gradient())
tr("cross", lambda: vector([1,0,0]).cross_product(vector([0,1,0])))
tr("dot", lambda: vector([1,2,3]).dot_product(vector([4,5,6])))
tr("latex", lambda: latex(x^2/sqrt(y)))
