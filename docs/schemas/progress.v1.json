     },
     "required": [
      "value",
      "label"
     ],
     "type": "object"
    },
    "work_spent": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^[0-9]+$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "schema",
    "call_id",
    "parent_id",
    "op",
    "stage",
    "stage_index",
    "count",
    "elapsed_s",
    "beyond_forecast"
