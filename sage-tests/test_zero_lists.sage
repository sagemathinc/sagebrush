# The zero polynomial's list() is [] (not [0]), a quotient element's list() has one coefficient per power below
# the modulus's degree, and the zero ideal is generated by 0 with Groebner basis [0], as Sage (friction W18)
def show(label, f):
    try:
        print(label, '|', f())
    except Exception as e:
        print(label, '| ERR', type(e).__name__, repr(str(e)[:120]))
R.<m> = QQ[]; Q = R.quotient(m^2 + 1); Q3 = R.quotient(m^3 - 2)
T.<a,b> = QQ[]
for n, f in [('Q(3)', lambda: Q(3).list()), ('Q(m+2)', lambda: Q(m + 2).list()), ('Q(0)', lambda: Q(0).list()), ('Q3(m)', lambda: Q3(m).list()), ('Q3(0)', lambda: Q3(0).list()),
             ('T0 gb', lambda: T.ideal([T(0)]).groebner_basis()), ('T00 gb', lambda: T.ideal([T(0), T(0)]).groebner_basis()), ('T[] gb', lambda: T.ideal([]).groebner_basis()), ('Ta0 gb', lambda: T.ideal([a, T(0)]).groebner_basis()),
             ('R ideal(0) gens', lambda: R.ideal(0).gens()), ('R ideal([]) gens', lambda: R.ideal([]).gens()), ('R ideal() gens', lambda: R.ideal().gens()), ('T ideal([]) gens', lambda: T.ideal([]).gens()),
             ('GF5 0 coeffs dense', lambda: GF(5)['t'](0).coefficients(sparse=False)), ('QQ 0 coeffs dense', lambda: R(0).coefficients(sparse=False)), ('ZZ 0 list', lambda: ZZ['u'](0).list()),
             ('QQ 0 list', lambda: R(0).list()), ('QQ 0 exponents', lambda: R(0).exponents()), ('T0 gens', lambda: T.ideal([T(0)]).gens()), ('GF5 0 list', lambda: GF(5)['t'](0).list()),
             ('R(0)[0]', lambda: R(0)[0]), ('R(0).constant_coefficient()', lambda: R(0).constant_coefficient()), ('R(0).leading_coefficient()', lambda: R(0).leading_coefficient())]:
    show(n, f)
