{
  "name": "@sagemathinc/sagebrush-board",
  "version": "0.4.0",
  "description": "Sagebrush boards: a whiteboard for agents and people (notes with Markdown and math, live code, pages, a tour, TimeTravel), mounted in an element by its host",
  "keywords": ["whiteboard", "board", "markdown", "math", "python", "notebook"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./submission": {
      "types": "./dist/submission.d.ts",
      "import": "./dist/submission.js",
      "default": "./dist/submission.js"
    }
  },
  "files": ["dist", "README.md"],
  "peerDependencies": {
    "sagebrush": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "sagebrush": { "optional": true }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun build.mjs",
    "test": "node test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagemathinc/sagebrush.git",
    "directory": "packages/sagebrush-board"
  },
  "homepage": "https://sagebrush.space/board/",
  "bugs": "https://github.com/sagemathinc/sagebrush/issues",
  "author": "William Stein <wstein@sagemath.com>",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
