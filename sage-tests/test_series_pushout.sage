for kind, bname, oname, op in C:
    B = sage_eval(bname)
    prec = 4 if bname in ("ZZ['x']", "QQ['x']", "GF(5)['x']", "ZZ['a']", "QQ['a']") and op in ('o*t', 't*o', 'o+t', 't-o', 't/o', '(o*t)/o') else 3
    S = (PowerSeriesRing if kind == 'Power' else LaurentSeriesRing)(B, 'x', default_prec=prec)
    t = S.gen()
    o = OTHERS[oname]()
    show('%s %s %s %s' % (kind, bname, oname, op), lambda: sage_eval(OPS[op], locals={'o': o, 't': t}))
