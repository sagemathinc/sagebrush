R = A.rref()
piv = A.pivots()
print(len(piv), piv[:10], piv[-5:])
free = [j for j in range(A.ncols()) if j not in piv]
print(free)
print(lcm([x.denominator() for x in R.list()]))
for i in range(R.nrows()):
    row = [R[i, j] for j in free]
    if any(x != 0 for x in row):
        print(i, row)
K = matrix(QQ, A.right_kernel().basis())
print(K.nrows(), (A * K.transpose()) == 0)
