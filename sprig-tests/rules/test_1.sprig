(*-- rules-2 *)
x^2 + 1 /. x -> 3
(*-- rules-3 *)
g[x_] := x^2 + 1
g[3]
(*-- rules-4 *)
g[x_] := x^2 + 1
g[a + b]
(*-- rules-5 *)
fib[0] = 0; fib[1] = 1; fib[n_] := fib[n - 1] + fib[n - 2]
fib[15]
(*-- rules-6 *)
h[x_?NumberQ] := 2 x
{h[2], h[z]}
(*-- rules-7 *)
g[x_] := x^2 + 1
D[g[t], t]
(*-- rules-8 *)
g[x_] := x^2 + 1
g'[t]
